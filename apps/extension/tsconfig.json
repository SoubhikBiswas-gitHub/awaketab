{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@awaketab/core": ["../../packages/core/src/index.ts"],
      "@awaketab/wake": ["../../packages/wake/src/index.ts"]
    }
  },
  "include": ["entrypoints", "src", "test", "e2e", "scripts/*.d.mts", "wxt.config.ts", "playwright.config.ts", ".wxt/wxt.d.ts"]
}
