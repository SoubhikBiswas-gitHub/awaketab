{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@awaketab/wake/video": ["../../packages/wake/src/video.ts"],
      "@awaketab/wake": ["../../packages/wake/src/index.ts"],
      "@awaketab/core": ["../../packages/core/src/index.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "."
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "dist-*", "test", "functions", "public/embed.js", "public/embed", "public/library"]
}
