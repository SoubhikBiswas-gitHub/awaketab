{
  // Pages Functions as they run: the Workers runtime types only (no DOM, no Node). Tests: tsconfig.test.json.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
