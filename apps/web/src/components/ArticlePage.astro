---
import type { CollectionEntry } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import ToolIsland from './ToolIsland.astro';
import Button from './shell/Button.astro';
import Limit from './article/Limit.astro';
import ArticleParts from './article/ArticleParts.astro';
import { createT, t as tEn } from '../i18n/load';
import '../styles/tool-embed.css';
import { LOCALE_META } from '../i18n/locales';
import { articleSchema } from '../lib/seo';
import {
  inline,
  placedBlocks,
  splitArticle,
  type TArticlePart,
  type TBlockName,
} from '../lib/article';
import { articleCss } from '../lib/article-css';
import {
  contentIndex,
  pageAlternates,
  pageIndexable,
  pageOgImage,
  pagePath,
  pageTranslations,
  splitEntryId,
  type TContentKind,
} from '../lib/content-i18n';

interface Props {
  kind: TContentKind;
  entry: CollectionEntry<TContentKind>;
}

const PRESET_HREF = {
  p15: '/15m',
  p30: '/30m',
  p45: '/45m',
  p60: '/1h',
  p120: '/2h',
  p240: '/4h',
  pinf: '/',
  custom: '/8h',
  until: '/',
} as const;
// docs/06 §10: the down-link names the duration it starts ("Start a 30-minute session"); English only.
const PRESET_WORDS: Partial<Record<keyof typeof PRESET_HREF, string>> = {
  p15: '15-minute',
  p30: '30-minute',
  p45: '45-minute',
  p60: '1-hour',
  p120: '2-hour',
  p240: '4-hour',
};

const { kind, entry } = Astro.props;
const data = entry.data;
const site =
  Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const { locale, enSlug } = splitEntryId(entry.id);
const english = locale === 'en';
const t = createT(locale);
const meta = LOCALE_META[locale];
const index = await contentIndex();
const path = pagePath(kind, enSlug, locale);
const canonical = `${site}${path}`;
// Unreviewed translations are `noindex` and carry no hreflang until a native reviewer sets
// `reviewed: true` — the same rule the locale homes follow (docs/07 §2, §5).
const indexable = pageIndexable({ locale, reviewed: data.reviewed, noindex: data.noindex });
const alternates = indexable ? pageAlternates(index, kind, enSlug, locale, site) : undefined;
const translations = pageTranslations(index, kind, enSlug);
const hubH1 = t(`page.hub.${kind}.h1`);
// Locale homes are the one page URL with a trailing slash, `/es/` (`es/index.html`, docs/14 §2.1).
const homeHref = english ? '/' : `/${locale}/`;
const published = data.published.toISOString().slice(0, 10);
const verified = data.lastVerified
  ? new Intl.DateTimeFormat(english ? 'en-GB' : meta.htmlLang, {
      dateStyle: 'long',
      timeZone: 'UTC',
      numberingSystem: 'latn',
    }).format(data.lastVerified)
  : null;
const stale =
  data.lastVerified !== undefined && Date.now() - data.lastVerified.getTime() > 180 * 86_400_000;
// Locale pages start the session on the locale home (the tool routes are not duplicated per locale),
// carrying the scenario preset and mode as the documented query params (docs/00 §7).
const startHref = english
  ? PRESET_HREF[data.preset]
  : `${homeHref}?preset=${data.preset}${data.mode === 'standard' ? '' : `&mode=${data.mode}`}`;
const startWords = english ? PRESET_WORDS[data.preset] : undefined;
const startLabel = startWords
  ? `Start a ${startWords} session`
  : t('content.start');
const ogImage = english
  ? `/og/${kind}-en.png`
  : pageOgImage(kind, enSlug, locale);
const crumbLabel = data.crumb ?? data.h1;
const breadcrumbs = english
  ? [
      { name: 'AwakeTab', url: site },
      { name: hubH1, url: `${site}/${kind}` },
      { name: crumbLabel, url: canonical },
    ]
  : [
      { name: 'AwakeTab', url: `${site}${homeHref}` },
      { name: crumbLabel, url: canonical },
    ];
const crumbs: Array<{ href?: string; label: string }> = [
  { href: homeHref, label: t('app.name') },
  ...(english ? [{ href: `/${kind}`, label: hubH1 }] : []),
  { label: crumbLabel },
];

// Related links: English pages use the target's h1 as anchor text (docs/06 §10); translations link the
// same-locale page when it exists, otherwise the English page, marked as English.
interface IRelatedLink {
  href: string;
  label: string;
  lang?: string;
}
// Site pages outside the collections (English only) that `related` may name, with the h1 of each as anchor text.
const SITE_PAGES: Record<string, string> = {
  '/embed': tEn('page.embed.h1'),
  '/extension': tEn('page.extension.h1'),
  '/kiosk': tEn('page.kiosk.h1'),
  '/library': tEn('page.library.h1'),
  '/pro': tEn('page.pro.h1'),
  '/about': tEn('page.about.h1'),
};
const related: IRelatedLink[] = data.related.map((href) => {
  const [, targetKind = '', targetSlug = ''] = href.split('/');
  const source = index.find((page) => page.kind === targetKind && page.enSlug === targetSlug && page.locale === 'en');
  const fallback = SITE_PAGES[href] ?? href.replace(/^\//u, '').replaceAll('/', ' · ').replaceAll('-', ' ');
  if (english) return { href, label: source?.h1 ?? fallback };
  const sameLocale = index.find(
    (page) => page.kind === targetKind && page.enSlug === targetSlug && page.locale === locale,
  );
  if (sameLocale) return { href: pagePath(sameLocale.kind, targetSlug, locale), label: sameLocale.h1 };
  return { href, label: `${source?.h1 ?? fallback} (${LOCALE_META.en.label})`, lang: 'en' };
});
const englishHref = translations.en;

const variant = kind === 'for' ? 'article' : 'guide';
const toolAt = kind === 'guides' || kind === 'learn' ? 'after' : 'top';
const toolCopy = kind === 'guides' ? 'skip' : 'try';

// Body: the rendered Markdown cut into sections and page-level markers (lib/article.ts).
const parts: TArticlePart[] = splitArticle(entry.rendered?.html ?? '');
const adAt = parts.findIndex((part) => part.kind === 'ad');
const before = adAt < 0 ? parts : parts.slice(0, adAt);
const after = adAt < 0 ? [] : parts.slice(adAt + 1);
const limitPlaced =
  parts.some((part) => part.kind === 'limit') ||
  parts.some(
    (p) =>
      p.kind === 'section' &&
      p.parts.some((b) => b.kind === 'block' && b.name === 'limit'),
  );
// /guides: the honest limit and FAQ follow the tool with the related links (GuideGuides); /learn keeps its FAQ in
// the body (GuideLearn). Everywhere else they close the body.
const notesAfterTool = kind === 'guides';

const stepVariant = data.steps?.some((st) => st.shot)
  ? 'shots'
  : kind === 'guides'
    ? 'track'
    : 'card';
const tracked = stepVariant === 'track' && (data.steps?.length ?? 0) > 0;
const blockCss = articleCss(
  placedBlocks(parts).map((b) => b.split(' ')[0] as TBlockName),
  data.steps ? stepVariant : null,
);

// "On this page": the page's own sections and template sections in page order.
const sectionToc = (
  list: TArticlePart[],
): Array<{ href: string; label: string }> =>
  list.flatMap((part) => {
    if (part.kind === 'limit')
      return [{ href: '#s-limit', label: t('content.limit') }];
    if (part.kind === 'section' && part.id && part.title)
      return [
        { href: `#${part.id}`, label: data.toc?.[part.id] ?? part.title },
      ];
    return [];
  });
const limitEntry = limitPlaced
  ? []
  : [{ href: '#s-limit', label: t('content.limit') }];
const toolEntry =
  toolAt === 'after'
    ? [
        {
          href: '#s-tool',
          label: data.toc?.['s-tool'] ?? t(`content.${toolCopy}.title`),
        },
      ]
    : [];
const faqEntry = [{ href: '#faq', label: t('content.faq') }];
const toc = notesAfterTool
  ? [...sectionToc(parts), ...toolEntry, ...limitEntry, ...faqEntry]
  : [
      ...sectionToc(parts),
      ...limitEntry,
      ...(variant === 'article'
        ? [{ href: '#s-related', label: t('content.related.for') }]
        : []),
      ...faqEntry,
      ...toolEntry,
    ];
const author = 'Soubhik Biswas';
const ICON_CHECK = 'M8 12.5l2.7 2.7L16.5 9.5';
const ICON_ARROW = 'M5 12h13M13 6l6 6-6 6';
const ICON_TICK = 'M5 12.5l4.5 4.5L19 7.5';
const toolLine = data.toolNote ?? t(`content.${toolCopy}.body`);
---

<ContentLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  locale={locale}
  noindex={!indexable}
  ogImage={ogImage}
  ogImageAlt={data.h1}
  alternates={alternates}
  localeLinks={translations}
  toolAt={toolAt}
  variant={variant}
  notesAfterTool={notesAfterTool}
  schema={articleSchema({
    canonical,
    title: data.h1,
    description: data.description,
    locale,
    published,
    image: `${site}${ogImage}`,
    ...(data.updated ? { updated: data.updated.toISOString().slice(0, 10) } : {}),
    breadcrumbs,
  })}
>
  {blockCss && <style is:inline slot="styles" set:html={blockCss} />}

  {
    tracked && data.steps ? (
      <nav
        slot="toc"
        class="at-toc at-toc-steps"
        aria-label={t('content.stepsNav')}
        data-progress
      >
        <div class="at-toc-list">
          <span class="at-kicker" aria-hidden="true">
            {t('content.progress')}
          </span>
          <span class="at-progress" aria-hidden="true">
            <span data-bar />
          </span>
          <span
            class="at-prog"
            aria-live="polite"
            data-prog
            data-count={t('content.progressCount', {
              n: '{n}',
              total: '{total}',
            })}
            data-next={t('content.progressNext', {
              n: '{n}',
              total: '{total}',
              next: '{next}',
            })}
            data-all={t('content.progressAll', { total: '{total}' })}
          >
            {t('content.progressNext', {
              n: 0,
              total: data.steps.length,
              next: 1,
            })}
          </span>
        </div>
        <ol>
          {data.steps.map((step, i) => (
            <li>
              <a
                href={`#step-${i + 1}`}
                aria-current={i === 0 ? 'step' : undefined}
              >
                <span class="at-step-n" aria-hidden="true">
                  <span>{i + 1}</span>
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d={ICON_TICK} />
                  </svg>
                </span>
                <span>{step.short ?? step.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="at-jump-tool" href="#tool">
          {t('content.jumpTool')} <span aria-hidden="true">↓</span>
        </a>
      </nav>
    ) : (
      <nav slot="toc" class="at-toc" aria-label={t('content.toc')} data-spy>
        <div class="at-toc-list">
          <span class="at-kicker" aria-hidden="true">
            {t('content.toc')}
          </span>
          {toc.map((item, i) => (
            <a href={item.href} aria-current={i === 0 ? 'location' : undefined}>
              <span class="at-toc-dot" aria-hidden="true" />
              {item.label}
            </a>
          ))}
        </div>
        <a class="at-toc-card" href="#tool" data-tool-mirror>
          <span class="at-pill at-pill-bare" data-lock="idle" data-mirror-pill>
            <svg
              class="at-pill-glyph"
              viewBox="0 0 12 12"
              aria-hidden="true"
              focusable="false"
            >
              <path
                class="at-g-dot"
                d="M6 1.5a4.5 4.5 0 1 1 0 9a4.5 4.5 0 1 1 0-9z"
              />
              <path class="at-g-pause" d="M2.5 1.5h2.5v9H2.5zM7 1.5h2.5v9H7z" />
              <path class="at-g-tri" d="M6 1L11.2 10.5H.8z" />
              <path
                class="at-g-ring"
                d="M6 3.4a2.6 2.6 0 1 1 0 5.2a2.6 2.6 0 1 1 0-5.2zM6 .6a5.4 5.4 0 1 1 0 10.8a5.4 5.4 0 1 1 0-10.8zm0 1.4a4 4 0 1 0 0 8a4 4 0 1 0 0-8z"
              />
            </svg>
            <span data-mirror-text>{t('tool.pill.idle')}</span>
          </span>
          <span class="at-toc-digits" data-mirror-digits aria-hidden="true">
            00:00
          </span>
          <span class="at-toc-back">
            {t('content.backToTool')} <span aria-hidden="true">↑</span>
          </span>
        </a>
      </nav>
    )
  }

  <Fragment slot="head">
    <nav class="at-crumbs" aria-label={english ? 'Breadcrumb' : t('content.breadcrumb')}>
      <ol>
        {
          crumbs.map((crumb, i) =>
            crumb.href ? (
              <li>
                <a href={crumb.href}>{crumb.label}</a>
                <span class="at-crumb-sep" data-slot="breadcrumb-separator" aria-hidden="true">
                  <svg viewBox="0 0 16 16" focusable="false"><path d="M6.5 4.5L10 8l-3.5 3.5" /></svg>
                </span>
              </li>
            ) : (
              <li aria-current="page" data-crumb={i}>{crumb.label}</li>
            ),
          )
        }
      </ol>
    </nav>
    <h1 class="at-h1-page">{data.h1}</h1>
    {
      variant === 'article' && data.lead && (
        <p class="at-lead" set:html={inline(data.lead)} />
      )
    }
    <div class="at-meta">
      {
        verified && (
          <span class="at-meta-verified">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d={ICON_CHECK} /></svg>
            {t('content.verified', { date: verified })}
          </span>
        )
      }
      {
        stale && (
          <span class="at-meta-stale">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-2.3-5.6" /><path d="M20 4v4.5h-4.5" /></svg>
            {t('content.stale')}
          </span>
        )
      }
      {
        !english && !data.reviewed && (
          <span class="at-meta-pending" data-translation-pending>
            {t('content.translation.pending')}
            {englishHref && (
              <a href={englishHref} hreflang="en" lang="en">
                {t('content.translation.original')}
              </a>
            )}
          </span>
        )
      }
      <span class="at-meta-by">{t('content.byline', { name: author })}</span>
    </div>
    {
      variant === 'guide' && data.lead && (
        <p class="at-lead" set:html={inline(data.lead)} />
      )
    }
    {
      data.facts && (
        <ul class="at-facts">
          {data.facts.map((fact) => (
            <li>
              <span>{fact.label}</span>
              <strong>{fact.value}</strong>
            </li>
          ))}
        </ul>
      )
    }
  </Fragment>

  {
    toolAt === 'after' ? (
      <section slot="tool" id="s-tool" class="at-tool-area" aria-labelledby="h-tool">
        <h2 id="h-tool">{t(`content.${toolCopy}.title`)}</h2>
        <p set:html={inline(toolLine)} />
        <div id="tool" class="at-tool-card">
          <ToolIsland embed heading={data.h1} autostart="0" preset={data.preset} mode={data.mode} locale={locale} />
        </div>
      </section>
    ) : (
      <div slot="tool" id="tool" class="at-tool-card">
        <ToolIsland embed heading={data.h1} autostart="0" preset={data.preset} mode={data.mode} locale={locale} />
      </div>
    )
  }

  <Fragment slot="intro"
    ><ArticleParts
      list={before}
      data={data}
      t={t}
      id={entry.id}
      kind={kind}
    /></Fragment
  >
  <ArticleParts list={after} data={data} t={t} id={entry.id} kind={kind} />

  <Fragment slot="notes">
    {
      !limitPlaced && (
        <Limit text={data.honestLimit} label={t('content.limit')} />
      )
    }

    {
      variant === 'article' && (
        <section
          id="s-related"
          class="at-related-sec"
          aria-labelledby="h-related"
        >
          <h2 id="h-related">{t('content.related.for')}</h2>
          <ul class="at-rows">
            {related.map((link) => (
              <li>
                <a class="at-link-row" href={link.href} hreflang={link.lang} lang={link.lang}>
                  <span>{link.label}</span>
                  <svg class="at-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICON_ARROW} /></svg>
                </a>
              </li>
            ))}
          </ul>
          <Button class="at-start" href={startHref} glyph>
            {startLabel}
          </Button>
        </section>
      )
    }

    <section class="at-faq-sec" aria-labelledby="faq">
      <h2 id="faq">{t('content.faq')}</h2>
      <div class="at-faq">
        {
          data.faq.map((item, i) => (
            <details open={i === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="at-faq-icon" aria-hidden="true">
                  <span>
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </Fragment>

  <Fragment slot="tail">
    {
      variant === 'guide' && (
        <nav class="at-related-links" aria-labelledby="h-related">
          <h2 id="h-related">{t('content.related')}</h2>
          <a class="at-start-pill" href={startHref}>
            <svg class="at-button-glyph" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <path d="M32.8 11.4A16 16 0 1 1 15.2 11.4" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
              <circle cx="24" cy="9" r="4.6" fill="currentColor" />
            </svg>
            {startLabel}
          </a>
          <div>
            {related.map((link) => (
              <a href={link.href} hreflang={link.lang} lang={link.lang}>
                {link.label}
              </a>
            ))}
          </div>
        </nav>
      )
    }

    <div class="at-author">
      <span class="at-avatar" aria-hidden="true">SB</span>
      <div>
        <p class="at-author-name">{author}</p>
        <p class="at-author-role">
          {t('content.author.role')}
          {variant === 'article' && verified && <>{t('content.verified', { date: verified })}.</>}
          <a href="/about">{t('content.author.about')}</a>
        </p>
      </div>
    </div>
  </Fragment>

  <slot name="after" slot="after" />
</ContentLayout>
