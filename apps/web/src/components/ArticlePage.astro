---
import { render, type CollectionEntry } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import ToolIsland from './ToolIsland.astro';
import Button from './shell/Button.astro';
import { createT, t as tEn } from '../i18n/load';
import '../styles/tool-embed.css';
import { LOCALE_META } from '../i18n/locales';
import { articleSchema } from '../lib/seo';
import {
  contentIndex,
  pageAlternates,
  pageIndexable,
  pageOgImage,
  pagePath,
  pageTranslations,
  splitEntryId,
  type TContentKind,
} from '../lib/content-i18n';

interface Props {
  kind: TContentKind;
  entry: CollectionEntry<TContentKind>;
}

const PRESET_HREF = {
  p15: '/15m',
  p30: '/30m',
  p45: '/45m',
  p60: '/1h',
  p120: '/2h',
  p240: '/4h',
  pinf: '/',
  custom: '/8h',
  until: '/',
} as const;

const { kind, entry } = Astro.props;
const data = entry.data;
const { Content, headings } = await render(entry);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const { locale, enSlug } = splitEntryId(entry.id);
const english = locale === 'en';
const t = createT(locale);
const meta = LOCALE_META[locale];
const index = await contentIndex();
const path = pagePath(kind, enSlug, locale);
const canonical = `${site}${path}`;
// Unreviewed translations are `noindex` and carry no hreflang until a native reviewer sets
// `reviewed: true` — the same rule the locale homes follow (docs/07 §2, §5).
const indexable = pageIndexable({ locale, reviewed: data.reviewed, noindex: data.noindex });
const alternates = indexable ? pageAlternates(index, kind, enSlug, locale, site) : undefined;
const translations = pageTranslations(index, kind, enSlug);
const hubH1 = t(`page.hub.${kind}.h1`);
// Locale homes are the one page URL with a trailing slash, `/es/` (`es/index.html`, docs/14 §2.1).
const homeHref = english ? '/' : `/${locale}/`;
const published = data.published.toISOString().slice(0, 10);
const verified = data.lastVerified
  ? new Intl.DateTimeFormat(english ? 'en-GB' : meta.htmlLang, {
      dateStyle: 'long',
      timeZone: 'UTC',
      numberingSystem: 'latn',
    }).format(data.lastVerified)
  : null;
const stale =
  data.lastVerified !== undefined && Date.now() - data.lastVerified.getTime() > 180 * 86_400_000;
// Locale pages start the session on the locale home (the tool routes are not duplicated per locale),
// carrying the scenario preset and mode as the documented query params (docs/00 §7).
const startHref = english
  ? PRESET_HREF[data.preset]
  : `${homeHref}?preset=${data.preset}${data.mode === 'standard' ? '' : `&mode=${data.mode}`}`;
const ogImage = english ? `/og/${kind}-en.png` : pageOgImage(kind, enSlug, locale);
const breadcrumbs = english
  ? [
      { name: 'AwakeTab', url: site },
      { name: hubH1, url: `${site}/${kind}` },
      { name: data.h1, url: canonical },
    ]
  : [
      { name: 'AwakeTab', url: `${site}${homeHref}` },
      { name: data.h1, url: canonical },
    ];
const crumbs: Array<{ href?: string; label: string }> = [
  { href: homeHref, label: t('app.name') },
  ...(english ? [{ href: `/${kind}`, label: hubH1 }] : []),
  { label: data.h1 },
];

// Related links: English pages use the target's h1 as anchor text (docs/06 §10); translations link the
// same-locale page when it exists, otherwise the English page, marked as English.
interface IRelatedLink {
  href: string;
  label: string;
  lang?: string;
}
// Site pages outside the collections (English only) that `related` may name, with the h1 of each as anchor text.
const SITE_PAGES: Record<string, string> = {
  '/embed': tEn('page.embed.h1'),
  '/extension': tEn('page.extension.h1'),
  '/kiosk': tEn('page.kiosk.h1'),
  '/library': tEn('page.library.h1'),
  '/pro': tEn('page.pro.h1'),
  '/about': tEn('page.about.h1'),
};
const related: IRelatedLink[] = data.related.map((href) => {
  const [, targetKind = '', targetSlug = ''] = href.split('/');
  const source = index.find((page) => page.kind === targetKind && page.enSlug === targetSlug && page.locale === 'en');
  const fallback = SITE_PAGES[href] ?? href.replace(/^\//u, '').replaceAll('/', ' · ').replaceAll('-', ' ');
  if (english) return { href, label: source?.h1 ?? fallback };
  const sameLocale = index.find(
    (page) => page.kind === targetKind && page.enSlug === targetSlug && page.locale === locale,
  );
  if (sameLocale) return { href: pagePath(sameLocale.kind, targetSlug, locale), label: sameLocale.h1 };
  return { href, label: `${source?.h1 ?? fallback} (${LOCALE_META.en.label})`, lang: 'en' };
});
const englishHref = translations.en;

const variant = kind === 'for' ? 'article' : 'guide';
const toolAt = kind === 'guides' || kind === 'learn' ? 'after' : 'top';
const toolCopy = kind === 'guides' ? 'skip' : 'try';
// "On this page": the article's own h2s (Astro gives them ids), then the template sections in page order.
const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, label: h.text })),
  { href: '#s-limit', label: t('content.limit') },
  ...(variant === 'article' ? [{ href: '#s-related', label: t('content.related') }] : []),
  { href: '#faq', label: t('content.faq') },
  ...(toolAt === 'after' ? [{ href: '#s-tool', label: t(`content.${toolCopy}.title`) }] : []),
];
const author = 'Soubhik Biswas';
const ICON_CHECK = 'M8 12.5l2.7 2.7L16.5 9.5';
const ICON_ARROW = 'M5 12h13M13 6l6 6-6 6';
---

<ContentLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  locale={locale}
  noindex={!indexable}
  ogImage={ogImage}
  ogImageAlt={data.h1}
  alternates={alternates}
  localeLinks={translations}
  toolAt={toolAt}
  variant={variant}
  schema={articleSchema({
    canonical,
    title: data.h1,
    description: data.description,
    locale,
    published,
    image: `${site}${ogImage}`,
    ...(data.updated ? { updated: data.updated.toISOString().slice(0, 10) } : {}),
    breadcrumbs,
  })}
>
  <nav slot="toc" class="at-toc" aria-label={t('content.toc')} data-spy>
    <div class="at-toc-list">
      <span class="at-kicker" aria-hidden="true">{t('content.toc')}</span>
      {
        toc.map((item, i) => (
          <a href={item.href} aria-current={i === 0 ? 'location' : undefined}>
            <span class="at-toc-dot" aria-hidden="true" />
            {item.label}
          </a>
        ))
      }
    </div>
    <a class="at-toc-card" href="#tool" data-tool-mirror>
      <span class="at-pill at-pill-bare" data-lock="idle" data-mirror-pill>
        <svg class="at-pill-glyph" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <path class="at-g-dot" d="M6 1.5a4.5 4.5 0 1 1 0 9a4.5 4.5 0 1 1 0-9z"></path>
          <path class="at-g-pause" d="M2.5 1.5h2.5v9H2.5zM7 1.5h2.5v9H7z"></path>
          <path class="at-g-tri" d="M6 1L11.2 10.5H.8z"></path>
          <path class="at-g-ring" d="M6 3.4a2.6 2.6 0 1 1 0 5.2a2.6 2.6 0 1 1 0-5.2zM6 .6a5.4 5.4 0 1 1 0 10.8a5.4 5.4 0 1 1 0-10.8zm0 1.4a4 4 0 1 0 0 8a4 4 0 1 0 0-8z"></path>
        </svg>
        <span data-mirror-text>{t('tool.pill.idle')}</span>
      </span>
      <span class="at-toc-digits" data-mirror-digits aria-hidden="true">00:00</span>
      <span class="at-toc-back">{t('content.backToTool')} <span aria-hidden="true">↑</span></span>
    </a>
  </nav>

  <Fragment slot="head">
    <nav class="at-crumbs" aria-label={english ? 'Breadcrumb' : t('content.breadcrumb')}>
      <ol>
        {
          crumbs.map((crumb, i) =>
            crumb.href ? (
              <li>
                <a href={crumb.href}>{crumb.label}</a>
                <span class="at-crumb-sep" data-slot="breadcrumb-separator" aria-hidden="true">
                  <svg viewBox="0 0 16 16" focusable="false"><path d="M6.5 4.5L10 8l-3.5 3.5" /></svg>
                </span>
              </li>
            ) : (
              <li aria-current="page" data-crumb={i}>{crumb.label}</li>
            ),
          )
        }
      </ol>
    </nav>
    <h1 class="at-h1-page">{data.h1}</h1>
    <div class="at-meta">
      {
        verified && (
          <span class="at-meta-verified">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d={ICON_CHECK} /></svg>
            {t('content.verified', { date: verified })}
          </span>
        )
      }
      {
        stale && (
          <span class="at-meta-stale">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-2.3-5.6" /><path d="M20 4v4.5h-4.5" /></svg>
            {t('content.stale')}
          </span>
        )
      }
      {
        !english && !data.reviewed && (
          <span class="at-meta-pending" data-translation-pending>
            {t('content.translation.pending')}
            {englishHref && (
              <a href={englishHref} hreflang="en" lang="en">
                {t('content.translation.original')}
              </a>
            )}
          </span>
        )
      }
      <span class="at-meta-by">{t('content.byline', { name: author })}</span>
    </div>
  </Fragment>

  {
    toolAt === 'after' ? (
      <section slot="tool" id="s-tool" class="at-tool-area" aria-labelledby="h-tool">
        <h2 id="h-tool">{t(`content.${toolCopy}.title`)}</h2>
        <p>{t(`content.${toolCopy}.body`)}</p>
        <div id="tool" class="at-tool-card">
          <ToolIsland embed heading={data.h1} autostart="0" preset={data.preset} mode={data.mode} locale={locale} />
        </div>
      </section>
    ) : (
      <div slot="tool" id="tool" class="at-tool-card">
        <ToolIsland embed heading={data.h1} autostart="0" preset={data.preset} mode={data.mode} locale={locale} />
      </div>
    )
  }

  <Content />

  <Fragment slot="notes">
    <aside id="s-limit" class="at-limit-note" aria-labelledby="h-limit">
      <div role="note" class="at-note">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.01" /></svg>
        <div>
          <h2 id="h-limit" class="at-kicker">{t('content.limit')}</h2>
          <p>{data.honestLimit}</p>
        </div>
      </div>
    </aside>

    {
      variant === 'article' && (
        <section id="s-related" class="at-related-sec" aria-labelledby="h-related">
          <h2 id="h-related">{t('content.related')}</h2>
          <ul class="at-rows">
            {related.map((link) => (
              <li>
                <a class="at-link-row" href={link.href} hreflang={link.lang} lang={link.lang}>
                  <span>{link.label}</span>
                  <svg class="at-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICON_ARROW} /></svg>
                </a>
              </li>
            ))}
          </ul>
          <Button class="at-start" href={startHref} glyph>
            {t('content.start')}
          </Button>
        </section>
      )
    }

    <section class="at-faq-sec" aria-labelledby="faq">
      <h2 id="faq">{t('content.faq')}</h2>
      <div class="at-faq">
        {
          data.faq.map((item, i) => (
            <details open={i === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="at-faq-icon" aria-hidden="true">
                  <span>
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </Fragment>

  <Fragment slot="tail">
    {
      variant === 'guide' && (
        <nav class="at-related-links" aria-labelledby="h-related">
          <h2 id="h-related">{t('content.related')}</h2>
          <a class="at-start-pill" href={startHref}>
            <svg class="at-button-glyph" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              <path d="M32.8 11.4A16 16 0 1 1 15.2 11.4" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
              <circle cx="24" cy="9" r="4.6" fill="currentColor" />
            </svg>
            {t('content.start')}
          </a>
          <div>
            {related.map((link) => (
              <a href={link.href} hreflang={link.lang} lang={link.lang}>
                {link.label}
              </a>
            ))}
          </div>
        </nav>
      )
    }

    <div class="at-author">
      <span class="at-avatar" aria-hidden="true">SB</span>
      <div>
        <p class="at-author-name">{author}</p>
        <p class="at-author-role">
          {t('content.author.role')}
          {variant === 'article' && verified && <>{t('content.verified', { date: verified })}.</>}
          <a href="/about">{t('content.author.about')}</a>
        </p>
      </div>
    </div>
  </Fragment>

  <slot name="after" slot="after" />
</ContentLayout>
