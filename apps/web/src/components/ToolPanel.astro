---
import { cn } from 'cn';
import { createT, islandCatalog } from '../i18n/load';
import type { TLocale } from '../i18n/locales';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Kbd } from '@/components/ui/kbd';
import { toggleVariants } from '@/components/ui/toggle';
import SponsorCard from './SponsorCard.astro';

interface Props {
  locale?: TLocale;
}

const { locale = 'en' } = Astro.props;
const t = createT(locale);
const catalogJson = JSON.stringify(islandCatalog(locale)).replaceAll('<', '\\u003c');
const chips = [
  ['p15', t('tool.preset.p15')],
  ['p30', t('tool.preset.p30')],
  ['p45', t('tool.preset.p45')],
  ['p60', t('tool.preset.p60')],
  ['p120', t('tool.preset.p120')],
  ['p240', t('tool.preset.p240')],
] as const;

// shadcn/ui at build time only (docs/03 ADR-013): cva class strings on native elements; the vanilla island
// (src/tool/**) keeps driving state through data-* hooks, `hidden` and `aria-pressed`. Every control is ≥ 44 px.
const btnPrimary = cn(buttonVariants(), 'min-h-11 cursor-pointer');
const btnOutline = cn(buttonVariants({ variant: 'outline' }), 'min-h-11 cursor-pointer');
const btnDanger = cn(btnOutline, 'text-destructive hover:text-destructive');
const btnLink = cn(buttonVariants({ variant: 'link' }), 'min-h-11 px-2');
// The advice link carries a full phrase (Lighthouse link-text); it wraps instead of overflowing at 320 px.
const btnLinkWrap = cn(btnLink, 'h-auto whitespace-normal');
const inlineLink = buttonVariants({ variant: 'link', size: 'sm' });
// shadcn Toggle keys its pressed look on data-[state=on]; the island toggles aria-pressed instead.
const chip = cn(
  toggleVariants({ variant: 'outline', size: 'lg' }),
  'at-chip min-h-11 cursor-pointer text-center leading-tight whitespace-normal wrap-anywhere hyphens-auto aria-pressed:border-primary aria-pressed:bg-accent aria-pressed:font-semibold aria-pressed:text-accent-foreground',
);
const proTag = cn(badgeVariants({ variant: 'secondary' }), 'ms-1');
// SponsorCard slot (docs/05 §3.23): rendered only when the flag is on at build time, so CLS stays 0 when off.
const sponsorEnabled = import.meta.env.PUBLIC_SPONSOR_ENABLED === '1';
const accents = [
  ['#087B87', t('settings.accent.aqua'), false],
  ['#5A47CF', t('settings.accent.violet'), false],
  ['#167A50', t('settings.accent.mint'), true],
  ['#255FBD', t('settings.accent.sky'), true],
] as const;
const modes = ['standard', 'clock', 'focus', 'minimal', 'night', 'message', 'cook'] as const;
const stars = [1, 2, 3, 4, 5] as const;
const shortcuts = [
  ['Space', t('tool.shortcuts.space')],
  ['1–6', t('tool.shortcuts.presets')],
  ['0', t('tool.shortcuts.pinf')],
  ['U', t('tool.shortcuts.until')],
  ['F', t('tool.shortcuts.fullscreen')],
  ['D', t('tool.shortcuts.theme')],
  ['M', t('tool.shortcuts.mode')],
  ['P', t('tool.shortcuts.pip')],
  ['Esc', t('tool.shortcuts.esc')],
  ['?', t('tool.shortcuts.help')],
] as const;
---

<!-- The island root `#awaketab-tool` (with its data-* params) is rendered by ToolIsland.astro so that the
     header controls main.ts binds through root.querySelector() are inside it; this is the panel body. -->
<div class="at-tool" data-panel>
  <script is:inline type="application/json" data-i18n-catalog set:html={catalogJson}></script>
  <div data-pip-slot>
    <svg
      class="at-ring"
      data-ring
      viewBox="0 0 192 192"
      width="192"
      height="192"
      role="img"
      aria-label={t('tool.ring.label', { status: t('tool.pill.idle') })}
    >
      <circle class="at-ring-track" data-ring-track cx="96" cy="96" r="88"></circle>
      <circle class="at-ring-progress" data-ring-progress cx="96" cy="96" r="88"></circle>
      <circle class="at-ring-dot" data-ring-dot cx="96" cy="8" r="5"></circle>
    </svg>
    <button class="at-pill" type="button" data-pill aria-live="polite" aria-atomic="true">
      <output data-pill-text>{t('tool.pill.idle')}</output>
      <span data-pill-extra hidden></span>
    </button>
    <div class="at-timer" data-timer role="timer" aria-live="off">
      <div class="at-timer-digits is-muted" data-timer-digits>--:--:--</div>
      <div class="at-timer-caption" data-timer-caption></div>
      <div class="sr-only" data-timer-live aria-live="polite"></div>
    </div>
  </div>
  <div class="at-banner" data-second-tab hidden>
    <p>{t('tool.secondTab.title')}</p>
    <div class="at-banner-actions">
      <button class={btnPrimary} type="button" data-tab-use>{t('tool.secondTab.useThis')}</button>
      <button class={btnOutline} type="button" data-tab-keep>{t('tool.secondTab.keepOther')}</button>
    </div>
  </div>
  <div class="at-banner" data-lang-suggest hidden>
    <p data-lang-suggest-text></p>
    <div class="at-banner-actions">
      <a class={btnPrimary} data-lang-suggest-accept href="/">{t('i18n.suggest.accept')}</a>
      <button class={btnOutline} type="button" data-lang-suggest-dismiss>{t('i18n.suggest.dismiss')}</button>
    </div>
  </div>
  <div class="at-banner" data-resume hidden>
    <p data-resume-title>{t('tool.resume.title', { time: '' })}</p>
    <div class="at-banner-actions">
      <button class={btnPrimary} type="button" data-resume-accept>{t('tool.resume.accept')}</button>
      <button class={btnOutline} type="button" data-resume-dismiss>{t('tool.resume.dismiss')}</button>
    </div>
  </div>
  <div class="at-notice" data-notice hidden>
    <h2 data-notice-title></h2>
    <p data-notice-body></p>
    <div class="at-notice-actions">
      <button class={btnPrimary} type="button" data-notice-retry>{t('tool.advice.retry')}</button>
      <button class={btnOutline} type="button" data-notice-fallback>{t('tool.fallback.consent.accept')}</button>
      <a class={btnLinkWrap} data-notice-learn href="/learn">{t('tool.advice.learn')}</a>
    </div>
  </div>
  <div class="at-chips" data-chips role="group" aria-label={t('tool.presets')}>
    {
      chips.map(([id, label]) => (
        <button class={chip} type="button" data-preset={id} aria-pressed="false">
          {label}
        </button>
      ))
    }
    <button class={chip} type="button" data-preset="pinf" aria-pressed="false">
      {t('tool.preset.pinf')}
      <span class="sr-only">{t('tool.preset.pinf.sr')}</span>
    </button>
    <button class={chip} type="button" data-preset="custom" aria-pressed="false">{t('tool.preset.custom')}</button>
    <button class={chip} type="button" data-preset="until" aria-pressed="false">{t('tool.preset.until')}</button>
  </div>
  <div class="at-stop-slot">
    <button class:list={['at-stop', btnDanger]} type="button" data-stop hidden>{t('tool.ring.stop')}</button>
  </div>
  {
    sponsorEnabled && (
      <SponsorCard placement="idle" label={t('sponsor.label')} />
    )
  }
  <section class="at-toasts" data-toasts aria-label={t('tool.notifications')}></section>

  <dialog data-dialog="custom" aria-labelledby="custom-title">
    <h2 id="custom-title">{t('tool.custom.title')}</h2>
    <form class="at-fields" method="dialog">
      <label>{t('tool.custom.days')} <input class="at-input" name="days" type="number" inputmode="numeric" min="0" max="7" value="0" /></label>
      <label>{t('tool.custom.hours')} <input class="at-input" name="hours" type="number" inputmode="numeric" min="0" max="23" value="0" /></label>
      <label>{t('tool.custom.minutes')} <input class="at-input" name="minutes" type="number" inputmode="numeric" min="0" max="59" value="30" /></label>
      <p data-custom-summary></p>
      <p class="at-error" data-custom-error></p>
      <div class="at-banner-actions">
        <button class={btnPrimary} type="button" data-custom-start>{t('tool.custom.start')}</button>
        <button class={btnOutline} type="button" data-custom-cancel>{t('tool.custom.cancel')}</button>
      </div>
    </form>
  </dialog>
  <dialog data-dialog="until" aria-labelledby="until-title">
    <h2 id="until-title">{t('tool.until.title')}</h2>
    <form class="at-fields" method="dialog">
      <label>{t('tool.until.title')} <input class="at-input" name="until" type="time" /></label>
      <p data-until-summary></p>
      <div class="at-banner-actions">
        <button class={btnPrimary} type="button" data-until-start>{t('tool.until.start')}</button>
        <button class={btnOutline} type="button" data-until-cancel>{t('tool.until.cancel')}</button>
      </div>
    </form>
  </dialog>
  <dialog data-dialog="settings" aria-labelledby="settings-title">
    <h2 id="settings-title">{t('settings.title')}</h2>
    <form class="at-fields">
      <fieldset>
        <legend>{t('settings.theme')}</legend>
        <label><input type="radio" name="theme" value="auto" checked /> {t('settings.theme.auto')}</label>
        <label><input type="radio" name="theme" value="light" /> {t('settings.theme.light')}</label>
        <label><input type="radio" name="theme" value="dark" /> {t('settings.theme.dark')}</label>
        <label><input type="radio" name="theme" value="oled" /> {t('settings.theme.oled')}</label>
      </fieldset>
      <fieldset class="at-accents">
        <legend>{t('settings.accent')}</legend>
        {
          accents.map(([hex, label, pack]) => (
            <label>
              <input type="radio" name="accent" value={hex} checked={hex === '#087B87'} />
              <span class="at-swatch" style={`--at-swatch:${hex}`} aria-hidden="true"></span>
              {label}
              {pack && <span class={proTag}>{t('pro.badge')}</span>}
            </label>
          ))
        }
        <p data-pack-gate>{t('settings.accent.packs')}</p>
      </fieldset>
      <label>{t('settings.defaultPreset')}
        <select class="at-input" name="defaultPreset">
          <option value="p15">{t('tool.preset.p15')}</option>
          <option value="p30">{t('tool.preset.p30')}</option>
          <option value="p45">{t('tool.preset.p45')}</option>
          <option value="p60">{t('tool.preset.p60')}</option>
          <option value="p120">{t('tool.preset.p120')}</option>
          <option value="p240">{t('tool.preset.p240')}</option>
          <option value="pinf">{t('tool.preset.pinf.sr')}</option>
        </select>
      </label>
      <label>{t('settings.sound')}
        <select class="at-input" name="sound">
          <option value="chime">{t('settings.sound.chime')}</option>
          <option value="none">{t('settings.sound.none')}</option>
        </select>
      </label>
      <label><input type="checkbox" name="notifications" /> {t('settings.notifications')}</label>
      <p data-notifications-note hidden></p>
      <fieldset>
        <legend>{t('settings.endBehaviour')}</legend>
        <label><input type="radio" name="endBehaviour" value="prompt_extend" checked /> {t('settings.endBehaviour.prompt_extend')}</label>
        <label><input type="radio" name="endBehaviour" value="stop" /> {t('settings.endBehaviour.stop')}</label>
      </fieldset>
      <div class="at-fields" data-battery-fields>
        <label><input type="checkbox" name="batteryAuto" /> {t('settings.battery.autoStop')}</label>
        <label><span data-battery-label>{t('settings.battery.threshold', { percent: 15 })}</span>
          <input type="range" name="batteryThreshold" min="5" max="30" value="15" />
        </label>
      </div>
      <p data-battery-unavailable hidden>{t('settings.battery.unavailable')}</p>
      <fieldset>
        <legend>{t('settings.ambient')}</legend>
        <label>{t('settings.ambient.mode')}
          <select class="at-input" name="ambientMode">
            {modes.map((m) => <option value={m}>{t(`ambient.mode.${m}`)}</option>)}
          </select>
        </label>
        <label>{t('settings.ambient.message')}
          <input class="at-input" name="ambientMessage" maxlength="80" autocomplete="off" placeholder={t('ambient.message.placeholder')} />
        </label>
        <p data-message-gate>{t('tool.toast.proMessage')}</p>
        <label><input type="checkbox" name="showSeconds" /> {t('settings.ambient.seconds')}</label>
        <label>{t('settings.ambient.clock')}
          <select class="at-input" name="clock24h">
            <option value="auto">{t('settings.ambient.clock.auto')}</option>
            <option value="24">{t('settings.ambient.clock24h')}</option>
            <option value="12">{t('settings.ambient.clock12h')}</option>
          </select>
        </label>
      </fieldset>
      <label><input type="checkbox" name="telemetry" checked /> {t('settings.telemetry')}</label>
      <p>{t('settings.telemetry.help')}</p>
      <label><input type="checkbox" name="keyboardShortcuts" checked /> {t('settings.shortcuts')}</label>
      <label><input type="checkbox" name="keyboardHints" checked /> {t('settings.hints')}</label>
      <p><a class={inlineLink} href="/pro">{t('settings.pro')}</a> · <a class={inlineLink} href="/pro/manage">{t('settings.pro.manage')}</a> · <button class={btnOutline} type="button" data-open-pro>{t('pro.see')}</button></p>
      <div class="at-banner-actions">
        <button class={btnOutline} type="button" data-settings-close>{t('settings.close')}</button>
        <button class={btnDanger} type="button" data-settings-reset>{t('settings.reset')}</button>
      </div>
    </form>
  </dialog>
  <dialog data-dialog="shortcuts" aria-labelledby="shortcuts-title">
    <h2 id="shortcuts-title">{t('tool.shortcuts.title')}</h2>
    <dl class="m-0 mb-4 grid gap-2">
      {
        shortcuts.map(([key, label]) => (
          <div class="flex items-center gap-3">
            <dt class="min-w-12"><Kbd className="h-6 min-w-6 px-1.5 text-sm text-foreground">{key}</Kbd></dt>
            <dd class="m-0 text-sm text-muted-foreground">{label}</dd>
          </div>
        ))
      }
    </dl>
    <button class={btnOutline} type="button" data-shortcuts-close>{t('settings.close')}</button>
  </dialog>
  <dialog data-dialog="share" aria-labelledby="share-title">
    <h2 id="share-title">{t('tool.share.title')}</h2>
    <div class="at-banner-actions">
      <input class="at-input flex-1" data-share-url readonly aria-labelledby="share-title" />
      <button class={btnPrimary} type="button" data-share-copy>{t('tool.share.copy')}</button>
    </div>
  </dialog>
  <dialog data-dialog="extend" aria-labelledby="extend-title">
    <h2 id="extend-title">{t('tool.extend.title')}</h2>
    <p data-extend-auto></p>
    <div class="at-banner-actions">
      <button class={btnOutline} type="button" data-extend-15>{t('tool.extend.add15')}</button>
      <button class={btnOutline} type="button" data-extend-30>{t('tool.extend.add30')}</button>
      <button class={btnOutline} type="button" data-extend-60>{t('tool.extend.add60')}</button>
      <button class={btnDanger} type="button" data-extend-stop>{t('tool.extend.stop')}</button>
    </div>
    {sponsorEnabled && <SponsorCard placement="extend" label={t('sponsor.label')} />}
  </dialog>
  <dialog data-dialog="pro" aria-labelledby="pro-sheet-title">
    <h2 id="pro-sheet-title">{t('pro.title')}</h2>
    <p>{t('pro.card')}</p>
    <p><a class={inlineLink} href="/pro">{t('pro.cta')}</a> · <a class={inlineLink} href="/pro/activate">{t('pro.activate')}</a></p>
    <button class={btnOutline} type="button" data-pro-close>{t('settings.close')}</button>
  </dialog>
  <dialog data-dialog="stats" aria-labelledby="stats-title">
    <h2 id="stats-title">{t('stats.open')}</h2>
    <p data-stats-empty hidden>{t('stats.empty')}</p>
    <dl class="at-stats">
      <div><dt>{t('stats.today')}</dt><dd data-stats-today></dd></div>
      <div><dt>{t('stats.week')}</dt><dd data-stats-week></dd></div>
      <div><dt>{t('stats.streakLabel')}</dt><dd data-stats-streak></dd></div>
      <div><dt>{t('stats.total')}</dt><dd data-stats-total></dd></div>
    </dl>
    <table class="at-heatmap" data-stats-heatmap>
      <caption>{t('stats.heatmap.caption')}</caption>
    </table>
    <p data-stats-locked hidden>{t('stats.heatmap.pro')} <a class={inlineLink} href="/pro">{t('pro.see')}</a></p>
    <div class="at-banner-actions">
      <button class={btnPrimary} type="button" data-stats-export hidden>{t('stats.export')}</button>
      <button class={btnOutline} type="button" data-stats-close>{t('stats.close')}</button>
    </div>
  </dialog>
  <dialog data-dialog="rating" aria-labelledby="rating-title">
    <h2 id="rating-title">{t('rating.title')}</h2>
    <form class="at-fields" data-rating-form>
      <fieldset class="at-stars">
        <legend>{t('rating.stars')}</legend>
        {
          stars.map((n) => (
            <label>
              <input type="radio" name="stars" value={String(n)} />
              <span aria-hidden="true">★</span>
              <span class="sr-only">{t('rating.star', { n })}</span>
            </label>
          ))
        }
      </fieldset>
      <label>{t('rating.text')}
        <textarea class="at-input at-textarea" name="text" maxlength="280" rows="3"></textarea>
      </label>
      <p class="at-error" data-rating-error role="alert"></p>
      <div class="at-banner-actions">
        <button class={btnPrimary} type="submit">{t('rating.send')}</button>
        <button class={btnOutline} type="button" data-rating-later>{t('rating.later')}</button>
        <button class={btnOutline} type="button" data-rating-never>{t('rating.never')}</button>
      </div>
    </form>
  </dialog>
  <dialog class="at-ambient" data-ambient aria-labelledby="ambient-title">
    <h2 class="sr-only" id="ambient-title" data-ambient-title>{t('ambient.mode.clock')}</h2>
    <div class="at-ambient-stage" data-ambient-stage>
      <div class="at-ambient-content" data-ambient-content></div>
    </div>
    <div class="at-ambient-bar" data-ambient-controls>
      <button class={btnOutline} type="button" data-ambient-next>{t('ambient.next')}</button>
      <button class={btnOutline} type="button" data-ambient-fullscreen>{t('tool.header.fullscreen')}</button>
      <button class={btnOutline} type="button" data-ambient-exit>{t('ambient.exit')}</button>
    </div>
  </dialog>
  <noscript><p>{t('tool.noscript')}</p></noscript>
</div>
