    <a class="at-button at-button-sm" data-lang-suggest-accept href="/"
      >{t('i18n.suggest.accept')}</a
    >
  </div>
  <noscript><p class="at-noscript">{t('tool.noscript')}</p></noscript>
</div>

<Sheet
  name="settings"
  title={t('settings.title')}
  titleId="settings-title"
  closeLabel={t('settings.close')}
  body="form"
  bodyClass="at-settings"
>
  <section aria-labelledby="st-appearance">
    <h3 class="at-kicker" id="st-appearance">{t('settings.appearance')}</h3>
    <div class="at-field">
      <span class="at-label" id="lb-theme">{t('settings.theme')}</span>
      <div
        class="at-seg at-sseg"
        role="radiogroup"
        aria-labelledby="lb-theme"
        style="--at-seg-n:4"
      >
        <span class="at-seg-ind" aria-hidden="true"></span>
        {
          (['auto', 'light', 'dark', 'oled'] as const).map((v) => (
            <label class="at-seg-item">
              <input
                class="sr-only"
                type="radio"
                name="theme"
                value={v}
                checked={v === 'auto'}
              />
              {t(`settings.theme.${v}`)}
            </label>
          ))
        }
      </div>
    </div>
    <div data-appearance></div>
    <div class="at-field">
      <span class="at-label" id="lb-face">{t('settings.face')}</span>
      <div class="at-face-pick" role="radiogroup" aria-labelledby="lb-face">
        {
          allFaces.map((f) => (
            <label class="at-face-opt">
              <input
                class="sr-only"
                type="radio"
                name="face"
                value={f}
                checked={f === 'ring'}
              />
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={FACE_ICON[f]} />
              </svg>
              <span>{t(`tool.face.${f}`)}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="at-field at-field-astyle">
      <span class="at-label" id="lb-astyle">{t('settings.face.analogStyle')}</span>
      <div
        class="at-seg at-sseg"
        role="radiogroup"
        aria-labelledby="lb-astyle"
        style="--at-seg-n:2"
      >
        <span class="at-seg-ind" aria-hidden="true"></span>
        {
          (['minimal', 'luxe'] as const).map((v) => (
            <label class="at-seg-item">
              <input
                class="sr-only"
                type="radio"
                name="analogStyle"
                value={v}
                checked={v === 'minimal'}
              />
              {t(`settings.face.analog.${v}`)}
            </label>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="st-time">
    <h3 class="at-kicker" id="st-time">{t('settings.time')}</h3>
    <details class="at-langrow">
      <summary class="at-row at-langrow-btn" id="at-lang-set-btn">
        <span>{t('settings.locale')}</span>
        <span class="at-langrow-cur"
          >{here.label}<svg
            width="16"
            height="16"
            class="at-lang-chev"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg
          ></span
        >
      </summary>
      <ul
        class="at-lang-list at-langrow-list"
        id="at-lang-set-list"
        role="list"
        aria-label={t('settings.locale')}
      >
        {
          LOCALES.map((code) => {
            const meta = LOCALE_META[code];
            const current = code === locale;
            const tl = createT(code);
            const note = current
              ? t('footer.language.current')
              : meta.reviewed
                ? ''
                : t('footer.language.review');
            return (
              <li>
                <a
                  class="at-lang-row"
                  href={localePath(code, '/')}
                  lang={meta.htmlLang}
                  hreflang={meta.hreflang}
                  aria-current={current ? 'true' : undefined}
                  data-code={code}
                  data-q={tl('i18n.suggest', { language: meta.label })}
                  data-a={tl('i18n.suggest.accept')}
                >
                  <svg
                    width="20"
                    height="20"
                    class="at-lang-mark"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <>
                      <circle class="at-lang-ring" cx="10" cy="10" r="8" />
                      <circle class="at-lang-dot" cx="10" cy="10" r="4" />
                    </>
                  </svg>
                  <span class="at-lang-name">{meta.label}</span>
                  <span class="at-lang-note" lang={here.htmlLang}>
                    {note}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </details>
    <div class="at-field">
      <span class="at-label" id="lb-fmt">{t('settings.ambient.clock')}</span>
      <div
        class="at-seg at-sseg at-sseg-sm"
        role="radiogroup"
        aria-labelledby="lb-fmt"
      >
        <span class="at-seg-ind" aria-hidden="true"></span>
        <label class="at-seg-item"
          ><input
            class="sr-only"
            type="radio"
            name="clock24h"
            value="auto"
            checked
          />{t('settings.ambient.clock.auto')}</label
        >
        <label class="at-seg-item"
          ><input class="sr-only" type="radio" name="clock24h" value="12" />{
            t('settings.clock.12')
          }</label
        >
        <label class="at-seg-item"
          ><input class="sr-only" type="radio" name="clock24h" value="24" />{
            t('settings.clock.24')
          }</label
        >
      </div>
      <span class="at-caption at-tabnum" data-t="nowShows"></span>
    </div>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.ambient.seconds')}</span><span
          class="at-caption">{t('settings.seconds.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="showSeconds"
      />
    </label>
  </section>

  <section aria-labelledby="st-focus" data-focus-tools>
    <h3 class="at-kicker" id="st-focus">{t('settings.focus')}</h3>
  </section>

  <section aria-labelledby="st-end">
    <h3 class="at-kicker" id="st-end">{t('settings.endBehaviour')}</h3>
    <div
      class="at-seg at-sseg"
      role="radiogroup"
      aria-labelledby="st-end"
      style="--at-seg-n:2"
    >
      <span class="at-seg-ind" aria-hidden="true"></span>
      <label class="at-seg-item"
        ><input
          class="sr-only"
          type="radio"
          name="endBehaviour"
          value="prompt_extend"
          checked
        />{t('settings.endBehaviour.prompt_extend')}</label
      >
      <label class="at-seg-item"
        ><input
          class="sr-only"
          type="radio"
          name="endBehaviour"
          value="stop"
        />{t('settings.endBehaviour.stop')}</label
      >
    </div>
    <div class="at-field">
      <div class="at-field-top">
        <span class="at-label" id="lb-sound">{t('settings.sound')}</span>
        <button
          class="at-button at-button-sm"
          type="button"
          data-sound="play"
          aria-describedby="lb-sound">{t('settings.sound.play')}</button
        >
      </div>
      <div class="at-face-pick" role="radiogroup" aria-labelledby="lb-sound">
        {
          endSounds.map((id) => (
            <label class="at-face-opt">
              <input
                class="sr-only"
                type="radio"
                name="sound"
                value={id}
                checked={id === 'chime'}
              />
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={END_ICON[id]} />
              </svg>
              <span>{t(`settings.sound.${id}`)}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="at-range">
      <label class="at-label" for="at-sound-vol">{t('settings.sound.volume')}</label>
      <input
        id="at-sound-vol"
        type="range"
        name="soundVolume"
        min="0"
        max="100"
        step="5"
        value="60"
      />
    </div>
    <label class="at-switchrow" data-vibrate-row hidden>
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.vibrate')}</span><span
          class="at-caption">{t('settings.vibrate.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="vibrate"
        checked
      />
    </label>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.tick')}</span><span
          class="at-caption">{t('settings.tick.help')}</span
        ></span
      >
      <input class="at-switch" type="checkbox" role="switch" name="tick" />
    </label>
    <div>
      <button class="at-textlink" type="button" data-sound="open"
        >{t('settings.sound.focus')}</button
      >
    </div>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.notifications')}</span><span
          class="at-caption"
          data-notifications-note>{t('settings.notifications.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="notifications"
      />
    </label>
  </section>

  <section aria-labelledby="st-batt" data-battery-fields>
    <h3 class="at-kicker" id="st-batt">{t('settings.battery')}</h3>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.battery.autoStop')}</span><span
          class="at-caption">{t('settings.battery.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="batteryAuto"
      />
    </label>
    <div class="at-range">
      <div class="at-field-top">
        <label class="at-label" for="at-batt"
          >{t('settings.battery.stopAt')}</label
        ><output class="at-label at-tabnum" for="at-batt" data-battery-label
          >15%</output>
      </div>
      <input
        id="at-batt"
        type="range"
        name="batteryThreshold"
        min="5"
        max="30"
        step="1"
        value="15"
        aria-describedby="at-batt-hint"
      />
      <span class="at-caption" id="at-batt-hint" data-battery-hint
        >{t('settings.battery.off')}</span
      >
    </div>
  </section>
  <p class="at-caption" data-battery-unavailable hidden>
    {t('settings.battery.unavailable')}
  </p>

  {
    !embed && (
      <section aria-labelledby="st-notes" class="at-tight">
        <h3 class="at-kicker" id="st-notes">{t('settings.notes')}</h3>
        <div class="at-switchrow at-notes-setrow">
          <span class="at-switch-text">
            <span class="at-label">{t('settings.notes.label')}</span>
            <span class="at-caption">{t('settings.notes.help')}</span>
          </span>
          <button class="at-button at-button-sm" type="button" data-open-notes aria-haspopup="dialog">
            {t('settings.notes.open')}
          </button>
        </div>
      </section>
    )
  }

  <section aria-labelledby="st-priv" class="at-tight">
    <h3 class="at-kicker" id="st-priv">{t('settings.privacy')}</h3>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.telemetry')}</span></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="telemetry"
        checked
      />
    </label>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.shortcuts')}</span><span
          class="at-caption at-keys-help"
          set:html={keysHelp}
        /></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="keyboardShortcuts"
        checked
      />
    </label>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.hints')}</span></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="keyboardHints"
        checked
      />
    </label>
  </section>

  <div class="at-settings-foot">
    <div class="at-settings-links">
      <button class="at-phone-only at-textlink" type="button" data-open-stats
        >{t('stats.title')}</button
      >
      <button class="at-phone-only at-textlink" type="button" data-open-share
        >{t('tool.share.title')}</button
      >
      <button class="at-phone-only at-textlink" type="button" data-open-shortcuts
        >{t('tool.shortcuts.title')}</button
      >
      <a class="at-textlink" href="/pro" data-open-pro>{t('settings.pro')}</a>
      <a class="at-textlink" href="/pro/manage">{t('settings.pro.manage')}</a>
      <a class="at-textlink" href="/changelog" target="_blank" rel="noopener">{t('footer.whatsNew')}</a>
    </div>
    <Button data-settings-reset>{t('settings.reset')}</Button>
    <p class="at-caption" data-version>{t('footer.version', { version: VERSION })}</p>
  </div>
</Sheet>

<Sheet
  name="faces"
  title={t('tool.gallery.title')}
  titleId="faces-title"
  description={t('tool.gallery.lead')}
  closeLabel={close}
