  <p class="at-keys-note" role="note">
    <Icon name="keyboard" size={20} />
    <span>{t('tool.shortcuts.phoneNote')}</span>
  </p>
  <div class="at-keys-groups">
    {
      shortcutGroups.map(([group, keys]) => (
        <section class="at-keys-group" aria-labelledby={`at-keys-${group}`}>
          <h3 class="at-kicker" id={`at-keys-${group}`}>{t(`tool.shortcuts.group.${group}`)}</h3>
          <dl class="at-keys">
            {keys.map(([k1, k2, label]) => (
              <div>
                <dt>
                  <kbd class="at-kbd">{k1}</kbd>
                  {k2 && (
                    <>
                      <span aria-hidden="true">–</span>
                      <kbd class="at-kbd">{k2}</kbd>
                    </>
                  )}
                </dt>
                <dd>{label}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
  <p class="at-caption at-keys-foot">
    <span class="at-phone-hide">{t('tool.shortcuts.foot')}</span><span
      class="at-phone-only">{t('tool.shortcuts.footPhone')}</span>
  </p>
</Dialog>

<Sheet
  name="pro"
  title={t('pro.title')}
  titleId="pro-sheet-title"
  closeLabel={close}
  class="at-prosheet"
  autofocus
>
  <div class="at-pro-value">
    <p class="at-pro-price"><span class="at-pro-amount">{t('pro.sheet.amount')}</span> {t('pro.sheet.per')}</p>
    <ul class="at-pro-list">
      {
        (
          [
            ['palette', 'looks'],
            ['waveform', 'mixer'],
            ['note-pencil', 'notes'],
            ['timer', 'pomodoro'],
            ['chat-text', 'message'],
            ['chart-bar', 'stats'],
          ] as const
        ).map(([icon, key]) => (
          <li><Icon name={icon} size={20} />{t(`pro.sheet.${key}`)}</li>
        ))
      }
    </ul>
  </div>
  <p class="at-caption">{t('pro.sheet.free')}</p>
  <Fragment slot="footer">
    <a class="at-textlink at-dialog-start" href="/pro/activate">{t('pro.activate')}</a>
    <Button variant="primary" href="/pro" glyph={false}>{t('pro.cta')}</Button>
  </Fragment>
</Sheet>

<dialog class="at-ambient" data-ambient aria-labelledby="ambient-title">
