<Sheet
  name="sound"
  title={t('tool.sound.title')}
  titleId="sound-title"
  description={t('tool.sound.honest')}
  closeLabel={close}
  bodyClass="at-settings at-snd"
>
  <div class="at-snd-now">
    <svg
      class="at-snd-eq"
      viewBox="0 0 44 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      aria-hidden="true"
    >
      {[6, 14, 22, 30, 38].map((x) => <line x1={x} y1="3" x2={x} y2="21" />)}
    </svg>
    <div class="at-snd-now-text">
      <p class="at-snd-title" data-snd-title>{t('tool.sound.pick')}</p>
      <p class="at-caption" data-snd-sub role="status">{t('tool.sound.state.idle')}</p>
    </div>
    <div class="at-snd-deck">
      <button
        class="at-icon-button"
        type="button"
        data-snd="prev"
        aria-label={t('tool.sound.prev')}
        hidden
        ><svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M7 5v14M18 6l-8 6 8 6z"></path></svg
        ></button
      >
      <button
        class="at-snd-play"
        type="button"
        data-snd="toggle"
        aria-label={t('tool.sound.play')}
        ><svg class="at-snd-i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M8 5.5v13a1 1 0 0 0 1.5.9l10.4-6.5a1 1 0 0 0 0-1.8L9.5 4.6A1 1 0 0 0 8 5.5z"></path></svg
        ><svg class="at-snd-i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><rect x="6" y="5" width="4" height="14" rx="1.5"></rect><rect
            x="14"
            y="5"
            width="4"
            height="14"
            rx="1.5"></rect></svg
        ></button
      >
      <button
        class="at-icon-button"
        type="button"
        data-snd="next"
        aria-label={t('tool.sound.next')}
        hidden
        ><svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M17 5v14M6 6l8 6-8 6z"></path></svg
        ></button
      >
    </div>
  </div>
  <div class="at-range at-snd-vol">
    <div class="at-field-top">
      <label class="at-label" for="at-snd-vol">{t('tool.sound.volume')}</label><output
        class="at-label at-tabnum"
        for="at-snd-vol"
        data-snd-vol-out>50%</output>
    </div>
    <input
      id="at-snd-vol"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      data-snd-vol
    />
  </div>

  <section aria-labelledby="snd-k-focus">
    <h3 class="at-kicker" id="snd-k-focus">{t('tool.sound.focus')}</h3>
    <div class="at-snd-grid" role="group" aria-labelledby="snd-k-focus">
      {
        gens.map((g) => (
          <button
            class="at-snd-tile"
            type="button"
            data-snd-kind={g}
            aria-pressed="false"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={SOUND_ICON[g]} />
            </svg>
            <span class="at-snd-tile-name">{t(`tool.sound.kind.${g}`)}</span>
            <span class="at-snd-tile-sub">{t(`tool.sound.sub.${g}`)}</span>
          </button>
        ))
      }
    </div>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('tool.sound.stopAtEnd')}</span><span
          class="at-caption">{t('tool.sound.stopAtEnd.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        data-snd-stop
        checked
      />
    </label>
  </section>

  <section aria-labelledby="snd-k-mix">
    <div class="at-field-top">
      <h3 class="at-kicker" id="snd-k-mix">{t('tool.sound.mix')}</h3>
      <span class="at-tag">{t('pro.badge')}</span>
    </div>
    <p class="at-caption">{t('tool.sound.mix.help')}</p>
    <div class="at-snd-lock">
      <p>{t('tool.sound.mix.locked')}</p>
      <div class="at-snd-lock-row">
        <button class="at-button at-button-sm" type="button" data-snd="try">{t('tool.sound.mix.try')}</button>
        <a class="at-button at-button-sm at-button-quiet" href="/pro" data-snd-see>{t('pro.see')}</a>
      </div>
    </div>
    <p class="at-caption at-snd-pv" data-snd-pv aria-hidden="true"></p>
    <ul class="at-snd-mix" aria-labelledby="snd-k-mix">
      {
        gens.map((g) => (
          <li>
            <label class="at-label" for={`at-snd-m-${g}`}>{t(`tool.sound.kind.${g}`)}</label>
            <input
              id={`at-snd-m-${g}`}
              type="range"
              min="0"
              max="100"
              step="1"
              value="0"
              data-snd-mix={g}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="snd-k-lib">
    <div class="at-field-top">
      <h3 class="at-kicker" id="snd-k-lib">{t('tool.sound.library')}</h3>
      <span class="at-tag">{t('pro.badge')}</span>
    </div>
    <ol class="at-snd-list">
      <li>
        <button
          class="at-snd-track"
          type="button"
          data-snd-track="lofi"
          aria-pressed="false"
          ><span class="at-snd-track-n" aria-hidden="true">1</span><span
            class="at-snd-track-t"
            ><span>{t('tool.sound.lofi.title')}</span><span class="at-caption"
              >{t('tool.sound.lofi.by')}</span
            ></span
          ><span class="at-caption">{t('tool.sound.lofi.len')}</span></button
        >
      </li>
      {
        TRACKS.map((tr, i) => (
          <li>
            <button
              class="at-snd-track"
              type="button"
              data-snd-track={`track:${tr.id}`}
              aria-pressed="false"
            >
              <span class="at-snd-track-n" aria-hidden="true">{i + 2}</span>
              <span class="at-snd-track-t">
                <span>{tr.title}</span>
                <span class="at-caption">{`${tr.artist} · ${tr.licence}`}</span>
              </span>
              <span class="at-caption">{mmss(tr.duration)}</span>
              <span class="at-tag">{t('pro.badge')}</span>
            </button>
          </li>
        ))
      }
    </ol>
    <p class="at-caption">
      {t(TRACKS.length ? 'tool.sound.library.help' : 'tool.sound.library.empty')}
    </p>
    <p class="at-caption" data-snd-lib-lock>
      {t('tool.sound.library.locked')}
      <a href="/pro">{t('pro.see')}</a>
    </p>
  </section>
  <Fragment slot="footer">
    <button class="at-textlink" type="button" data-snd="settings"
      >{t('tool.sound.endSettings')}</button
    >
  </Fragment>
</Sheet>

<Sheet
