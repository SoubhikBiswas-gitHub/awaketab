---
import { createT, islandCatalog } from '../i18n/load';
import {
  LOCALE_META,
  LOCALES,
  localePath,
  type TLocale,
} from '../i18n/locales';
import CustomizeSheet from './CustomizeSheet.astro';
import FaceSwitch from './FaceSwitch.astro';
import Icon from './icons/Icon.astro';
import SponsorCard from './SponsorCard.astro';
import Button from './shell/Button.astro';
import Dialog from './ui/Dialog.astro';
import Sheet from './ui/Sheet.astro';
import StatusPill from './shell/StatusPill.astro';
import type { IToolReady } from '../lib/tool-ready';
import type { FACE_ORDER } from '../tool/packs/faces/order';
import { VERSION } from '../lib/version';

interface Props {
  locale?: TLocale;
  embed?: boolean;
  until?: string | undefined;
  kicker?: string | undefined;
  ready: IToolReady;
  untilAt?: string;
}

const { locale = 'en', embed = false, until, kicker, ready, untilAt = '' } = Astro.props;
const t = createT(locale);
const catalogJson = JSON.stringify(islandCatalog(locale)).replaceAll(
  '<',
  '\\u003c',
);
const presets = ['p15', 'p30', 'p45', 'p60', 'p120', 'p240'] as const;
// One 24 px line drawing per face, shared by the face gallery and the swipe hint.
const FACE_ICON: Record<(typeof FACE_ORDER)[number], string> = {
  ring: 'M12 3.5a8.5 8.5 0 1 1-8.5 8.5M12 3.5h.01',
  bold: 'M5 6h5v9H5zM14 6h5v9h-5zM4 19h16',
  horizon: 'M3 16h18M7 16a5 5 0 0 1 10 0M12 7V5M6.4 10.4 5 9M17.6 10.4 19 9',
  tide: 'M3 10c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0M3 15c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0',
  flip: 'M4 5h7v14H4zM13 5h7v14h-7zM4 12h7M13 12h7',
  rolling: 'M5 4h14v16H5zM9 10l3-3 3 3M9 14l3 3 3-3',
  analog: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 1 0 0-17M12 7.5V12l3 2',
  rings: 'M12 3a9 9 0 1 1-9 9M12 6.5a5.5 5.5 0 1 1-5.5 5.5M12 10a2 2 0 1 1-2 2',
  word: 'M5 7h2M10 7h4M17 7h2M5 12h5M13 12h6M5 17h3M11 17h8',
  nixie: 'M7.5 20V9a4.5 4.5 0 0 1 9 0v11zM5 20h14M10.5 11.5c.4-1 3-1.2 3 .4 0 1.4-3 2.6-3 4.1h3',
  lcd: 'M8.5 5h7M8.5 12h7M8.5 19h7M7.5 6v5M16.5 6v5M7.5 13v5M16.5 13v5',
  matrix:
    'M6 6h.01M10 6h.01M14 6h.01M18 6h.01M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M10 14h.01M14 14h.01M18 14h.01M6 18h.01M10 18h.01M14 18h.01M18 18h.01',
};
const sumEnd = [
  ['end-ask', 'settings.endBehaviour.prompt_extend'],
  ['end-stop', 'settings.endBehaviour.stop'],
] as const;
// SponsorCard slot (docs/05 §3.23): rendered only when the flag is on at build time, so CLS stays 0 when off.
const sponsorEnabled = import.meta.env.PUBLIC_SPONSOR_ENABLED === '1';
const shortcutGroups = [
  [
    'session',
    [
      ['Space', '', t('tool.shortcuts.space')],
      ['1', '6', t('tool.shortcuts.presets')],
      ['0', '', t('tool.shortcuts.pinf')],
      ['U', '', t('tool.shortcuts.until')],
      ['Esc', '', t('tool.shortcuts.esc')],
    ],
  ],
  [
    'screen',
    [
      ['F', '', t('tool.shortcuts.fullscreen')],
      ['C', '', t('tool.shortcuts.face')],
      ['D', '', t('tool.shortcuts.theme')],
      ['M', '', t('tool.shortcuts.mode')],
      ['P', '', t('tool.shortcuts.pip')],
    ],
  ],
  [
    'tools',
    [
      ['S', '', t('tool.shortcuts.sound')],
      ['N', '', t('tool.shortcuts.notes')],
      ['T', '', t('tool.shortcuts.focus')],
      ['B', '', t('tool.shortcuts.breathe')],
      ['I', '', t('tool.shortcuts.intention')],
      ['?', '', t('tool.shortcuts.help')],
    ],
  ],
] as const;

// Notes drawer: toolbar commands with their Tiptap shortcut (the Mod key is added on the client) and 24 px icons.
const NOTE_TOOLS = [
  ['b', 'B', 'Control+B Meta+B', 'text-b'],
  ['i', 'I', 'Control+I Meta+I', 'text-italic'],
  ['s', 'Shift+S', 'Control+Shift+S Meta+Shift+S', 'text-strikethrough'],
  ['h', 'Alt+2', 'Control+Alt+2 Meta+Alt+2', 'text-h'],
  ['ul', 'Shift+8', 'Control+Shift+8 Meta+Shift+8', 'list-bullets'],
  ['task', 'Shift+9', 'Control+Shift+9 Meta+Shift+9', 'list-checks'],
] as const;
// The "/" menu: block, icon, its Markdown shortcut, and English search words (the label is searched too).
const NOTE_BLOCKS = [
  ['h', 'text-h', '#', 'heading title h1 h2'],
  ['task', 'list-checks', '[ ]', 'checklist todo to-do task check box'],
  ['ul', 'list-bullets', '-', 'bullet list unordered ul'],
  ['ol', 'list-numbers', '1.', 'numbered list ordered ol number'],
  ['quote', 'quotes', '>', 'quote blockquote citation'],
  ['hr', 'minus', '---', 'divider rule line separator hr'],
] as const;

// Horizon stars and Tide waves: the canvas's deterministic art (Main.dc.html starList / wave), drawn once here.
function stars(
  seed: number,
  n: number,
): Array<[number, number, number, number]> {
  let x = seed;
  const r = () => (x = (x * 16807) % 2147483647) / 2147483647;
  const out: Array<[number, number, number, number]> = [];
  for (let i = 0; i < n; i += 1)
    out.push([
      Math.round(r() * 354),
      Math.round(r() * 196),
      r() > 0.8 ? 1.5 : 1,
      Number((0.45 + r() * 0.55).toFixed(2)),
    ]);
  return out;
}
function wave(amp: number, ph: number): string {
  let d = `M0 28L0 ${(14 + amp * Math.sin(ph)).toFixed(1)}`;
  for (let x = 4; x <= 716; x += 4)
    d += `L${String(x)} ${(14 + amp * Math.sin(ph + (x * 2 * Math.PI) / 179)).toFixed(1)}`;
  return `${d}L716 28Z`;
}
const bubbles = [
  [40, 300, 8, 0],
  [112, 320, 5, -2.5],
  [196, 310, 10, -5],
  [262, 325, 6, -1.2],
  [318, 305, 7, -6.8],
] as const;
const kbd = (k: string) => `<kbd class="at-kbd">${k}</kbd>`;
const keysHelp = t('settings.shortcuts.help', {
  space: kbd('Space'),
  one: kbd('1'),
  six: kbd('6'),
  help: kbd('?'),
});
const close = t('tool.close');
const X = 'M6 6l12 12M18 6L6 18';
const here = LOCALE_META[locale];
const untilWall = until?.replace('-', ':');
const a = untilWall ? '' : ready.a;
const b = untilWall ? '' : ready.b;
const meta = untilWall ? t('tool.meta.endsAt') : ready.meta;
const cta = untilWall ? t('tool.cta.until', { time: untilAt }) : ready.ctaAria;
const eight = ready.chip === 'custom';
// "Ends {time}" is split around the time, which the island fills (the same slot as the face's end time).
const endsAt = t('tool.len.ends', { time: '\u0000' }).split('\u0000') as [string, string];
const extend = [
  ['extend', 'add15'],
  ['extend30', 'add30'],
] as const;
// Starter notes live in data attributes, so their headings never count as page headings.
const task = '<ul data-type="taskList"><li data-type="taskItem" data-checked="false"><p></p></li></ul>';
const NOTE_TEMPLATES = {
  todo: `<h1>${t('notes.start.todo')}</h1>${task}`,
  meeting: `<h1>${t('notes.start.meeting')}</h1><h2>${t('notes.tpl.agenda')}</h2><ul><li><p></p></li></ul><h2>${t('notes.tpl.actions')}</h2>${task}`,
  ideas: `<h1>${t('notes.start.ideas')}</h1><ul><li><p></p></li></ul>`,
};
---

<div class="at-tool" data-panel id="content" tabindex="-1">
  <script
    is:inline
    type="application/json"
    data-i18n-catalog
    set:html={catalogJson}
  />
  <span class="at-sr" role="status" data-t="announce"></span>

  <div class="at-pip-slot" data-pip-slot>
    <div class="at-pillrow">
      <div class="at-pillline">
        <span class="at-pillwrap">
          <StatusPill
            as="output"
            data-pill
            aria-live="polite"
            aria-atomic="true"
            ><span data-pill-text>{t('tool.pill.idle')}</span></StatusPill
          >
          <span class="at-ig-pill" aria-hidden="true"></span>
        </span>
        {
          embed && kicker && (
            <span class="at-kicker at-card-kicker">{kicker}</span>
          )
        }
        <button
          class="at-why-btn"
          type="button"
          data-act="why"
          aria-expanded="false"
          aria-controls="at-why"
          aria-label={t('tool.why.open')}
          title={t('tool.why.open')}
        >
          <Icon name="info" tone="ink" />
        </button>
      </div>
      <span class="at-deferred" id="at-deferred">
        <svg width="16" height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path
            d="M3 9.5h18M7 7.2h.01M10 7.2h.01"></path></svg
        >
        {t('tool.pill.idle.deferred')}
      </span>
    </div>

    <div class="at-face-cell">
      <div class="at-mini">
        <div class="at-digits" role="timer" data-l="timer">
          <span data-t="a">{a}</span><span class="at-secs" data-t="b">{b}</span>
        </div>
        <p class="at-meta">
          <span data-t="ma">{meta}</span>
          <span class="at-meta-b" data-t="mb"></span>
        </p>
      </div>

      <section class="at-why" id="at-why" aria-labelledby="at-why-h">
        <div class="at-why-head">
          <h2 id="at-why-h">{t('tool.why.title')}</h2>
          <button
            class="at-icon-button at-why-x"
            type="button"
            data-act="why"
            aria-label={t('tool.why.back')}
          >
            <svg width="20" height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"><path d={X}></path></svg
            >
          </button>
        </div>
        <ul class="at-why-list" data-why-list></ul>
      </section>

      <section class="at-receipt" aria-labelledby="at-done-k">
        <h2 class="at-kicker" id="at-done-k">{t('tool.kicker.complete')}</h2>
        <p class="at-receipt-big">
          <span class="at-receipt-num"
            ><span data-t="rcBig"></span><span
              class="at-receipt-unit"
              data-t="rcUnit"></span></span
          >
          <span class="at-receipt-words" data-t="rcWords"></span>
        </p>
        <div class="at-receipt-line">
          <div class="at-receipt-bar" role="img" data-l="rcAria" data-rc-bar>
          </div>
          <div class="at-receipt-ends" aria-hidden="true">
            <span data-t="rcFrom"></span><span data-t="rcTo"></span>
          </div>
          <ul class="at-receipt-legend">
            <li>
              <span class="at-lg-held" aria-hidden="true"></span><span
                data-t="rcHeld"></span>
            </li>
            <li class="at-lg-p">
              <span class="at-lg-paused" aria-hidden="true"></span><span
                data-t="rcPaused"></span>
            </li>
          </ul>
        </div>
      </section>

      <div class="at-dial">
        <div class="at-final-glow" aria-hidden="true"></div>
        <div class="at-face at-face-ring">
          <div class="at-ring">
            <svg width="608" height="608"
              class="at-ring-art"
              viewBox="0 0 320 320"
              aria-hidden="true"
              focusable="false"
            >
              <defs
                ><filter
                  id="at-ring-glow"
                  x="-20%"
                  y="-20%"
                  width="140%"
                  height="140%"
                  ><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter
                ></defs
              >
              <circle class="at-ticks" cx="160" cy="160" r="130"></circle>
              <circle class="at-ticks at-ticks-h" cx="160" cy="160" r="130"></circle>
              <circle class="at-track" cx="160" cy="160" r="146"></circle>
              <g transform="rotate(-90 160 160)">
                <circle
                  class="at-arc at-arc-glow"
                  cx="160"
                  cy="160"
                  r="146"
                  filter="url(#at-ring-glow)"></circle>
                <circle class="at-arc" cx="160" cy="160" r="146"></circle>
              </g>
              <g class="at-tip">
                <circle class="at-tip-halo" cx="160" cy="14" r="7"></circle>
                <circle class="at-ig-tip" cx="160" cy="14" r="9"></circle>
                <circle class="at-tip-dot" cx="160" cy="14" r="5.5"></circle>
              </g>
            </svg>
            <div class="at-sweep" aria-hidden="true"></div>
            <div class="at-face-text">
              <div class="at-kick" data-t="k">{t('tool.kicker.ready')}</div>
              <div class="at-digits" role="timer" data-timer data-l="timer">
                <span data-timer-digits
                  ><span data-t="a">{a}</span><span class="at-secs" data-t="b"
                    >{b}</span
                  ></span>
              </div>
              <div class="at-meta">
                <span data-t="ma">{meta}</span>
                <span class="at-meta-b" data-t="mb"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="at-face at-face-bold">
          <div class="at-kick" data-t="k">{t('tool.kicker.ready')}</div>
          <div class="at-digits" role="timer" data-l="timer">
            <span data-t="a">{a}</span><span class="at-secs" data-t="b"
              >{b}</span>
          </div>
          <div class="at-bar-track" aria-hidden="true">
            <div class="at-bar-fill"><div class="at-shim"></div></div>
          </div>
          <div class="at-bold-meta">
            <span
              ><span data-t="ma">{meta}</span>
              <span data-t="mb"></span></span
            ><span data-t="of">{untilWall ? '' : ready.of}</span>
          </div>
        </div>

        <div class="at-face at-face-horizon">
          <div class="at-hz-warm" aria-hidden="true"></div>
          <svg width="358" height="340"
            class="at-hz-stars"
            viewBox="0 0 358 340"
            aria-hidden="true"
            focusable="false"
          >
            <g class="at-tw"
              >{
                stars(7, 26).map(([x, y, r, a]) => (
                  <circle
                    cx={x}
                    cy={y}
                    r={r}
                    fill={`rgba(255,255,255,${String(a)})`}
                  />
                ))
              }</g
            >
            <g class="at-tw2"
              >{
                stars(91, 18).map(([x, y, r, a]) => (
                  <circle
                    cx={x}
                    cy={y}
                    r={r}
                    fill={`rgba(255,255,255,${String(a)})`}
                  />
                ))
              }</g
            ><path class="at-hz-path" d="M319 230A140 172 0 0 0 131.1 68.4" pathLength="100"></path><circle
              class="at-hz-end" cx="318.5" cy="215" r="2.2"></circle>
          </svg>
          <div class="at-cloud" aria-hidden="true"></div>
          <div class="at-cloud at-cloud2" aria-hidden="true"></div>
          <div class="at-orb" aria-hidden="true"></div>
          <svg width="358" height="32"
            class="at-hz-hill"
            viewBox="0 0 358 32"
            aria-hidden="true"
            focusable="false"
            ><path
              class="at-hz-far"
              d="M0 32V14C40 6 76 2 118 8C160 14 186 4 232 5C276 6 300 14 336 10C346 9 352 9 358 10V32Z"
            ></path><path
              class="at-hz-near"
              d="M0 32V22C30 14 58 12 92 18C130 25 150 12 196 14C240 16 262 24 300 19C322 16 342 15 358 18V32Z"
            ></path></svg
          >
          <div class="at-hz-water" aria-hidden="true"></div>
          <div class="at-hz-glint" aria-hidden="true"><div></div></div>
          <div class="at-hz-line" aria-hidden="true"></div>
          <div class="at-hz-text">
            <div class="at-digits" role="timer" data-l="timer">
              <span data-t="a">{a}</span><span class="at-secs" data-t="b"
                >{b}</span>
            </div>
            <div class="at-hz-meta">
              <span class="at-hz-name" data-t="hz"></span>
              <span class="at-hz-when"
                ><span data-t="ma">{meta}</span>
                <span data-t="mb"></span></span
              >
            </div>
          </div>
        </div>

        <div class="at-face at-face-tide">
          <div class="at-tide-water" aria-hidden="true">
            <svg width="716" height="28"
              class="at-wave2"
              viewBox="0 0 716 28"
              preserveAspectRatio="none"
              focusable="false"><path d={wave(8, 1.6)}></path></svg
            >
            <svg width="716" height="28"
              class="at-wave1"
              viewBox="0 0 716 28"
              preserveAspectRatio="none"
              focusable="false"><path d={wave(6, 0)}></path></svg
            >
            <div class="at-tide-body"></div>
            <div class="at-bubbles">
              {
                bubbles.map(([x, y, s, d]) => (
                  <span
                    style={`--x:${String(x)};--y:${String(y)};--s:${String(s)};animation-delay:${String(d)}s`}
                  />
                ))
              }
            </div>
          </div>
          <div class="at-tide-text">
            <div class="at-kick" data-t="k">{t('tool.kicker.ready')}</div>
            <div class="at-digits" role="timer" data-l="timer">
              <span data-t="a">{a}</span><span data-t="b">{b}</span>
            </div>
            <div class="at-meta">
              <span data-t="ma">{meta}</span>
              <span data-t="mb"></span>
            </div>
          </div>
          <div class="at-tide-text at-tide-under" aria-hidden="true">
            <div class="at-kick" data-t="k">{t('tool.kicker.ready')}</div>
            <div class="at-digits">
              <span data-t="a">{a}</span><span data-t="b">{b}</span>
            </div>
            <div class="at-meta">
              <span data-t="ma">{meta}</span>
              <span data-t="mb"></span>
            </div>
          </div>
        </div>

        <div class="at-face at-face-x" role="timer" data-l="timer" data-face-host></div>
      </div>
      <span class="at-ig-face" aria-hidden="true"></span>
      <span class="at-lamp-off" aria-hidden="true"></span>
    </div>
  </div>

  <div class="at-tabs">
    <FaceSwitch locale={locale} />
  </div>

  <div class="at-note">
    <div class="at-card-tone at-blocked" role="alert">
      <h2>{t('tool.blocked.title')}</h2>
      <p class="at-cause" data-t="cause"></p>
      <ul class="at-causes">
        <li>
          <span
            ><b>{t('tool.blocked.safari')}</b>
            {t('tool.blocked.safari.fix')}</span>
        </li>
        <li>
          <span
            ><b>{t('tool.blocked.hidden')}</b>
            {t('tool.blocked.hidden.fix')}</span>
        </li>
        <li>
          <span
            ><b>{t('tool.blocked.firefox')}</b>
            {t('tool.blocked.firefox.fix')}</span>
        </li>
      </ul>
      <p class="at-then">{t('tool.blocked.then')}</p>
      <p>{t('tool.blocked.fallback')}</p>
    </div>
    <div class="at-card-tone at-lowbatt" role="status">
      <h2>
        <Icon name="battery-warning" size={20} tone="ink" />
        {t('tool.battery.title')}
      </h2>
      <p data-t="battBody"></p>
    </div>
    <section
      class="at-install-card at-card"
      aria-labelledby="at-install-h"
      data-install-card
      hidden
    >
      <div class="at-install-head">
        <span class="at-install-mark" aria-hidden="true"
          ><svg width="20" height="20" viewBox="0 0 48 48"
            ><path d="M32.8 11.4A16 16 0 1 1 15.2 11.4"></path><circle
              cx="24"
              cy="9"
              r="5"></circle></svg
          ></span
        >
        <h2 id="at-install-h">{t('pwa.install')}</h2>
      </div>
      <p data-install-body>{t('pwa.card.body')}</p>
      <div class="at-acts">
        <Button data-install-later>{t('pwa.card.later')}</Button>
        <Button variant="stop" size="md" data-install-now
          >{t('pwa.install.short')}</Button
        >
      </div>
    </section>
    <div class="at-noterow">
      {
        untilWall && (
          <p class="at-whenline">
            <svg width="16" height="16"
              class="at-when-moon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
            </svg>
            <svg width="16" height="16"
              class="at-when-sun"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <>
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
              </>
            </svg>
            <span data-t="whenLine" />
          </p>
        )
      }
      <p class="at-note-text" data-t="note">{t('tool.note.ready')}</p>
      <button
        class="at-why-btn at-why-note"
        type="button"
        data-act="why"
        aria-expanded="false"
        aria-controls="at-why">{t('tool.why.open')}</button
      >
    </div>
  </div>

  <section class="at-toasts" data-toasts aria-label={t('tool.notifications')} aria-live="polite"></section>

  <div class="at-dock">
    <span class="at-ig-dock" aria-hidden="true"></span>
    <span class="at-ig-travel" aria-hidden="true"></span>
    {
      !embed && (
        <div class="at-dock-tools" role="group" aria-label={t('tool.tools')}>
          <Button size="sm" variant="quiet" data-open-notes aria-haspopup="dialog" kbd="N" aria-keyshortcuts="N" title={t('tool.notes.key')}>
            <Icon name="note-pencil" />
            {t('tool.notes.open')}
          </Button>
          <span class="at-dock-dot" aria-hidden="true" />
          <Button size="sm" variant="quiet" data-act="intention" kbd="I" aria-keyshortcuts="I" title={t('tool.intention.key')}>
            <Icon name="target" />
            {t('tool.intention.open')}
          </Button>
        </div>
      )
    }
    {
      untilWall ? (
        <div class="at-untilchips">
          <a class="at-chip at-chip-on" href="#times" data-l="untilChip">
            <>
              <span class="at-dot" aria-hidden="true" />
              <span data-t="untilChip" />
            </>
          </a>
          <a class="at-chip at-chip-choose" href={localePath(locale, '/')}>
            {t('tool.until.pick')}
          </a>
        </div>
      ) : (
        <div class="at-len" data-chips role="group" aria-label={t('tool.presets')}>
          <div class="at-seg at-bar">
            <span class="at-seg-ind" aria-hidden="true" />
            {[...presets, 'pinf' as const].map((id) => (
              <button
                class="at-seg-item at-chip"
                type="button"
                data-preset={id}
                aria-pressed={id === ready.chip ? 'true' : 'false'}
                aria-label={t(`tool.preset.${id}.sr`)}
              >
                {t(`tool.preset.${id}`)}
              </button>
            ))}
            <button
              class="at-seg-item at-chip at-len-more"
              type="button"
              data-act="more"
              popovertarget="at-lenmore"
              style="anchor-name:--at-lenmore"
              aria-pressed={eight ? 'true' : 'false'}
              data-l="moreAria"
              aria-label={t('tool.chip.moreAria')}
              title={t('tool.chip.moreAria')}
            >
              <Icon name="dots-three-outline" tone="ink" />
            </button>
          </div>
          <div class="at-run" aria-live="off">
            <p class="at-sum">
              <span class="at-sum-end">
                {endsAt[0]}
                <span data-t="mb" />
                {endsAt[1]}
              </span>
              <span class="at-sum-inf">{t('tool.len.inf')}</span>
              <span class="at-sum-p" data-t="ma" />
              <span class="at-sum-sep" aria-hidden="true">·</span>
              <button class="at-sum-change" type="button" data-act="change" aria-label={t('tool.len.changeAria')}>
                {t('tool.len.change')}
              </button>
            </p>
            <div class="at-ext" role="group" aria-label={t('tool.extend.label')}>
              {extend.map(([ms, key]) => (
                <button class="at-chip at-ext-chip" type="button" data-act={ms} aria-label={t(`tool.extend.${key}.sr`)}>
                  {t(`tool.extend.${key}`)}
                </button>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {
      !untilWall && (
        <div class="at-lenmore" id="at-lenmore" popover style="position-anchor:--at-lenmore">
          <button class="at-more-row" type="button" data-preset="until" popovertarget="at-lenmore" popovertargetaction="hide" aria-pressed="false" data-l="untilAria" aria-label={t('tool.chip.untilAria')} aria-keyshortcuts="U">
            <Icon name="clock" />
            <span class="at-more-t" data-t="untilLong">{t('tool.preset.until')}</span>
            <kbd class="at-kbd at-kbd-hint" aria-hidden="true">U</kbd>
          </button>
          <button class="at-more-row" type="button" data-preset="custom" popovertarget="at-lenmore" popovertargetaction="hide" aria-pressed={eight ? 'true' : 'false'} data-l="customAria" aria-label={t('tool.chip.customAria')}>
            <Icon name="timer" />
            <span class="at-more-t" data-t="custom">{eight ? ready.len : t('tool.preset.custom')}</span>
          </button>
        </div>
      )
    }

    <div class="at-lpanel at-lp-until">
      <div class="at-lp-head">
        <label class="at-lp-title" for="at-until-time"
          ><Icon name="clock" size={20} />{t('tool.until.title')}</label
        >
        <button
          class="at-icon-button"
          type="button"
          data-act="close"
          aria-label={close}
          ><Icon name="x" size={20} tone="ink" class="at-duo-bare" /></button
        >
      </div>
      <input
        class="at-input at-until-input"
        id="at-until-time"
        type="time"
        data-until-input
        aria-describedby="at-until-hint"
      />
      <span class="at-sr" id="at-until-hint">{t('tool.until.hint')}</span>
      <div class="at-past" role="status">
        <p data-t="pastQ"></p>
        <div class="at-past-row">
          <span data-t="pastIn"></span><button
            type="button"
            data-act="changeTime">{t('tool.until.change')}</button>
        </div>
      </div>
      <div class="at-slots">
        {
          [0, 1, 2, 3].map((i) => (
            <button
              class="at-slot"
              type="button"
              data-slot={i}
              aria-pressed="false"
            >
              <>
                <span data-t={`slot${String(i)}`} />
                <span class="at-slot-sub" data-t={`slotSub${String(i)}`} />
              </>
            </button>
          ))
        }
      </div>
      <p class="at-lp-then">
        <Icon name="flag-checkered" size={16} />
        <span><span data-t="ma">{meta}</span> <b data-t="mb"></b></span>
      </p>
    </div>

    <div class="at-lpanel at-lp-custom">
      <div class="at-lp-head">
        <span class="at-lp-title"><Icon name="timer" size={20} />{t('tool.custom.title')}</span>
        <button
          class="at-icon-button"
          type="button"
          data-act="close"
          aria-label={close}
          ><Icon name="x" size={20} tone="ink" class="at-duo-bare" /></button
        >
      </div>
      <div class="at-stepper">
        <button
          type="button"
          data-act="less"
          data-l="lessAria"
          aria-label={t('tool.custom.less5')}
          ><Icon name="minus" size={20} tone="ink" class="at-duo-bare" /></button
        >
        <output data-t="customWords" aria-live="polite"></output>
        <button
          type="button"
          data-act="more5"
          data-l="moreAria5"
          aria-label={t('tool.custom.more5')}
          ><Icon name="plus" size={20} tone="ink" class="at-duo-bare" /></button
        >
      </div>
      <p class="at-lp-then">
        <Icon name="flag-checkered" size={16} />
        <span><span data-t="ma">{meta}</span> <b data-t="mb"></b></span>
      </p>
    </div>

    <section
      class="at-dockcard at-card"
      aria-labelledby="at-resume-h"
      data-resume
      hidden
    >
      <div class="at-dockcard-head">
        <span class="at-dockcard-icon at-dockcard-lamp" aria-hidden="true"><Icon name="clock-counter-clockwise" size={20} /></span>
        <div>
          <h2 id="at-resume-h">
            <span data-resume-title></span>
            <span class="at-dockcard-sub" data-resume-until></span>
          </h2>
          <p data-resume-body></p>
        </div>
      </div>
      <div class="at-acts">
        <Button data-resume-dismiss>{t('tool.resume.dismiss')}</Button>
        <Button variant="primary" data-resume-accept
          >{t('tool.resume.accept')}</Button
        >
      </div>
    </section>

    <section
      class="at-dockcard at-card"
      aria-labelledby="at-second-h"
      data-second-tab
      hidden
    >
      <div class="at-dockcard-head">
        <span class="at-dockcard-icon" aria-hidden="true"><Icon name="browsers" size={20} tone="ink" /></span>
        <div>
          <h2 id="at-second-h">{t('tool.secondTab.title')}</h2>
          <p>{t('tool.secondTab.body')}</p>
        </div>
      </div>
      <div class="at-acts at-acts-second">
        <Button data-tab-keep>{t('tool.secondTab.keepOther')}</Button>
        <Button variant="primary" glyph={false} data-tab-use
          >{t('tool.secondTab.useThis')}</Button
        >
      </div>
    </section>

    <Dialog
      name="share"
      title={t('tool.share.title')}
      titleId="share-title"
      closeLabel={close}
      class="at-share"
      docked
      autofocus
    >
      <div class="at-share-card">
        <div class="at-share-look">
          <svg class="at-share-ring" width="56" height="56" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
            <circle class="at-share-track" cx="28" cy="28" r="23"></circle>
            <circle class="at-share-arc" cx="28" cy="28" r="23" pathLength="100"></circle>
            <circle class="at-share-bead" cx="28" cy="5" r="3.5"></circle>
          </svg>
          <div class="at-share-what">
            <span class="at-share-pill" aria-hidden="true">
              <span class="at-share-off">{t('tool.pill.idle')}</span><span class="at-share-on">{t('tool.pill.held')}</span>
            </span>
            <p class="at-share-label" data-share-label></p>
            <p class="at-caption">
              <span class="at-share-off">{t('tool.share.look.waits')}</span><span class="at-share-on">{t('tool.share.look.starts')}</span>
            </p>
          </div>
        </div>
        <div class="at-share-row">
          <label class="sr-only" for="at-share-url">{t('tool.share.link')}</label>
          <input class="at-share-url" id="at-share-url" data-share-url readonly />
          <Button
            variant="stop"
            size="sm"
            class="at-copy"
            data-share-copy
            aria-label={t('tool.share.copyAria')}
          >
            <Icon name="copy" size={16} class="at-copy-i" />
            <Icon name="check" size={16} class="at-copied-i" />
            <span class="at-copy-t">{t('tool.share.copy')}</span><span class="at-copied-t">{t('tool.share.copied')}</span>
          </Button>
        </div>
      </div>
      <label class="at-switchrow">
        <span class="at-switch-text"
          ><span class="at-label">{t('tool.share.autostart')}</span><span
            class="at-caption">{t('tool.share.autostartHelp')}</span
          ></span
        >
        <input
          class="at-switch"
          type="checkbox"
          role="switch"
          data-share-auto
        />
      </label>
      <p class="at-caption at-share-msg" role="status" data-share-msg></p>
      <Fragment slot="footer">
        <Button data-share-native>
          <Icon name="share-network" size={20} />
          {t('tool.share.native')}
        </Button>
      </Fragment>
    </Dialog>

    <Dialog
      name="rating"
      title={t('rating.title')}
      titleId="rating-title"
      closeLabel={close}
      class="at-rate"
      size="sm"
      docked
      autofocus
    >
      <form class="at-rating" data-rating-form>
        <div class="at-rate-top">
          <fieldset class="at-stars">
            <legend class="sr-only">{t('rating.stars')}</legend>
            {
              [1, 2, 3, 4, 5].map((n) => (
                <label>
                  <input
                    class="sr-only"
                    type="radio"
                    name="stars"
                    value={String(n)}
                  />
                  <Icon name="star" size={28} />
                  <span class="sr-only">{t('rating.star', { n })}</span>
                </label>
              ))
            }
          </fieldset>
          <span class="at-caption at-star-word" aria-hidden="true"
            ><span>{t('rating.stars')}</span>{
              [1, 2, 3, 4, 5].map((n) => (
                <span data-n={String(n)}>{t('rating.star', { n })}</span>
              ))
            }</span
          >
        </div>
        <div class="at-rate-more">
          <p class="at-error" data-rating-error role="alert"></p>
          <div class="at-field">
            <label class="at-rate-label" for="at-rate-note"
              >{t('rating.text')}</label
            >
            <textarea
              class="at-input at-textarea"
              id="at-rate-note"
              name="text"
              maxlength="280"
              rows="2"></textarea>
          </div>
          <Button variant="stop" size="md" type="submit">{t('rating.send')}</Button>
        </div>
        <div class="at-rate-later">
          <Button variant="quiet" size="sm" data-rating-later>{t('rating.later')}</Button>
          <Button variant="quiet" size="sm" data-rating-never>{t('rating.never')}</Button>
        </div>
      </form>
    </Dialog>

    <Button
      class="at-cta"
      variant="primary"
      size="lg"
      data-act="start"
      data-l="cta"
      aria-label={cta}
      kbd="Space"
      aria-keyshortcuts="Space"
      ><span data-t="cta"
        >{untilWall ? cta : ready.cta}</span
      ></Button
    >

    <div class="at-acts at-acts-batt">
      <Button size="lg" data-act="battSettings"
        >{t('tool.battery.settings')}</Button
      >
      <Button variant="primary" size="lg" glyph={false} data-act="start"
        >{t('tool.battery.anyway')}</Button
      >
    </div>

    <div class="at-acts at-acts-run">
      {extend.map(([ms, key]) => (
        <Button class="at-extend" size="lg" data-act={ms} aria-label={t(`tool.extend.${key}.sr`)}>
          {t(`tool.extend.${key}`)}
        </Button>
      ))}
      <Button class="at-stop" size="lg" data-stop data-act="stop" kbd="Space" aria-keyshortcuts="Space">
        {t('tool.ring.stop')}
      </Button>
    </div>

    <div class="at-ask" role="group" aria-labelledby="at-ask-title">
      <div class="at-ask-head">
        <p id="at-ask-title" role="status">{t('tool.extend.title')}</p>
        <span role="timer" data-l="askAria" data-t="ask"></span>
      </div>
      <div class="at-ask-track" aria-hidden="true"><div></div></div>
      <div class="at-ask-opts">
        <button
          type="button"
          data-act="add15"
          aria-label={t('tool.extend.add15.sr')}
          >{t('tool.extend.add15')}</button
        >
        <button
          type="button"
          data-act="add30"
          aria-label={t('tool.extend.add30.sr')}
          >{t('tool.extend.add30')}</button
        >
        <button
          type="button"
          data-act="add60"
          aria-label={t('tool.extend.add60.sr')}
          >{t('tool.extend.add60')}</button
        >
        <button
          class="at-ask-stop"
          type="button"
          data-act="askStop"
          data-extend-stop>{t('tool.extend.stop')}</button
        >
      </div>
      {
        sponsorEnabled && (
          <SponsorCard placement="extend" label={t('sponsor.label')} />
        )
      }
    </div>

    <div class="at-acts at-acts-blocked">
      <Button size="lg" data-act="fallback"
        >{t('tool.fallback.consent.accept')}</Button
      >
      <Button variant="stop" size="lg" data-act="retry">{t('tool.advice.retry')}</Button>
    </div>

    <div class="at-acts at-acts-tap">
      <Button size="lg" data-act="stop">{t('tool.ring.stop')}</Button>
      <Button
        variant="primary"
        size="lg"
        glyph={false}
        class="at-float"
        data-act="fallback">{t('tool.fallback.consent.start')}</Button
      >
    </div>
    {
      sponsorEnabled && (
        <SponsorCard placement="idle" label={t('sponsor.label')} />
      )
    }
  </div>

  <span id="at-tool-parsed" hidden></span>

  <div class="at-banner at-lang-banner" data-lang-suggest hidden>
    <div class="at-fs-bar">
      <svg
        class="at-toast-i"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="9"></circle><path
          d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"
        ></path></svg
      >
      <p data-lang-suggest-text></p>
      <button
        class="at-icon-button"
        type="button"
        data-lang-suggest-dismiss
        aria-label={t('i18n.suggest.dismiss')}
        ><svg width="20" height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"><path d={X}></path></svg
        ></button
      >
    </div>
    <a class="at-button at-button-sm" data-lang-suggest-accept href="/"
      >{t('i18n.suggest.accept')}</a
    >
  </div>
  <noscript><p class="at-noscript">{t('tool.noscript')}</p></noscript>
</div>

<Sheet
  name="settings"
  title={t('settings.title')}
  titleId="settings-title"
  description={t('settings.lead')}
  closeLabel={t('settings.close')}
  body="form"
  bodyClass="at-settings"
>
  <div class="at-sg-list">
    <button class="at-sg-sum at-sg-door" type="button" data-act="customize" data-tab="look">
      <span class="at-sg-ico"><Icon name="sparkle" size={24} /></span>
      <span class="at-sg-text">
        <span class="at-sg-title">{t('settings.looks')}</span>
        <span class="at-sg-now">{t('settings.looks.help')}</span>
      </span>
      <Icon name="caret-right" size={20} tone="ink" class="at-sg-chev at-sg-go" />
    </button>
    <details class="at-sg" name="at-settings" data-sg="timer">
      <summary class="at-sg-sum">
        <span class="at-sg-ico"><Icon name="hourglass-medium" size={24} /></span>
        <span class="at-sg-text">
          <span class="at-sg-title">{t('settings.g.timer')}</span>
          <span class="at-sg-now"
            ><span data-sg-end></span><span>{
              sumEnd.map(([v, k]) => <span data-v={v}>{t(k)}</span>)
            }</span> · <span data-sg-snd></span> · <span
              ><span data-v="nt-on">{t('settings.sum.notifyOn')}</span><span data-v="nt-off"
                >{t('settings.sum.notifyOff')}</span
              ></span
            ></span
          >
        </span>
        <Icon name="caret-down" size={20} tone="ink" class="at-sg-chev" />
      </summary>
      <div class="at-sg-body">
        <div class="at-field">
          <span class="at-label" id="lb-end">{t('settings.endBehaviour')}</span>
          <div
            class="at-seg at-sseg"
            role="radiogroup"
            aria-labelledby="lb-end"
            style="--at-seg-n:2"
          >
            <span class="at-seg-ind" aria-hidden="true"></span>
            <label class="at-seg-item"
              ><input
                class="sr-only"
                type="radio"
                name="endBehaviour"
                value="prompt_extend"
                checked
              />{t('settings.endBehaviour.prompt_extend')}</label
            >
            <label class="at-seg-item"
              ><input
                class="sr-only"
                type="radio"
                name="endBehaviour"
                value="stop"
              />{t('settings.endBehaviour.stop')}</label
            >
          </div>
        </div>
        <div class="at-switchrow at-notes-setrow">
          <span class="at-switch-text">
            <span class="at-label">{t('settings.sound')}</span>
            <span class="at-caption" data-sg-snd-now>{t('settings.sum.soundHelp')}</span>
          </span>
          <button class="at-button at-button-sm" type="button" data-act="customize" data-tab="sound"
            >{t('settings.sum.soundOpen')}</button
          >
        </div>
        <label class="at-switchrow">
          <span class="at-switch-text"
            ><span class="at-label">{t('settings.notifications')}</span><span
              class="at-caption"
              data-notifications-note>{t('settings.notifications.help')}</span
            ></span
          >
          <input
            class="at-switch"
            type="checkbox"
            role="switch"
            name="notifications"
          />
        </label>
      </div>
    </details>

    <details class="at-sg" name="at-settings" data-sg="clock">
      <summary class="at-sg-sum">
        <span class="at-sg-ico"><Icon name="clock" size={24} /></span>
        <span class="at-sg-text">
          <span class="at-sg-title">{t('settings.g.clock')}</span>
          <span class="at-sg-now"
            ><span
              ><span data-v="fmt-auto">{t('settings.ambient.clock.auto')}</span><span data-v="fmt-12"
                >{t('settings.clock.12')}</span
              ><span data-v="fmt-24">{t('settings.clock.24')}</span></span
            > · <span
              ><span data-v="sec-on">{t('settings.sum.secondsOn')}</span><span data-v="sec-off"
                >{t('settings.sum.secondsOff')}</span
              ></span
            ><span data-sg-zone></span> · {here.label}</span
          >
        </span>
        <Icon name="caret-down" size={20} tone="ink" class="at-sg-chev" />
      </summary>
      <div class="at-sg-body">
        <div class="at-field">
          <span class="at-label" id="lb-fmt">{t('settings.ambient.clock')}</span>
          <div
            class="at-seg at-sseg at-sseg-sm"
            role="radiogroup"
            aria-labelledby="lb-fmt"
          >
            <span class="at-seg-ind" aria-hidden="true"></span>
            <label class="at-seg-item"
              ><input
                class="sr-only"
                type="radio"
                name="clock24h"
                value="auto"
                checked
              />{t('settings.ambient.clock.auto')}</label
            >
            <label class="at-seg-item"
              ><input class="sr-only" type="radio" name="clock24h" value="12" />{
                t('settings.clock.12')
              }</label
            >
            <label class="at-seg-item"
              ><input class="sr-only" type="radio" name="clock24h" value="24" />{
                t('settings.clock.24')
              }</label
            >
          </div>
          <span class="at-caption at-tabnum" data-t="nowShows"></span>
        </div>
        <label class="at-switchrow">
          <span class="at-switch-text"
            ><span class="at-label">{t('settings.ambient.seconds')}</span><span
              class="at-caption">{t('settings.seconds.help')}</span
            ></span
          >
          <input
            class="at-switch"
            type="checkbox"
            role="switch"
            name="showSeconds"
          />
        </label>
        <div data-fx-zone></div>
        <details class="at-langrow">
          <summary class="at-row at-langrow-btn" id="at-lang-set-btn">
            <span>{t('settings.locale')}</span>
            <span class="at-langrow-cur"
              >{here.label}<Icon name="caret-down" size={16} tone="ink" class="at-lang-chev" /></span
            >
          </summary>
          <ul
            class="at-lang-list at-langrow-list"
            id="at-lang-set-list"
            role="list"
            aria-label={t('settings.locale')}
          >
            {
              LOCALES.map((code) => {
                const meta = LOCALE_META[code];
                const current = code === locale;
                const tl = createT(code);
                const note = current
                  ? t('footer.language.current')
                  : meta.reviewed
                    ? ''
                    : t('footer.language.review');
                return (
                  <li>
                    <a
                      class="at-lang-row"
                      href={localePath(code, '/')}
                      lang={meta.htmlLang}
                      hreflang={meta.hreflang}
                      aria-current={current ? 'true' : undefined}
                      data-code={code}
                      data-q={tl('i18n.suggest', { language: meta.label })}
                      data-a={tl('i18n.suggest.accept')}
                    >
                      <svg
                        width="20"
                        height="20"
                        class="at-lang-mark"
                        viewBox="0 0 20 20"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <>
                          <circle class="at-lang-ring" cx="10" cy="10" r="8" />
                          <circle class="at-lang-dot" cx="10" cy="10" r="4" />
                        </>
                      </svg>
                      <span class="at-lang-name">{meta.label}</span>
                      <span class="at-lang-note" lang={here.htmlLang}>
                        {note}
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
