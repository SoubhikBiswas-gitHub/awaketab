            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3M4.5 4.5v3.6h3.6M12 8.5V12l2.5 1.8"
            ></path></svg
          ></span
        >
        <div>
          <h2 id="at-resume-h">
            <span data-resume-title></span>
            <span class="at-dockcard-sub" data-resume-until></span>
          </h2>
          <p data-resume-body></p>
        </div>
      </div>
      <div class="at-acts">
        <Button data-resume-dismiss>{t('tool.resume.dismiss')}</Button>
        <Button variant="primary" data-resume-accept
          >{t('tool.resume.accept')}</Button
        >
      </div>
    </section>

    <section
