          >{t('tool.share.link')}</label
        >
        <div class="at-share-row">
          <input
            class="at-input at-share-url"
            id="at-share-url"
            data-share-url
            readonly
          />
          <button
            class="at-button at-button-sm at-copy"
            type="button"
            data-share-copy
            aria-label={t('tool.share.copyAria')}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path class="at-copy-i" d="M9 9h10.5v10.5H9zM15 9V4.5H4.5V15H9"
              ></path><path class="at-copied-i" d="M5 12.5l4.5 4.5L19 7.5"
              ></path></svg
            >
            <span class="at-copy-t">{t('tool.share.copy')}</span><span
