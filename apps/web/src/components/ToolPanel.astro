  </div>
  <div class="at-ambient-bar" data-ambient-controls>
    <button class="at-button at-button-sm" type="button" data-ambient-next
      >{t('ambient.next')}</button
    >
    <button class="at-button at-button-sm" type="button" data-ambient-fullscreen
      >{t('tool.header.fullscreen')}</button
    >
    <button class="at-button at-button-sm" type="button" data-ambient-exit
      >{t('ambient.exit')}</button
    >
  </div>
</dialog>
