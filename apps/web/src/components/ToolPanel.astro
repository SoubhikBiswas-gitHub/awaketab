          id="at-batt"
          type="range"
          name="batteryThreshold"
          min="5"
          max="30"
          step="1"
          value="15"
          aria-describedby="at-batt-hint"
        />
        <span class="at-caption" id="at-batt-hint" data-battery-hint
          >{t('settings.battery.off')}</span
        >
      </div>
    </section>
    <p class="at-caption" data-battery-unavailable hidden>
      {t('settings.battery.unavailable')}
    </p>

    <section aria-labelledby="st-priv" class="at-tight">
      <h3 class="at-kicker" id="st-priv">{t('settings.privacy')}</h3>
      <label class="at-switchrow">
        <span class="at-switch-text"
          ><span class="at-label">{t('settings.telemetry')}</span></span
        >
        <input
          class="at-switch"
          type="checkbox"
          role="switch"
          name="telemetry"
          checked
        />
      </label>
      <label class="at-switchrow">
        <span class="at-switch-text"
          ><span class="at-label">{t('settings.shortcuts')}</span><span
            class="at-caption at-keys-help"
            set:html={keysHelp}
          /></span
        >
        <input
          class="at-switch"
          type="checkbox"
          role="switch"
          name="keyboardShortcuts"
          checked
        />
      </label>
      <label class="at-switchrow">
        <span class="at-switch-text"
          ><span class="at-label">{t('settings.hints')}</span></span
        >
        <input
          class="at-switch"
          type="checkbox"
          role="switch"
          name="keyboardHints"
          checked
        />
      </label>
    </section>

    <div class="at-settings-foot">
      <div class="at-settings-links">
        <button class="at-phone-only at-textlink" type="button" data-open-stats
          >{t('stats.title')}</button
        >
        <button class="at-phone-only at-textlink" type="button" data-open-share
          >{t('tool.share.title')}</button
        >
        <button class="at-phone-only at-textlink" type="button" data-open-shortcuts
          >{t('tool.shortcuts.title')}</button
        >
        <a class="at-textlink" href="/pro" data-open-pro>{t('settings.pro')}</a>
        <a class="at-textlink" href="/pro/manage">{t('settings.pro.manage')}</a>
      </div>
      <Button data-settings-reset>{t('settings.reset')}</Button>
    </div>
  </form>
</dialog>

<dialog
  class="at-sheet at-tsheet"
  data-dialog="stats"
  aria-labelledby="stats-title"
>
  <div class="at-tsheet-head">
    <span class="at-grab" aria-hidden="true"></span>
    <div class="at-tsheet-bar">
      <h2 id="stats-title">{t('stats.title')}</h2>
      <button
        class="at-icon-button"
        type="button"
        data-stats-close
        aria-label={t('stats.closeSr')}
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"><path d={X}></path></svg
        ></button
      >
    </div>
  </div>
  <div class="at-tsheet-body">
    <p class="at-caption" data-stats-empty hidden>{t('stats.empty')}</p>
    <dl class="at-figs">
      <div><dt>{t('stats.today')}</dt><dd data-stats-today></dd></div>
      <div><dt>{t('stats.week')}</dt><dd data-stats-week></dd></div>
      <div><dt>{t('stats.streakLabel')}</dt><dd data-stats-streak></dd></div>
      <div><dt>{t('stats.total')}</dt><dd data-stats-total></dd></div>
    </dl>
    <section class="at-heat-sec" aria-labelledby="st-heat">
      <div class="at-field-top">
        <h3 class="at-kicker" id="st-heat">{t('stats.heat.title')}</h3><span
          class="at-caption">{t('stats.heat.sub')}</span>
      </div>
      <div class="at-heat" role="img" data-stats-heatmap>
        <div class="at-heat-lock" data-stats-locked>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
            ><rect x="5" y="11" width="14" height="10" rx="2"></rect><path
              d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg
          >
          {t('stats.heatmap.locked')}
        </div>
      </div>
      <div class="at-heat-legend" aria-hidden="true">
        <span>{t('stats.heat.less')}</span><i></i><i></i><i></i><i></i><i
        ></i><span>{t('stats.heat.more')}</span>
      </div>
    </section>
    <div class="at-stats-foot">
      <button
        class="at-button at-export"
        type="button"
        data-stats-export
        aria-describedby="st-csv-note"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg
        >
        {t('stats.export')}
        <span class="at-tag" data-export-pro>{t('pro.badge')}</span>
      </button>
      <p class="at-caption" id="st-csv-note">
        {t('stats.export.note')}
        <a href="/pro">{t('pro.see')}</a>
      </p>
    </div>
  </div>
</dialog>

<dialog
  class="at-float-sheet"
  data-dialog="shortcuts"
  aria-labelledby="shortcuts-title"
>
  <span class="at-grab" aria-hidden="true"></span>
  <div class="at-fs-bar">
    <h2 id="shortcuts-title">{t('tool.shortcuts.title')}</h2>
    <button
      class="at-icon-button"
      type="button"
      data-shortcuts-close
      aria-label={close}
      ><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"><path d={X}></path></svg
      ></button
    >
  </div>
  <p class="at-keys-note" role="note">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
      ><rect x="2.5" y="6" width="19" height="12" rx="2.5"></rect><path
        d="M6.5 10h1M10.5 10h1M14.5 10h1M17.5 10h.5M7.5 14h9"></path></svg
    >
    <span>{t('tool.shortcuts.phoneNote')}</span>
  </p>
  <dl class="at-keys">
    {
      shortcuts.map(([k1, k2, label]) => (
        <div>
          <dt>
            <kbd class="at-kbd">{k1}</kbd>
            {k2 && (
              <>
                <span aria-hidden="true">–</span>
                <kbd class="at-kbd">{k2}</kbd>
              </>
            )}
          </dt>
          <dd>{label}</dd>
        </div>
      ))
    }
  </dl>
  <p class="at-caption at-keys-foot">
    <span class="at-phone-hide">{t('tool.shortcuts.foot')}</span><span
      class="at-phone-only">{t('tool.shortcuts.footPhone')}</span>
  </p>
</dialog>

<dialog
  data-dialog="pro"
  class="at-float-sheet"
  aria-labelledby="pro-sheet-title"
>
  <h2 id="pro-sheet-title">{t('pro.title')}</h2>
  <p>{t('pro.card')}</p>
  <p>
    <a href="/pro">{t('pro.cta')}</a> · <a href="/pro/activate"
      >{t('pro.activate')}</a>
  </p>
  <button class="at-button" type="button" data-pro-close
    >{t('settings.close')}</button
  >
</dialog>

<dialog class="at-ambient" data-ambient aria-labelledby="ambient-title">
  <h2 class="sr-only" id="ambient-title" data-ambient-title>
    {t('ambient.mode.clock')}
  </h2>
  <div class="at-ambient-stage" data-ambient-stage>
    <div class="at-ambient-content" data-ambient-content></div>
  </div>
  <div class="at-ambient-bar" data-ambient-controls>
    <button class="at-button at-button-sm" type="button" data-ambient-next
      >{t('ambient.next')}</button
    >
    <button class="at-button at-button-sm" type="button" data-ambient-fullscreen
      >{t('tool.header.fullscreen')}</button
    >
    <button class="at-button at-button-sm" type="button" data-ambient-exit
      >{t('ambient.exit')}</button
    >
  </div>
</dialog>
