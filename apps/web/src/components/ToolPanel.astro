            <div class="at-ext" role="group" aria-label={t('tool.extend.label')}>
              {extend.map(([ms, key]) => (
                <button class="at-chip at-ext-chip" type="button" data-act={ms} aria-label={t(`tool.extend.${key}.sr`)}>
                  {t(`tool.extend.${key}`)}
                </button>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {
      !untilWall && (
        <div class="at-lenmore" id="at-lenmore" popover style="position-anchor:--at-lenmore">
          <button class="at-more-row" type="button" data-preset="until" popovertarget="at-lenmore" popovertargetaction="hide" aria-pressed="false" data-l="untilAria" aria-label={t('tool.chip.untilAria')} aria-keyshortcuts="U">
            <Icon name="clock" />
            <span class="at-more-t" data-t="untilLong">{t('tool.preset.until')}</span>
            <kbd class="at-kbd at-kbd-hint" aria-hidden="true">U</kbd>
          </button>
          <button class="at-more-row" type="button" data-preset="custom" popovertarget="at-lenmore" popovertargetaction="hide" aria-pressed={eight ? 'true' : 'false'} data-l="customAria" aria-label={t('tool.chip.customAria')}>
            <Icon name="timer" />
            <span class="at-more-t" data-t="custom">{eight ? ready.len : t('tool.preset.custom')}</span>
          </button>
        </div>
      )
    }

    <div class="at-lpanel at-lp-until">
      <div class="at-lp-head">
        <label class="at-lp-title" for="at-until-time"
          >{t('tool.until.title')}</label
        >
        <div class="at-lp-tools">
          <input
            class="at-input at-until-input"
            id="at-until-time"
            type="time"
            data-until-input
            aria-describedby="at-until-hint"
          />
          <button
            class="at-icon-button"
            type="button"
            data-act="close"
            aria-label={close}
            ><svg width="20" height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"><path d={X}></path></svg
            ></button
          >
        </div>
      </div>
      <span class="at-sr" id="at-until-hint">{t('tool.until.hint')}</span>
      <div class="at-past" role="status">
        <p data-t="pastQ"></p>
        <div class="at-past-row">
          <span data-t="pastIn"></span><button
            type="button"
            data-act="changeTime">{t('tool.until.change')}</button>
        </div>
      </div>
      <div class="at-slots">
        {
          [0, 1, 2, 3].map((i) => (
            <button
              class="at-slot"
              type="button"
              data-slot={i}
              aria-pressed="false"
            >
              <>
                <span data-t={`slot${String(i)}`} />
                <span class="at-slot-sub" data-t={`slotSub${String(i)}`} />
              </>
            </button>
          ))
        }
      </div>
    </div>

    <div class="at-lpanel at-lp-custom">
      <div class="at-lp-head">
        <span class="at-lp-title">{t('tool.custom.title')}</span>
        <button
          class="at-icon-button"
          type="button"
          data-act="close"
          aria-label={close}
          ><svg width="20" height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"><path d={X}></path></svg
          ></button
        >
      </div>
      <div class="at-stepper">
        <button
          type="button"
          data-act="less"
          data-l="lessAria"
          aria-label={t('tool.custom.less5')}
          ><svg width="20" height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"><path d="M5 12h14"></path></svg
          ></button
        >
        <output data-t="customWords" aria-live="polite"></output>
        <button
          type="button"
          data-act="more5"
          data-l="moreAria5"
          aria-label={t('tool.custom.more5')}
          ><svg width="20" height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg
          ></button
        >
      </div>
    </div>

    <section
      class="at-dockcard at-card"
      aria-labelledby="at-resume-h"
