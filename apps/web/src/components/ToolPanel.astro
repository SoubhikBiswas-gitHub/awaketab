          stroke-linecap="round"
          aria-hidden="true"
          ><rect x="5" y="11" width="14" height="10" rx="2"></rect><path
            d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg
        >
        {t('stats.heatmap.locked')}
      </div>
    </div>
    <div class="at-heat-legend" aria-hidden="true">
      <span>{t('stats.heat.less')}</span><i></i><i></i><i></i><i></i><i
      ></i><span>{t('stats.heat.more')}</span>
    </div>
  </section>
  <div class="at-stats-foot">
    <button
      class="at-button at-export"
      type="button"
      data-stats-export
      aria-describedby="st-csv-note"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg
      >
      {t('stats.export')}
      <span class="at-tag" data-export-pro>{t('pro.badge')}</span>
    </button>
    <p class="at-caption" id="st-csv-note">
      {t('stats.export.note')}
      <a href="/pro">{t('pro.see')}</a>
    </p>
  </div>
</Sheet>

{
  !embed && (
    <Sheet
      name="notes"
      title={t('notes.title')}
      titleId="notes-title"
      description={t('notes.private')}
      closeLabel={t('notes.close')}
      class="at-notes"
      bodyClass="at-notes-body"
    >
      <div class="at-notes-bar">
        <p class="at-notes-live" aria-hidden="true">
          <span class="at-notes-bead" />
          <span data-notes-live />
        </p>
        <div class="at-notes-nav">
          <button
            class="at-button at-button-sm at-button-quiet"
            type="button"
            data-notes-all
            aria-expanded="false"
            aria-controls="at-notes-list"
            hidden
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d={NOTE_ICON.list} />
            </svg>
            {t('notes.all')}
            <span class="at-notes-count" data-notes-count />
          </button>
          <button class="at-button at-button-sm" type="button" data-notes-new>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            {t('notes.new')}
            <span class="at-tag" data-notes-pro-tag>{t('pro.badge')}</span>
          </button>
        </div>
      </div>
      <p class="at-caption at-notes-pv" data-notes-pv hidden>
        <span class="at-notes-pv-dot" aria-hidden="true" />
        {t('notes.pro.previewing')}
      </p>
      <section class="at-notes-panel" data-notes-pro aria-labelledby="at-notes-pro-h" hidden>
        <h3 class="at-notes-panel-h" id="at-notes-pro-h">{t('notes.pro.title')}</h3>
        <p>{t('notes.pro.body')}</p>
        <p class="at-caption">{t('notes.pro.keep')}</p>
        <div class="at-notes-row">
          <button class="at-button at-button-sm" type="button" data-notes-try>{t('notes.pro.try')}</button>
          <button class="at-button at-button-sm at-button-quiet" type="button" data-notes-see>{t('pro.see')}</button>
          <button class="at-button at-button-sm at-button-quiet" type="button" data-notes-pro-close>{t('notes.pro.later')}</button>
        </div>
      </section>
      <section class="at-notes-list" id="at-notes-list" data-notes-list aria-label={t('notes.all')} hidden>
        <input class="at-input" type="search" data-notes-search placeholder={t('notes.search')} aria-label={t('notes.search')} />
        <ul class="at-notes-items" data-notes-items />
        <p class="at-caption" data-notes-none hidden>{t('notes.none')}</p>
      </section>
      <div class="at-notes-pad" data-notes-pad>
        <p class="at-notes-ro" data-notes-ro role="note" hidden>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <rect x="5" y="11" width="14" height="10" rx="2" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
          </svg>
          <span>{t('notes.readonly')}</span>
        </p>
        <input
          class="at-notes-title"
          type="text"
          maxlength="120"
          data-notes-title
          placeholder={t('notes.untitled')}
          aria-label={t('notes.titleLabel')}
          hidden
        />
        <div class="at-notes-tools" role="toolbar" aria-label={t('notes.toolbar')} aria-controls="at-notes-ed">
          {
            NOTE_TOOLS.map(([cmd, keys, aria], i) => (
              <button
                class="at-notes-tool"
                type="button"
                data-cmd={cmd}
                data-keys={keys}
                aria-pressed="false"
                aria-label={t(`notes.tool.${cmd}`)}
                aria-keyshortcuts={aria}
                tabindex={i === 0 ? '0' : '-1'}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={NOTE_ICON[cmd]} />
                </svg>
              </button>
            ))
          }
          <span class="at-notes-sep" aria-hidden="true" />
          <button class="at-notes-tool at-notes-mic" type="button" data-notes-mic aria-pressed="false" aria-label={t('tool.notes.voice.start')} tabindex="-1" hidden>
            <span class="at-notes-ring" aria-hidden="true" />
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={NOTE_ICON.mic} />
            </svg>
          </button>
        </div>
        <section class="at-notes-panel" data-notes-consent aria-labelledby="at-notes-voice-h" hidden>
          <h3 class="at-notes-panel-h" id="at-notes-voice-h">{t('notes.voice.title')}</h3>
          <p>{t('notes.voice.notice')}</p>
          <p class="at-caption">{t('notes.voice.local')}</p>
          <div class="at-notes-row">
            <button class="at-button at-button-sm at-button-stop" type="button" data-notes-consent-ok>{t('notes.voice.ok')}</button>
            <button class="at-button at-button-sm at-button-quiet" type="button" data-notes-consent-no>{t('notes.voice.no')}</button>
          </div>
        </section>
        <p class="at-notes-listen" data-notes-listen hidden>
          <span class="at-notes-listen-i" aria-hidden="true" />
          <span data-notes-listen-text />
        </p>
        <div class="at-notes-paper">
          <div class="at-notes-ed" id="at-notes-ed" data-notes-editor />
          <p class="at-notes-interim" data-notes-interim aria-hidden="true" />
        </div>
      </div>
      <ul class="at-caption at-notes-help">
        <li>{t('notes.help.private')}</li>
        <li>{t('notes.help.md')}</li>
        <li data-notes-novoice hidden>{t('notes.help.novoice')}</li>
      </ul>
      <Fragment slot="footer">
        <div class="at-notes-foot">
          <p class="at-caption at-notes-meta">
            <span data-notes-words />
            <span class="at-notes-state" data-notes-state />
            <button class="at-textlink at-notes-undo" type="button" data-notes-undo hidden>{t('notes.undo')}</button>
          </p>
          <span class="sr-only" role="status" data-notes-said />
          <div class="at-notes-row" data-notes-acts>
            <button class="at-button at-button-sm" type="button" data-notes-copy>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 9h10.5v10.5H9zM15 9V4.5H4.5V15H9" />
              </svg>
              {t('notes.copy')}
            </button>
            <button class="at-button at-button-sm" type="button" data-notes-export="md" aria-label={t('notes.export.mdAria')}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={NOTE_ICON.save} />
              </svg>
              .md
            </button>
            <button class="at-button at-button-sm" type="button" data-notes-export="txt" aria-label={t('notes.export.txtAria')}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={NOTE_ICON.save} />
              </svg>
              .txt
            </button>
            <button class="at-button at-button-sm at-button-quiet at-notes-clear" type="button" data-notes-clear>{t('tool.notes.clear')}</button>
          </div>
          <div class="at-notes-row at-notes-confirm" data-notes-confirm role="group" aria-labelledby="at-notes-confirm-q" hidden>
            <p id="at-notes-confirm-q" data-notes-confirm-q />
            <button class="at-button at-button-sm at-button-quiet" type="button" data-notes-confirm-no>{t('notes.keep')}</button>
            <button class="at-button at-button-sm at-button-stop" type="button" data-notes-confirm-yes />
          </div>
        </div>
      </Fragment>
    </Sheet>
  )
}

<Dialog
  name="shortcuts"
  title={t('tool.shortcuts.title')}
  titleId="shortcuts-title"
  closeLabel={close}
  size="lg"
>
  <p class="at-keys-note" role="note">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
      ><rect x="2.5" y="6" width="19" height="12" rx="2.5"></rect><path
        d="M6.5 10h1M10.5 10h1M14.5 10h1M17.5 10h.5M7.5 14h9"></path></svg
    >
    <span>{t('tool.shortcuts.phoneNote')}</span>
  </p>
  <dl class="at-keys">
    {
      shortcuts.map(([k1, k2, label]) => (
        <div>
          <dt>
            <kbd class="at-kbd">{k1}</kbd>
            {k2 && (
              <>
                <span aria-hidden="true">–</span>
                <kbd class="at-kbd">{k2}</kbd>
              </>
            )}
          </dt>
          <dd>{label}</dd>
        </div>
      ))
    }
  </dl>
  <p class="at-caption at-keys-foot">
    <span class="at-phone-hide">{t('tool.shortcuts.foot')}</span><span
      class="at-phone-only">{t('tool.shortcuts.footPhone')}</span>
  </p>
</Dialog>

<Sheet
  name="pro"
  title={t('pro.title')}
  titleId="pro-sheet-title"
  closeLabel={close}
>
  <p>{t('pro.card')}</p>
  <Fragment slot="footer">
    <Button variant="primary" href="/pro" glyph={false}>{t('pro.cta')}</Button>
    <a class="at-textlink" href="/pro/activate">{t('pro.activate')}</a>
  </Fragment>
</Sheet>

