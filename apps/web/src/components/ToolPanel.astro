              />
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={FACE_ICON[f]} />
              </svg>
              <span>{t(`tool.face.${f}`)}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="at-field at-field-astyle">
      <span class="at-label" id="lb-astyle">{t('settings.face.analogStyle')}</span>
      <div
        class="at-seg at-sseg"
        role="radiogroup"
        aria-labelledby="lb-astyle"
        style="--at-seg-n:2"
      >
        <span class="at-seg-ind" aria-hidden="true"></span>
        {
          (['minimal', 'luxe'] as const).map((v) => (
            <label class="at-seg-item">
              <input
                class="sr-only"
                type="radio"
                name="analogStyle"
                value={v}
                checked={v === 'minimal'}
              />
              {t(`settings.face.analog.${v}`)}
            </label>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="st-time">
    <h3 class="at-kicker" id="st-time">{t('settings.time')}</h3>
    <details class="at-langrow">
      <summary class="at-row at-langrow-btn" id="at-lang-set-btn">
        <span>{t('settings.locale')}</span>
        <span class="at-langrow-cur"
          >{here.label}<svg
            width="16"
            height="16"
            class="at-lang-chev"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg
          ></span
        >
      </summary>
      <ul
        class="at-lang-list at-langrow-list"
        id="at-lang-set-list"
        role="list"
        aria-label={t('settings.locale')}
      >
        {
          LOCALES.map((code) => {
            const meta = LOCALE_META[code];
            const current = code === locale;
            const tl = createT(code);
            const note = current
              ? t('footer.language.current')
              : meta.reviewed
                ? ''
                : t('footer.language.review');
            return (
              <li>
                <a
                  class="at-lang-row"
                  href={localePath(code, '/')}
                  lang={meta.htmlLang}
                  hreflang={meta.hreflang}
                  aria-current={current ? 'true' : undefined}
                  data-code={code}
                  data-q={tl('i18n.suggest', { language: meta.label })}
                  data-a={tl('i18n.suggest.accept')}
                >
                  <svg
                    width="20"
                    height="20"
                    class="at-lang-mark"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <>
                      <circle class="at-lang-ring" cx="10" cy="10" r="8" />
                      <circle class="at-lang-dot" cx="10" cy="10" r="4" />
                    </>
                  </svg>
                  <span class="at-lang-name">{meta.label}</span>
                  <span class="at-lang-note" lang={here.htmlLang}>
                    {note}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </details>
    <div class="at-field">
      <span class="at-label" id="lb-fmt">{t('settings.ambient.clock')}</span>
      <div
        class="at-seg at-sseg at-sseg-sm"
        role="radiogroup"
        aria-labelledby="lb-fmt"
      >
        <span class="at-seg-ind" aria-hidden="true"></span>
        <label class="at-seg-item"
          ><input
            class="sr-only"
            type="radio"
            name="clock24h"
            value="auto"
            checked
          />{t('settings.ambient.clock.auto')}</label
        >
        <label class="at-seg-item"
          ><input class="sr-only" type="radio" name="clock24h" value="12" />{
            t('settings.clock.12')
          }</label
        >
        <label class="at-seg-item"
          ><input class="sr-only" type="radio" name="clock24h" value="24" />{
            t('settings.clock.24')
          }</label
        >
      </div>
      <span class="at-caption at-tabnum" data-t="nowShows"></span>
    </div>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.ambient.seconds')}</span><span
          class="at-caption">{t('settings.seconds.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="showSeconds"
      />
    </label>
  </section>

  <section aria-labelledby="st-end">
    <h3 class="at-kicker" id="st-end">{t('settings.endBehaviour')}</h3>
    <div
      class="at-seg at-sseg"
      role="radiogroup"
      aria-labelledby="st-end"
      style="--at-seg-n:2"
    >
      <span class="at-seg-ind" aria-hidden="true"></span>
      <label class="at-seg-item"
        ><input
          class="sr-only"
          type="radio"
          name="endBehaviour"
          value="prompt_extend"
          checked
        />{t('settings.endBehaviour.prompt_extend')}</label
      >
      <label class="at-seg-item"
        ><input
          class="sr-only"
          type="radio"
          name="endBehaviour"
          value="stop"
        />{t('settings.endBehaviour.stop')}</label
      >
    </div>
    <div class="at-field">
      <span class="at-label" id="lb-sound">{t('settings.sound')}</span>
      <div
        class="at-seg at-sseg"
        role="radiogroup"
        aria-labelledby="lb-sound"
        style="--at-seg-n:2"
      >
        <span class="at-seg-ind" aria-hidden="true"></span>
        <label class="at-seg-item"
          ><input
            class="sr-only"
            type="radio"
            name="sound"
            value="chime"
            checked
          />{t('settings.sound.chime')}</label
        >
        <label class="at-seg-item"
          ><input class="sr-only" type="radio" name="sound" value="none" />{
            t('settings.sound.none')
          }</label
        >
      </div>
    </div>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.notifications')}</span><span
          class="at-caption"
          data-notifications-note>{t('settings.notifications.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="notifications"
      />
    </label>
  </section>

  <section aria-labelledby="st-batt" data-battery-fields>
    <h3 class="at-kicker" id="st-batt">{t('settings.battery')}</h3>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.battery.autoStop')}</span><span
          class="at-caption">{t('settings.battery.help')}</span
        ></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="batteryAuto"
      />
    </label>
    <div class="at-range">
      <div class="at-field-top">
        <label class="at-label" for="at-batt"
          >{t('settings.battery.stopAt')}</label
        ><output class="at-label at-tabnum" for="at-batt" data-battery-label
          >15%</output>
      </div>
      <input
        id="at-batt"
        type="range"
        name="batteryThreshold"
        min="5"
        max="30"
        step="1"
        value="15"
        aria-describedby="at-batt-hint"
      />
      <span class="at-caption" id="at-batt-hint" data-battery-hint
        >{t('settings.battery.off')}</span
      >
    </div>
  </section>
  <p class="at-caption" data-battery-unavailable hidden>
    {t('settings.battery.unavailable')}
  </p>

  <section aria-labelledby="st-priv" class="at-tight">
    <h3 class="at-kicker" id="st-priv">{t('settings.privacy')}</h3>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.telemetry')}</span></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="telemetry"
        checked
      />
    </label>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.shortcuts')}</span><span
          class="at-caption at-keys-help"
          set:html={keysHelp}
        /></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="keyboardShortcuts"
        checked
      />
    </label>
    <label class="at-switchrow">
      <span class="at-switch-text"
        ><span class="at-label">{t('settings.hints')}</span></span
      >
      <input
        class="at-switch"
        type="checkbox"
        role="switch"
        name="keyboardHints"
        checked
      />
    </label>
  </section>

  <div class="at-settings-foot">
    <div class="at-settings-links">
      <button class="at-phone-only at-textlink" type="button" data-open-stats
        >{t('stats.title')}</button
      >
      <button class="at-phone-only at-textlink" type="button" data-open-share
        >{t('tool.share.title')}</button
      >
      <button class="at-phone-only at-textlink" type="button" data-open-shortcuts
        >{t('tool.shortcuts.title')}</button
      >
      <a class="at-textlink" href="/pro" data-open-pro>{t('settings.pro')}</a>
      <a class="at-textlink" href="/pro/manage">{t('settings.pro.manage')}</a>
    </div>
    <Button data-settings-reset>{t('settings.reset')}</Button>
  </div>
</Sheet>

<Sheet
  name="stats"
  title={t('stats.title')}
  titleId="stats-title"
  closeLabel={t('stats.closeSr')}
>
  <p class="at-caption" data-stats-empty hidden>{t('stats.empty')}</p>
  <dl class="at-figs">
    <div><dt>{t('stats.today')}</dt><dd data-stats-today></dd></div>
    <div><dt>{t('stats.week')}</dt><dd data-stats-week></dd></div>
    <div><dt>{t('stats.streakLabel')}</dt><dd data-stats-streak></dd></div>
    <div><dt>{t('stats.total')}</dt><dd data-stats-total></dd></div>
  </dl>
  <section class="at-heat-sec" aria-labelledby="st-heat">
    <div class="at-field-top">
      <h3 class="at-kicker" id="st-heat">{t('stats.heat.title')}</h3><span
        class="at-caption">{t('stats.heat.sub')}</span>
    </div>
    <div class="at-heat" role="img" data-stats-heatmap>
      <div class="at-heat-lock" data-stats-locked>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          ><rect x="5" y="11" width="14" height="10" rx="2"></rect><path
            d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg
        >
        {t('stats.heatmap.locked')}
      </div>
    </div>
    <div class="at-heat-legend" aria-hidden="true">
      <span>{t('stats.heat.less')}</span><i></i><i></i><i></i><i></i><i
      ></i><span>{t('stats.heat.more')}</span>
    </div>
  </section>
  <div class="at-stats-foot">
    <button
      class="at-button at-export"
      type="button"
      data-stats-export
      aria-describedby="st-csv-note"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg
      >
      {t('stats.export')}
      <span class="at-tag" data-export-pro>{t('pro.badge')}</span>
    </button>
    <p class="at-caption" id="st-csv-note">
      {t('stats.export.note')}
      <a href="/pro">{t('pro.see')}</a>
    </p>
  </div>
</Sheet>

<Dialog
  name="shortcuts"
  title={t('tool.shortcuts.title')}
  titleId="shortcuts-title"
  closeLabel={close}
  size="lg"
>
  <p class="at-keys-note" role="note">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
      ><rect x="2.5" y="6" width="19" height="12" rx="2.5"></rect><path
        d="M6.5 10h1M10.5 10h1M14.5 10h1M17.5 10h.5M7.5 14h9"></path></svg
    >
    <span>{t('tool.shortcuts.phoneNote')}</span>
  </p>
  <dl class="at-keys">
    {
      shortcuts.map(([k1, k2, label]) => (
        <div>
          <dt>
            <kbd class="at-kbd">{k1}</kbd>
            {k2 && (
              <>
                <span aria-hidden="true">–</span>
                <kbd class="at-kbd">{k2}</kbd>
              </>
            )}
          </dt>
          <dd>{label}</dd>
        </div>
      ))
    }
  </dl>
  <p class="at-caption at-keys-foot">
    <span class="at-phone-hide">{t('tool.shortcuts.foot')}</span><span
      class="at-phone-only">{t('tool.shortcuts.footPhone')}</span>
  </p>
</Dialog>

<Sheet
  name="pro"
  title={t('pro.title')}
  titleId="pro-sheet-title"
  closeLabel={close}
>
  <p>{t('pro.card')}</p>
  <Fragment slot="footer">
    <Button variant="primary" href="/pro" glyph={false}>{t('pro.cta')}</Button>
    <a class="at-textlink" href="/pro/activate">{t('pro.activate')}</a>
  </Fragment>
</Sheet>

<dialog class="at-ambient" data-ambient aria-labelledby="ambient-title">
  <h2 class="sr-only" id="ambient-title" data-ambient-title>
    {t('ambient.mode.clock')}
  </h2>
  <div class="at-ambient-stage" data-ambient-stage>
    <div class="at-ambient-content" data-ambient-content></div>
  </div>
  <div class="at-ambient-bar" data-ambient-controls>
    <button class="at-button at-button-sm" type="button" data-ambient-next
      >{t('ambient.next')}</button
    >
    <button class="at-button at-button-sm" type="button" data-ambient-fullscreen
      >{t('tool.header.fullscreen')}</button
    >
    <button class="at-button at-button-sm" type="button" data-ambient-exit
      >{t('ambient.exit')}</button
    >
  </div>
</dialog>
