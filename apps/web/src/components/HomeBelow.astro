---
import { getCollection } from 'astro:content';
import StatusPill from './shell/StatusPill.astro';
import { createT, t } from '../i18n/load';
import { LOCALE_META, type TLocale } from '../i18n/locales';
import matrix from '../data/support-matrix.json';
import { CONTENT_KINDS, contentIndex, pagePath, type TContentKind } from '../lib/content-i18n';
import type { ILocaleHomeCopy } from '../content/locale-home/types';

interface Props {
  locale?: TLocale;
  copy?: ILocaleHomeCopy | undefined;
}
const { locale = 'en', copy } = Astro.props;

type TLock = 'idle' | 'requesting' | 'held' | 'lost' | 'denied' | 'unsupported' | 'fallback';

const STATES: Array<[TLock, string]> = [
  ['idle', 'Nothing requested yet. Pick a duration to start.'],
  ['requesting', 'The request is in flight; the browser has not answered.'],
  ['held', 'The browser confirmed the lock. Only now does the timer run.'],
  ['lost', 'The tab was hidden, so the browser took the lock back. AwakeTab asks again when you return.'],
  ['denied', 'The browser refused the request, for example Safari before your first tap. The panel names the cause and the fix.'],
  ['unsupported', 'No Screen Wake Lock API here; a fallback is offered instead.'],
  ['fallback', 'A silent one-frame video is holding the display. It needs this tab visible and uses a little more battery.'],
];

// Anchor text is the target page's h1 (docs/06 §10); a link whose page is gone (B11 merges) drops out.
const h1s = new Map<string, string>();
const counts: Record<TContentKind, number> = { for: 0, on: 0, vs: 0, guides: 0, learn: 0 };
for (const kind of CONTENT_KINDS) {
  for (const entry of await getCollection(kind)) {
    if (entry.data.locale !== 'en') continue;
    h1s.set(`/${kind}/${entry.id.replace(/^en\//u, '')}`, entry.data.h1);
    counts[kind] += 1;
  }
}
const links = (hrefs: string[]): Array<{ href: string; label: string }> =>
  hrefs.flatMap((href) => {
    const label = h1s.get(href);
    return label ? [{ href, label }] : [];
  });
const scenarios = links(['/for/cooking', '/for/presentations', '/for/downloads', '/for/dashboards', '/for/night-clock', '/for/video-calls']);
const devices = links(['/on/iphone-safari', '/on/android-chrome', '/on/windows-11', '/on/macos', '/on/chromebook', '/on/firefox']);
const comparisons = links(['/vs/caffeine', '/vs/powertoys-awake', '/vs/nosleep-page', '/vs/mouse-jigglers']);
const fixes = links([
  '/guides/windows-11-screen-turns-off-after-1-minute',
  '/guides/iphone-auto-lock-never-greyed-out',
  '/guides/mac-prevent-sleep-lid-closed',
]);
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen', 'twenty'];
const word = (n: number): string => WORDS[n] ?? String(n);
const cap = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);

const rows = [
  ...matrix.browsers.map((b) => ({ ...b, platforms: b.platforms.join(', ') })),
  ...matrix.contexts.map((c) => ({ ...c, platforms: '' })),
];
const lastVerified = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(
  new Date(`${matrix.lastUpdated}T00:00:00Z`),
);
const FAQ: Array<[string, string]> = [
  ['Does it still work if I switch tabs or minimise the window?', `No. The browser releases the lock when the document is hidden. AwakeTab pauses and asks again when the tab is visible. For a display behind other windows, use the extension or the ${t('tool.header.pip').toLowerCase()}.`],
  ['Will it keep my laptop awake with the lid closed?', 'No, and neither will any other web page. Lid-close behaviour is an OS decision. Change it in power settings, attach an external display, or use a native tool.'],
  ['Does it keep Teams or Slack showing me as available?', 'No. Presence follows keyboard and mouse idle time, not a lit display. AwakeTab never sends synthetic input.'],
  ['Does it stop the whole computer from sleeping, or only the screen?', 'The screen is the guarantee. Idle system sleep is a separate policy the page cannot control. For a machine awake with the display off, use a native utility.'],
  ['Why does my iPhone lock the screen anyway?', 'Low Power Mode forces a 30-second Auto-Lock. Turn it off in Settings → Battery. Safari needs iOS 16.4; a Home Screen app needs iOS 18.4. Below those, AwakeTab offers the video fallback.'],
  ['What is the video fallback, and when does it run?', `A silent one-frame loop so the browser treats media as playing. It runs only when there is no Screen Wake Lock API, and only after you tap. The pill says "${t('tool.pill.fallback')}".`],
  ['How much battery does it use, and can I leave it running overnight?', `The lock costs almost nothing; the lit screen drains the battery. Plug in, dim the display, and consider night clock mode on OLED. In Chrome and Edge, "${t('settings.battery.autoStop')}" ends the session before the battery runs out.`],
  ['Is it free, and what happens to my data?', 'Free, no sign-up. Settings, session and stats stay in this browser, with no cookies and no fingerprinting. The optional first-party beacon sends no identifiers and can be turned off. No ads on the awake screen, now or later.'],
];
const ARROW = 'M5 12h13M13 6l6 6-6 6';

// Locale homes (HomeBelow board): only the sections this locale has translated copy for, never English filler.
const tl = createT(locale);
const sentence = (text: string): [string, string] => {
  const m = /^(.+?[.。।!?！？])\s*([\s\S]*)$/u.exec(text);
  return m ? [m[1] ?? text, m[2] ?? ''] : [text, ''];
};
const index = copy ? await contentIndex() : [];
const localGroups = CONTENT_KINDS.map((kind) => ({
  kind,
  title: tl(`page.hub.${kind}.h1`),
  links: index
    .filter((page) => page.kind === kind && page.locale === locale)
    .map((page) => ({ href: pagePath(kind, page.enSlug, locale), label: page.h1 })),
})).filter((group) => group.links.length > 0);
const localVerified = new Intl.DateTimeFormat(LOCALE_META[locale].htmlLang, { dateStyle: 'long', timeZone: 'UTC', numberingSystem: 'latn' }).format(
  new Date(`${matrix.lastUpdated}T00:00:00Z`),
);
const DOT = 'M6 1.5a4.5 4.5 0 1 1 0 9a4.5 4.5 0 1 1 0-9z';
const RINGDOT = 'M6 3.4a2.6 2.6 0 1 1 0 5.2a2.6 2.6 0 1 1 0-5.2zM6 .6a5.4 5.4 0 1 1 0 10.8a5.4 5.4 0 1 1 0-10.8zm0 1.4a4 4 0 1 0 0 8a4 4 0 1 0 0-8z';
---

{copy ? (
<div class="at-hb">
  <div class="at-hb-band">
    <span class="at-hb-line" aria-hidden="true"></span>
    <a class="at-hb-jump" href="#home-what">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
      {tl('page.home.how.title')} · {tl('page.home.limits.title')}
    </a>
  </div>
  <div class="at-prose">
    <section id="home-what" class="at-hb-sec" aria-labelledby="h-what">
      <h2 id="h-what">{tl('page.home.what.title')}</h2>
      <div class="at-hb-stack at-hb-measure">
        {copy.whatItDoes.map((text) => <p>{text}</p>)}
      </div>
    </section>

    <section id="home-how" class="at-hb-sec" aria-labelledby="h-how">
      <h2 id="h-how">{tl('page.home.how.title')}</h2>
      <div class="at-hb-how">
        <ol class="at-hb-steps">
          {copy.howItWorks.map((text, i) => (
            <li>
              <span class="at-hb-num" aria-hidden="true">{i + 1}</span>
              <span class="at-hb-step">
                <strong>{sentence(text)[0]}</strong>
                <span>{sentence(text)[1]}</span>
              </span>
            </li>
          ))}
        </ol>
        <ul class="at-hb-states">
          {STATES.map(([state]) => (
            <li>
              <StatusPill as="span" size="S" state={state} label={tl(`tool.pill.${state}`)} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="home-limits" class="at-hb-sec" aria-labelledby="h-limits">
      <h2 id="h-limits">{tl('page.home.limits.title')}</h2>
      <ul class="at-hb-limits">
        {copy.honestLimits.map((text) => (
          <li>
            <strong>{sentence(text)[0]}</strong>{' '}
            <span>{sentence(text)[1]}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="home-guides" class="at-hb-sec" aria-labelledby="h-guides">
      <h2 id="h-guides">{tl('content.related')}</h2>
      <div class="at-hb-stack">
        <div class="at-hb-pair">
          {localGroups.map((group) => (
            <div class="at-hb-col">
              <h3>{group.title}</h3>
              <ul class="at-hb-rows">
                {group.links.map((l) => <li><a href={l.href}><span>{l.label}</span><svg class="at-hb-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg></a></li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="at-hb-card">
          <div class="at-hb-who">
            <span class="at-hb-avatar" aria-hidden="true">SB</span>
            <span>
              <span class="at-hb-name">Soubhik Biswas</span>
              <span class="at-hb-small">{tl('content.author.role')} {tl('content.verified', { date: localVerified })}.</span>
            </span>
          </div>
          <a class="at-hb-link" href="/about" hreflang="en">{tl('content.author.about')}</a>
        </div>
      </div>
    </section>
  </div>
</div>
) : (
<div class="at-hb">
  <div class="at-hb-band">
    <span class="at-hb-line" aria-hidden="true"></span>
    <a class="at-hb-jump" href="#home-what">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
      How it works, limits and support
    </a>
  </div>
  <div class="at-prose">
    <section id="home-what" class="at-hb-sec" aria-labelledby="h-what">
      <h2 id="h-what">What AwakeTab does</h2>
      <div class="at-hb-stack at-hb-measure">
        <p class="at-hb-lead">
          AwakeTab uses the browser's Screen Wake Lock API while this tab is visible, and its status only says the screen
          is awake after the browser confirms the lock.
        </p>
        <p>
          Pick a duration, {t('tool.preset.p15')} to {t('tool.preset.p240')}, {t('tool.preset.custom')} up to seven days,
          or {t('tool.preset.until')} a clock time, and the display stops dimming and sleeping (a work idle-lock policy can
          still lock it). The pill reads <strong>{t('tool.pill.held')}</strong> only while the browser is actually holding
          the lock. Hide this tab and the browser takes the lock back, so the pill switches to
          <strong>{t('tool.pill.lost')}</strong> and the timer stops until you come back.
        </p>
        <p>
          No account, no download, no extension: the whole tool is this page. Settings, the current session and your stats
          stay in this browser, and nothing is sent unless you leave the optional usage beacon on. It works offline after
          the first visit, and <strong>{t('pwa.install')}</strong> in the header puts it on a home screen or dock.
        </p>
      </div>
    </section>

    <section id="home-how" class="at-hb-sec" aria-labelledby="h-how">
      <h2 id="h-how">How it works</h2>
      <div class="at-hb-how">
        <ol class="at-hb-steps">
          <li>
            <span class="at-hb-num" aria-hidden="true">1</span>
            <span class="at-hb-step">
              <strong>You pick a duration.</strong>
              <span>A preset, a custom length or a clock time starts a session. Each choice is one keypress:</span>
              <span class="at-hb-keys">
                <span><kbd class="at-kbd">1</kbd>–<kbd class="at-kbd">6</kbd> presets</span>
                <span><kbd class="at-kbd">0</kbd> no end time</span>
                <span><kbd class="at-kbd">U</kbd> clock time</span>
                <span><kbd class="at-kbd">Space</kbd> start or stop</span>
              </span>
            </span>
          </li>
          <li>
            <span class="at-hb-num" aria-hidden="true">2</span>
            <span class="at-hb-step">
              <strong>The browser is asked for a screen wake lock.</strong>
              <span>
                The same Screen Wake Lock API a video player uses. The browser can accept, refuse, or take the lock back
                later; all three answers show as they happen.
              </span>
            </span>
          </li>
          <li>
            <span class="at-hb-num" aria-hidden="true">3</span>
            <span class="at-hb-step">
              <strong>The timer follows the lock, not the clock.</strong>
              <span>
                The countdown runs only while the lock is held, on system time, so a suspended laptop comes back with an
                honest number. When time is up you get a chime and the choice to extend or stop.
              </span>
            </span>
          </li>
        </ol>
        <div class="at-hb-stack">
          <p class="at-hb-ink">A lock has exactly seven states, and the pill names the one you are in.</p>
          <dl class="at-hb-states">
            {
              STATES.map(([state, meaning]) => (
                <div>
                  <dt>
                    <StatusPill as="span" size="S" state={state} label={t(`tool.pill.${state}`)} />
                  </dt>
                  <dd>{meaning}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section id="home-limits" class="at-hb-sec" aria-labelledby="h-limits">
      <h2 id="h-limits">Honest limits</h2>
      <ul class="at-hb-limits">
        <li>
          <strong>A hidden tab cannot hold a wake lock.</strong>
          <span>
            Switching apps, minimising or changing tabs pauses the session. That is a platform rule. For a display awake
            behind other windows, use the <a href="/extension">AwakeTab extension for Chrome and Edge</a>.
          </span>
        </li>
        <li>
          <strong>Closing the lid still puts the machine to sleep.</strong>
          <span>No web page or extension can change that. It takes an OS setting, an external display or a native tool.</span>
        </li>
        <li>
          <strong>Low Power Mode shortens Auto-Lock.</strong>
          <span>
            iPhone Low Power Mode forces a 30-second Auto-Lock. Separately, Firefox refuses a wake lock at 5% battery or
            less while not charging; the pill then reads <strong>{t('tool.pill.denied')}</strong> and names the cause.
          </span>
        </li>
        <li>
          <strong>It does not touch your chat status.</strong>
          <span>
            Teams, Slack and Zoom presence follows keyboard and mouse idle time, not the display. AwakeTab never simulates
            input to fake it.
          </span>
        </li>
        <li>
          <strong>Display sleep is not system sleep.</strong>
          <span>A wake lock holds the screen, not the whole computer. For a machine awake with the screen off, use a native utility.</span>
        </li>
        <li>
          <strong>Other software keeps its own rules.</strong>
          <span>
            A bank logout, a proctoring app, a monitor that sleeps on lost signal or a corporate lock-screen policy are
            outside a wake lock's reach.
          </span>
        </li>
      </ul>
    </section>

    <section id="home-support" class="at-hb-sec" aria-labelledby="h-support">
      <h2 id="h-support">Browser and device support</h2>
      <div class="at-hb-stack">
        <p class="at-hb-measure">
          Native support means the browser implements the Screen Wake Lock API. Where it is missing, a silent one-frame
          video loop is offered after one tap.
        </p>
        <div class="at-hb-table" tabindex="0" role="region" aria-label="Browser support table">
          <table>
            <caption class="sr-only">Screen Wake Lock API support by browser</caption>
            <thead>
              <tr>
                <th scope="col"><span class="at-hb-wide">Browser or context</span><span class="at-hb-narrow">Browser</span></th>
                <th scope="col">From</th>
                <th scope="col">Mechanism</th>
                <th scope="col" class="at-hb-wide">What to expect</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr>
                    <th scope="row">
                      <span class="at-hb-cell">
                        <span>{row.name}</span>
                        {row.platforms && <span class="at-hb-plat at-hb-wide">{row.platforms}</span>}
                      </span>
                    </th>
                    <td class="at-hb-num-cell">{row.minimumVersion ?? 'Any'}</td>
                    <td>
                      <span class="at-hb-mech">
                        <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d={row.mechanism === 'fallback' ? RINGDOT : DOT} /></svg>
                        <span class="at-hb-wide">{row.mechanism === 'fallback' ? 'Video fallback' : 'Native wake lock'}</span>
                        <span class="at-hb-narrow">{row.mechanism === 'fallback' ? 'Fallback' : 'Native'}</span>
                      </span>
                    </td>
                    <td class="at-hb-wide">{row.notes}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="at-hb-verified">
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.7 2.7L16.5 9.5"></path></svg>
            Sources checked {lastVerified}
          </span>
          <a class="at-hb-link" href="/learn/browser-support-matrix">Per-version detail in the learn hub</a>
        </div>
        <p class="at-hb-small at-hb-measure">
          Below these versions AwakeTab shows <strong>{t('tool.pill.unsupported')}</strong> and offers the video fallback.
        </p>
      </div>
    </section>

    <section id="home-guides" class="at-hb-sec" aria-labelledby="h-guides">
      <h2 id="h-guides">Pick the guide for what you are doing</h2>
      <div class="at-hb-pair">
        <div class="at-hb-col">
          <p>
            Cooking, a talk, a long download, a wall dashboard: each has a sensible duration and its own honest limit, so
            each gets a page with the tool already set up.
          </p>
          <ul class="at-hb-rows">
            {scenarios.map((l) => <li><a href={l.href}><span>{l.label}</span><svg class="at-hb-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg></a></li>)}
          </ul>
          <a class="at-hb-link at-hb-strong" href="/for">All {word(counts.for)} situations</a>
        </div>
        <div class="at-hb-col">
          <h3>Your device, specifically</h3>
          <p>
            Wake locks behave differently on an iPhone, a managed Chromebook and a Windows laptop. These pages name the
            supported versions and the settings that still apply.
          </p>
          <ul class="at-hb-rows">
            {devices.map((l) => <li><a href={l.href}><span>{l.label}</span><svg class="at-hb-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg></a></li>)}
          </ul>
          <a class="at-hb-link at-hb-strong" href="/on">{cap(word(counts.on))} browsers and platforms</a>
        </div>
      </div>
    </section>

    <section id="home-alt" class="at-hb-sec" aria-labelledby="h-alt">
      <h2 id="h-alt">When something else is the better tool</h2>
      <div class="at-hb-pair">
        <div class="at-hb-col">
          <p>
            AwakeTab is instant and needs no installation. A native utility beats it when the screen must stay on with the
            browser out of sight. Comparisons use dated facts.
          </p>
          <ul class="at-hb-rows">
            {comparisons.map((l) => <li><a href={l.href}><span>{l.label}</span><svg class="at-hb-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg></a></li>)}
          </ul>
          <a class="at-hb-link at-hb-strong" href="/vs">All {word(counts.vs)} comparisons</a>
        </div>
        <div class="at-hb-col">
          <h3>Or fix the setting itself</h3>
          <p>
            Sometimes the real answer is a system setting. These walkthroughs show where the timeout lives, what to do when
            it is greyed out, and when AwakeTab is faster.
          </p>
          <ul class="at-hb-rows">
            {fixes.map((l) => <li><a href={l.href}><span>{l.label}</span><svg class="at-hb-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg></a></li>)}
          </ul>
          <span class="at-hb-links">
            <a class="at-hb-link at-hb-strong" href="/guides">Troubleshooting guides</a>
            <a class="at-hb-link at-hb-strong" href="/learn">Learn about wake locks</a>
          </span>
        </div>
      </div>
    </section>

    <section id="home-faq" class="at-hb-sec" aria-labelledby="h-faq">
      <h2 id="h-faq">Questions we are asked most</h2>
      <div class="at-hb-faq">
        {
          FAQ.map(([q, a], i) => (
            <details open={i === 0}>
              <summary>
                <span>{q}</span>
                <span class="at-hb-plus" aria-hidden="true">
                  <span>
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </span>
              </summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="home-who" class="at-hb-sec" aria-labelledby="h-who">
      <h2 id="h-who">How AwakeTab is checked</h2>
      <div class="at-hb-measure">
        <div class="at-hb-card">
          <div class="at-hb-who">
            <span class="at-hb-avatar" aria-hidden="true">SB</span>
            <span>
              <span class="at-hb-name">Soubhik Biswas</span>
              <span class="at-hb-small">Builds AwakeTab. Sources checked {lastVerified}.</span>
            </span>
          </div>
          <p>
            Support claims come from browser documentation and automated tests. Real-device results appear in the matrix
            once recorded. When a browser changes, the matrix and the affected pages change with it.
          </p>
          <span class="at-hb-links">
            <a class="at-hb-link" href="/about">About the maker and the test rig</a>
            <a class="at-hb-link" href="/learn/how-we-tested">Testing notes</a>
            <a class="at-hb-link" href="/changelog">Changelog</a>
          </span>
        </div>
      </div>
    </section>
  </div>
</div>
)}

<style>
  .at-hb {
    --at-type-row: 500 1rem/1.5rem var(--at-font);

    border-image: linear-gradient(180deg, var(--at-ground-end) 0, var(--at-ground) 480px) fill 0 / 0 / 0 100vw;
    color: var(--at-ink);
  }

  .at-hb-band {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--at-s-3);
    padding-block-end: var(--at-s-6);
  }

  .at-hb-line {
    inline-size: 1px;
    block-size: var(--at-s-10);
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--at-accent) 45%, transparent));
  }

  .at-hb-jump {
    display: inline-flex;
    align-items: center;
    gap: var(--at-s-2);
    min-block-size: var(--at-h-control);
    padding-inline: var(--at-s-3) var(--at-s-4);
    border: 1px solid var(--at-line);
    border-radius: var(--at-r-pill);
    background: var(--at-surface);
    color: var(--at-ink-2);
    font: var(--at-type-small);
    font-weight: 500;
    text-decoration: none;
    animation: at-float 7s ease-in-out infinite;
  }

  .at-hb-jump svg,
  .at-hb-verified svg {
    inline-size: var(--at-icon-sm);
    block-size: var(--at-icon-sm);
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
