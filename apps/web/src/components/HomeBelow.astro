---
import Button from './shell/Button.astro';
import UseCaseIcon from './icons/UseCaseIcon.astro';
import HomeExtension from './home/HomeExtension.astro';
import HomeLevels from './home/HomeLevels.astro';
import homeCss from '../styles/home.css?url';
import { createT } from '../i18n/load';
import { localePath, type TLocale } from '../i18n/locales';
import { contentIndex, pagePath } from '../lib/content-i18n';

interface Props {
  locale?: TLocale;
}
const { locale = 'en' } = Astro.props;
const t = createT(locale);
const english = locale === 'en';
const enOnly = english ? undefined : 'en';

const USES = [
  { slug: 'cooking', key: 'cooking' },
  { slug: 'reading', key: 'reading' },
  { slug: 'presentations', key: 'presentations' },
  { slug: 'dashboards', key: 'dashboards' },
  { slug: 'video-calls', key: 'videoCalls' },
  { slug: 'downloads', key: 'downloads' },
] as const;

const PRESET_ROUTE: Record<string, string> = {
  p15: '/15m',
  p30: '/30m',
  p45: '/45m',
  p60: '/1h',
  p120: '/2h',
  p240: '/4h',
};
const startHref = (preset: string, mode: string): string => {
  const route = PRESET_ROUTE[preset] ?? localePath(locale, '/');
  return mode === 'standard' ? route : `${route}?mode=${mode}`;
};

const index = await contentIndex();
const useCases = index.filter((page) => page.kind === 'for' && page.locale === 'en');
const cards = USES.flatMap((use) => {
  const page = useCases.find((p) => p.enSlug === use.slug);
  if (!page) return [];
  const translated = !english && index.some((p) => p.kind === 'for' && p.enSlug === use.slug && p.locale === locale);
  const { preset, mode } = page.entry.data;
  return [
    {
      ...use,
      guide: translated ? pagePath('for', use.slug, locale) : `/for/${use.slug}`,
      guideLang: english || translated ? undefined : 'en',
      start: startHref(preset, mode),
      startLang: english || !PRESET_ROUTE[preset] ? undefined : 'en',
      length: t(`tool.preset.${preset.startsWith('p') ? preset : 'p30'}.sr`),
    },
  ];
});
const ARROW = 'M5 12h14M13 6l6 6-6 6';
---

<div class="at-hb">
  <link rel="stylesheet" href={homeCss} />

  <section id="home-uses" class="at-hb-sec" aria-labelledby="h-uses">
    <div class="at-hb-head">
      <div class="at-hb-intro">
        <h2 id="h-uses">{t('page.home.uses.title')}</h2>
        <p>{t('page.home.uses.lead')}</p>
      </div>
      <a class="at-hb-more" href="/for" hreflang={enOnly}>
        <span>{t('page.home.uses.all', { count: useCases.length })}</span>
        <svg class="at-hb-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg>
      </a>
    </div>
    <ul class="at-hb-uses">
      {cards.map((card) => (
        <li class="at-hb-use">
          <span class="at-hb-use-icon"><UseCaseIcon name={card.slug} /></span>
          <h3 id={`h-use-${card.slug}`}><a href={card.guide} hreflang={card.guideLang}>{t(`page.home.uses.${card.key}`)}</a></h3>
          <p>{t(`page.home.uses.${card.key}.body`)}</p>
          <a class="at-hb-use-go" href={card.start} hreflang={card.startLang} aria-describedby={`h-use-${card.slug}`}>
            <span>{t('page.home.uses.start', { length: card.length })}</span>
            <svg class="at-hb-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <HomeExtension locale={locale} />

  <HomeLevels locale={locale} />

  <section id="home-final" class="at-hb-sec at-hb-final" aria-labelledby="h-final">
    <span class="at-hb-dial" aria-hidden="true"></span>
    <h2 id="h-final">{t('page.home.final.title')}</h2>
    <p>{t('page.home.final.body', { held: t('tool.pill.held') })}</p>
    <div class="at-hb-acts">
      <Button variant="primary" href="#content">{t('page.home.final.start')}</Button>
      <Button variant="secondary" size="lg" href="/extension">{t('page.home.final.extension')}</Button>
    </div>
    <a class="at-hb-docs" href="/learn" hreflang={enOnly}>
      <span>{t('page.home.final.docs')}</span>
      <svg class="at-hb-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ARROW} /></svg>
    </a>
  </section>
</div>
