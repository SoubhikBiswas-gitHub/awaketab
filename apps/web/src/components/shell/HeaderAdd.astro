---
import { createT } from '../../i18n/load';
import type { TLocale } from '../../i18n/locales';
import { EXTENSION_LISTED, EXTENSION_STORE_URLS } from '../../lib/extension';
import { menuLink } from '../../lib/header-menu';
import BrandIcon from '../icons/BrandIcon.astro';

interface Props {
  locale: TLocale;
  store?: boolean;
  class?: string;
}

// One add button per browser; CSS picks it, boot.js flags Edge.
const { locale, store = true, class: className } = Astro.props;
const t = createT(locale);
const english = locale !== 'en';
const en = english ? t('header.nav.english') : '';
const stores = store
  ? ([
      ['chrome', EXTENSION_LISTED ? EXTENSION_STORE_URLS.chrome : '/extension', t('header.add.chrome'), 'chrome'],
      ['edge', EXTENSION_LISTED ? EXTENSION_STORE_URLS.edge : '/extension', t('header.add.edge'), 'microsoft-edge'],
    ] as const)
  : [];
const home = await menuLink('on', 'ios-home-screen', locale);
const homeLabel = `${t('header.add.home')}${home.en ? ` ${en}` : ''}`;
---

{
  stores.map(([v, href, label, logo]) => (
    <a
      class:list={['at-button at-button-primary at-button-sm at-hm-add', className]}
      data-v={v}
      href={href}
      hreflang={english && !EXTENSION_LISTED ? 'en' : undefined}
    >
      <BrandIcon name={logo} size={20} class="at-button-glyph" />
      {label}
      {en && !EXTENSION_LISTED && <span class="sr-only"> {en}</span>}
    </a>
  ))
}
<a
  class:list={['at-button at-button-primary at-button-sm at-hm-add', className]}
  data-v="ios"
  href={home.href}
  hreflang={home.en ? 'en' : undefined}
  aria-label={homeLabel}
>
  <BrandIcon name="apple" size={20} />
  <span class="at-hm-add-long">{t('header.add.home')}</span>
  <span class="at-hm-add-short" aria-hidden="true">{t('header.add.homeShort')}</span>
</a>
