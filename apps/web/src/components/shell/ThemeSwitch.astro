---
import { createT } from '../../i18n/load';
import type { TLocale } from '../../i18n/locales';
import Icon from '../icons/Icon.astro';

interface Props {
  locale: TLocale;
}

const { locale } = Astro.props;
const t = createT(locale);
const ICONS = { light: 'sun', dark: 'moon', auto: 'circle-half' } as const;
const themes = [
  ['light', t('settings.theme.light'), t('settings.theme.light')],
  ['dark', t('settings.theme.dark'), t('settings.theme.dark')],
  ['auto', t('header.theme.auto'), t('header.theme.autoTitle')],
] as const;
---

<div class="at-seg at-theme" role="radiogroup" aria-label={t('settings.theme')}>
  <span class="at-seg-ind" aria-hidden="true"></span>
  {
    themes.map(([value, label, title]) => (
      <label class="at-theme-item" data-v={value} title={title}>
        <input class="sr-only" type="radio" name="at-theme" value={value} aria-label={label} checked={value === 'auto'} />
        <Icon name={ICONS[value]} size={20} />
      </label>
    ))
  }
</div>
