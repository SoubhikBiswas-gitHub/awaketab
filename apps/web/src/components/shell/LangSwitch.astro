---
import { createT } from '../../i18n/load';
import { LOCALE_META, LOCALES, localePath, type TLocale } from '../../i18n/locales';
import Icon from '../icons/Icon.astro';
import Drawer from '../ui/Drawer.astro';

interface Props {
  locale: TLocale;
  links?: Partial<Record<TLocale, string>> | undefined;
}

const { locale, links = {} } = Astro.props;
const t = createT(locale);
const here = LOCALE_META[locale];
const pageLang = here.htmlLang;
---

<div class="at-lang" data-lang>
  <button
    class="at-lang-btn"
    type="button"
    id="at-lang-btn"
    aria-expanded="false"
    aria-controls="at-lang-list"
    aria-label={`${t('footer.language')}: ${here.label}`}
  >
    <Icon name="globe" size={16} />
    {here.label}
    <Icon name="caret-down" size={16} class="at-lang-chev" />
  </button>
  <Drawer
    class="at-lang-panel"
    id="at-lang-list"
    title={t('footer.language')}
    titleId="at-lang-h"
    closeLabel={t('footer.language.close')}
    closeAttrs={{ 'data-lang-close': '' }}
  >
    <ul class="at-lang-list" role="list">
      {
        LOCALES.map((code) => {
          const meta = LOCALE_META[code];
          const current = code === locale;
          const note = current ? t('footer.language.current') : meta.reviewed ? '' : t('footer.language.review');
          return (
            <li>
              <a
                class="at-lang-row"
                href={links[code] ?? localePath(code, '/')}
                lang={meta.htmlLang}
                hreflang={meta.hreflang}
                aria-current={current ? 'true' : undefined}
              >
                <svg class="at-lang-mark" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <circle class="at-lang-ring" cx="10" cy="10" r="8" />
                  <circle class="at-lang-dot" cx="10" cy="10" r="4" />
                </svg>
                <span class="at-lang-name">{meta.label}</span>
                <span class="at-lang-note" lang={pageLang}>{note}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </Drawer>
</div>
