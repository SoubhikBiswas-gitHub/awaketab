---
import { createT } from '../../i18n/load';
import type { TLocale } from '../../i18n/locales';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: TLocale;
  links?: Partial<Record<TLocale, string>> | undefined;
}

const { locale, links } = Astro.props;
const t = createT(locale);
---

<footer class="at-site-footer">
  <p class="at-footer-line">{t('footer.honest')}</p>
  <nav class="at-footer-nav" aria-label={t('footer.nav')}>
    <a href="/privacy">{t('footer.privacy')}</a>
    <a href="/terms">{t('footer.terms')}</a>
    <a href="/changelog">{t('footer.changelog')}</a>
    <a href="/about">{t('footer.about')}</a>
    <a href="https://buymeacoffee.com/awaketab" rel="noopener" target="_blank">{t('footer.donate')}</a>
  </nav>
  <LangSwitch locale={locale} links={links} />
</footer>
