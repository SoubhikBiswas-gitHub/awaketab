---
import '../styles/tool.css';
import { createT } from '../i18n/load';
import { localePath, type TLocale } from '../i18n/locales';
import ToolPanel from './ToolPanel.astro';
import SiteHeader from './shell/SiteHeader.astro';
import Icon from './icons/Icon.astro';
import { POLAR_PORTAL_URL } from '../lib/pro-common';
import { toolReady } from '../lib/tool-ready';
import { stripLocale } from '../tool/params';
import { FACE_ORDER } from '../tool/packs/faces/order';

interface Props {
  heading: string;
  kicker?: string | undefined;
  autostart?: '0' | '1' | undefined;
  pip?: boolean;
  preset?: string | undefined;
  mode?: string | undefined;
  locale?: TLocale;
  embed?: boolean;
  until?: string | undefined;
}

const {
  heading,
  kicker,
  autostart,
  pip = false,
  preset,
  mode,
  locale = 'en',
  embed = false,
  until,
} = Astro.props;
const t = createT(locale);
// Autostart routes hold the pill until the browser answers, so it never flips Ready to Screen awake.
const auto = !embed && autostart !== '0' && (stripLocale(Astro.url.pathname) === '/' || !!preset || !!until);
const ready = toolReady(t, preset, !embed && preset === 'custom');
const untilAt = until
  ? new Intl.DateTimeFormat(locale, { hour: 'numeric', minute: '2-digit', timeZone: 'UTC', numberingSystem: 'latn' }).format(
      Date.UTC(2000, 0, 1, Number(until.slice(0, 2)), Number(until.slice(3))),
    )
  : '';
// The embedded card's eyebrow (ContentArticle / GuideGuides boards): the page's suggested length, or cook mode.
const PRESET_LABEL: Record<string, string> = {
  p15: 'p15',
  p30: 'p30',
  p45: 'p45',
  p60: 'p60',
  p120: 'p120',
  p240: 'p240',
  pinf: 'pinf',
};
const cardKicker =
  mode === 'cook'
    ? t('tool.card.cook')
    : t('tool.card.suggested', {
        length: t(`tool.preset.${PRESET_LABEL[preset ?? ''] ?? 'p30'}`),
      });

// Icons (DESIGN.md §11.4: 20 px, stroke 1.8, round caps), drawn as on the canvas boards (Main, Extras).
const ICON = {
  settings: 'M4 7h10M18 7h2M4 17h4M12 17h8',
  grace: 'M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18zM12 7.5V12l3 2',
  lapsed: 'M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18zM12 11v5.5M12 7.6v.3',
  arrow: 'M5 12h14M13 6l6 6-6 6',
} as const;
// The lapse notice's date goes into a <time> the island fills (Sys "prolapsed" boards).
const dated = (key: string) => t(key, { date: '\u0000' }).split('\u0000') as [string, string];
const lapses = [
  ['grace', 'grace', POLAR_PORTAL_URL],
  ['lapsed', 'ended', '/pro'],
] as const;
const lapseFalls = ['lamp', 'message', 'stats', 'ads'] as const;
// The More menu: every secondary tool action with its label, the hook the island already routes, and its key.
const more: Array<[string, string, Record<string, string | boolean>, string, string]> = [
  ['share-network', t('tool.share.title'), { 'data-open-share': true, 'aria-haspopup': 'dialog' }, '', ''],
  ['picture-in-picture', t('tool.header.pip'), { 'data-open-pip': true }, 'P', 'at-phone-hide'],
  ['note-pencil', t('tool.notes.open'), { 'data-open-notes': true, 'aria-haspopup': 'dialog' }, 'N', 'at-desk-hide'],
  ['target', t('tool.intention.open'), { 'data-act': 'intention' }, 'I', 'at-desk-hide'],
  ['chart-bar', t('stats.title'), { 'data-open-stats': true, 'aria-haspopup': 'dialog' }, '', ''],
  ['keyboard', t('tool.header.shortcuts'), { 'data-open-shortcuts': true, 'aria-haspopup': 'dialog' }, '?', ''],
  ['gear-six', t('tool.header.settings'), { 'data-open-settings': true, 'aria-haspopup': 'dialog' }, '', ''],
  ['download-simple', t('tool.header.installApp'), { 'data-install': true, hidden: true }, '', ''],
];
---

{
  !embed && (
    <a class="at-skip" href="#content">
      {t('tool.skip')}
    </a>
  )
}
<div
  id="awaketab-tool"
  class:list={['at-island', embed && 'at-tool-embed', until && 'at-tool-until']}
  data-autostart={autostart}
  data-pip={pip ? '1' : undefined}
  data-preset={preset}
  data-mode={mode}
  data-status="ready"
  data-open=""
  data-auto={auto ? '' : undefined}
  data-inf={!until && !ready.sec ? '' : undefined}
  data-units={!until && ready.sec >= 3600 ? 'h' : undefined}
  data-sec={!until && ready.sec ? ready.sec : undefined}
  data-until={until}
  data-chip={until ? t('tool.chip.untilAt') : undefined}
  data-tmr={t('tool.when.tomorrow')}
  data-sky={['dawn', 'day', 'dusk', 'night'].map((p) => t(`tool.sky.${p}`)).join('|')}
  data-fnames={FACE_ORDER.map((f) => t(`tool.face.${f}`)).join('|')}
  data-manifest={embed ? undefined : localePath(locale, '/manifest.webmanifest')}
>
  {auto && <noscript><style is:inline>{'.at-pillline{visibility:visible!important}'}</style></noscript>}
  {
    embed ? (
      <section class="at-embed-card" aria-label={t('app.name')}>
        <div class="at-tool-embed-bar">
          <span class="at-tag at-pro-badge" data-pro-badge hidden>{t('pro.badge')}</span>
          <button class="at-icon-button" type="button" data-open-settings aria-label={t('tool.header.settings')} aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d={ICON.settings} /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" />
            </svg>
          </button>
        </div>
        <ToolPanel locale={locale} embed kicker={cardKicker} ready={ready} />
      </section>
    ) : (
      <>
        <div class="at-halo" aria-hidden="true">
          <div />
        </div>
        <span class="at-ig-bead" aria-hidden="true" />
        <section class="at-lapse" data-lapse hidden aria-label={t('tool.notifications')}>
          {lapses.map(([state, k, href]) => {
            const [before, after] = dated(`pro.lapse.${k}.body`);
            return (
              <div class="at-lapse-card" role="status" data-lapse-for={state}>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ICON[state]} />
                </svg>
                <div class="at-lapse-text">
                  <h2>{t(`pro.lapse.${k}.title`)}</h2>
                  <p>
                    {before}
                    <time data-lapse-date />
                    {after}
                  </p>
                  {state === 'lapsed' && (
                    <ul>
                      {lapseFalls.map((f) => (
                        <li>
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={ICON.arrow} />
                          </svg>
                          {t(`pro.lapse.ended.${f}`)}
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="at-lapse-keep">{t(`pro.lapse.${k}.keep`)}</p>
                </div>
                <div class="at-lapse-acts">
                  <a class="at-button at-button-sm" href={href}>
                    {t(`pro.lapse.${k}.action`)}
                  </a>
                  <button class="at-button at-button-sm at-button-quiet" type="button" data-lapse-dismiss>
                    {t('pro.lapse.later')}
                  </button>
                  <button class="at-icon-button" type="button" data-lapse-dismiss aria-label={t('pro.lapse.dismiss')}>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </button>
                </div>
              </div>
            );
          })}
        </section>
        <SiteHeader locale={locale} tool>
          <p class="at-hclock">
            <span class="sr-only">{t('tool.header.clock')}</span>
            <time class="at-now" data-t="now" />
            <time class="at-date" data-t="date" />
          </p>
          <span class="at-tag at-pro-badge" data-pro-badge hidden>
            {t('pro.badge')}
          </span>
          <button
            class="at-icon-button at-snd-btn"
            type="button"
            data-act="customize"
            data-tab="sound"
            aria-label={t('tool.header.sound')}
            title={t('tool.header.sound')}
            aria-haspopup="dialog"
            aria-keyshortcuts="S"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M5 10v4" />
              <path d="M9.5 6v12" />
              <path d="M14 8.5v7" />
              <path d="M18.5 11v2" />
            </svg>
          </button>
          <button class="at-hbtn at-cz-btn" type="button" data-act="customize" aria-haspopup="dialog" aria-label={t('tool.header.customize')}>
            <Icon name="sparkle" />
            <span class="at-hbtn-t">{t('tool.header.customize')}</span>
          </button>
          <button
            class="at-icon-button at-more-btn"
            type="button"
            popovertarget="at-more"
            data-more-open
            style="anchor-name:--at-more, --at-hm-menu"
            aria-label={t('tool.header.more')}
            title={t('tool.header.more')}
          >
            <Icon name="dots-three-circle" tone="ink" size={24} />
          </button>
          <div class="at-more" id="at-more" popover data-more style="position-anchor:--at-more">
            <ul class="at-more-list" role="list">
              {more.map(([icon, label, attrs, kbd, cls]) => (
                <li class={cls}>
                  <button class="at-more-row" type="button" popovertarget="at-more" popovertargetaction="hide" {...attrs}>
                    <Icon name={icon} />
                    <span class="at-more-t">{label}</span>
                    {kbd && <kbd class="at-kbd at-kbd-hint" aria-hidden="true">{kbd}</kbd>}
                  </button>
                </li>
              ))}
              <li class="at-more-sep" role="separator" />
              <li>
                <button class="at-more-row" type="button" popovertarget="at-hm-menu">
                  <Icon name="compass" />
                  <span class="at-more-t">{t('tool.header.site')}</span>
                </button>
              </li>
            </ul>
          </div>
        </SiteHeader>
        <main class="at-main">
          <slot name="top" />
          <div class="at-first">
            <ToolPanel locale={locale} until={until} untilAt={untilAt} ready={ready} />
          </div>
          <div class="at-below">
            <div class="at-below-head">
              {kicker && <span class="at-kicker">{kicker}</span>}
              <h1 class="at-below-h1">{heading}</h1>
            </div>
            <slot />
          </div>
        </main>
      </>
    )
  }
</div>
<script src="../tool/main.ts"></script>
