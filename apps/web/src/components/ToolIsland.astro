---
import '../styles/tool.css';
import { createT } from '../i18n/load';
import { localePath, type TLocale } from '../i18n/locales';
import ToolPanel from './ToolPanel.astro';
import SiteHeader from './shell/SiteHeader.astro';
import { POLAR_PORTAL_URL } from '../lib/pro-common';

interface Props {
  heading: string;
  kicker?: string | undefined;
  autostart?: '0' | '1' | undefined;
  pip?: boolean;
  preset?: string | undefined;
  mode?: string | undefined;
  locale?: TLocale;
  embed?: boolean;
  until?: string | undefined;
}

const {
  heading,
  kicker,
  autostart,
  pip = false,
  preset,
  mode,
  locale = 'en',
  embed = false,
  until,
} = Astro.props;
const t = createT(locale);
// Routes that start on load (tool/params.ts isToolAutostartRoute) hide the pill and note until the outcome is known,
// so Ready → Starting… → Screen awake never moves the layout on first paint (CLS 0).
const auto = !embed && autostart !== '0' && (Astro.url.pathname === '/' || !!preset || !!until);
// The embedded card's eyebrow (ContentArticle / GuideGuides boards): the page's suggested length, or cook mode.
const PRESET_LABEL: Record<string, string> = {
  p15: 'p15',
  p30: 'p30',
  p45: 'p45',
  p60: 'p60',
  p120: 'p120',
  p240: 'p240',
  pinf: 'pinf',
};
const cardKicker =
  mode === 'cook'
    ? t('tool.card.cook')
    : t('tool.card.suggested', {
        length: t(`tool.preset.${PRESET_LABEL[preset ?? ''] ?? 'p30'}`),
      });

// Icons (DESIGN.md §11.4: 20 px, stroke 1.8, round caps), drawn as on the canvas boards (Main, Extras).
const ICON = {
  stats: 'M5 20V11M12 20V5M19 20v-7',
  settings: 'M4 7h10M18 7h2M4 17h4M12 17h8',
  share: 'M12 3.5v11M8 7.5l4-4 4 4M5.5 12v6.5a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V12',
  install: 'M12 4v11M7.5 10.5L12 15l4.5-4.5M5 19.5h14',
  grace: 'M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18zM12 7.5V12l3 2',
  lapsed: 'M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18zM12 11v5.5M12 7.6v.3',
  arrow: 'M5 12h14M13 6l6 6-6 6',
} as const;
// The lapse notice's date goes into a <time> the island fills (Sys "prolapsed" boards).
const dated = (key: string) => t(key, { date: '\u0000' }).split('\u0000') as [string, string];
const lapses = [
  ['grace', 'grace', POLAR_PORTAL_URL],
  ['lapsed', 'ended', '/pro'],
] as const;
const lapseFalls = ['lamp', 'message', 'stats', 'ads'] as const;
---

{
  !embed && (
    <a class="at-skip" href="#content">
      {t('tool.skip')}
    </a>
  )
}
<div
  id="awaketab-tool"
  class:list={['at-island', embed && 'at-tool-embed', until && 'at-tool-until']}
  data-autostart={autostart}
  data-pip={pip ? '1' : undefined}
  data-preset={preset}
  data-mode={mode}
  data-status="ready"
  data-open=""
  data-auto={auto ? '' : undefined}
  data-manifest={embed ? undefined : localePath(locale, '/manifest.webmanifest')}
>
  {
    auto && (
      <noscript>
        <style is:inline>{'.at-island :is(.at-pillline, .at-noterow, .at-untilchips, .at-kick, .at-meta) { visibility: visible !important; }'}</style>
      </noscript>
    )
  }
  {
    embed ? (
      <section class="at-embed-card" aria-label={t('app.name')}>
        <div class="at-tool-embed-bar">
          <span class="at-tag at-pro-badge" data-pro-badge hidden>{t('pro.badge')}</span>
          <button class="at-icon-button" type="button" data-open-settings aria-label={t('tool.header.settings')} aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d={ICON.settings} /><circle cx="16" cy="7" r="2" /><circle cx="10" cy="17" r="2" />
            </svg>
          </button>
        </div>
        <ToolPanel locale={locale} embed kicker={cardKicker} />
      </section>
    ) : (
      <>
        <div class="at-halo" aria-hidden="true">
          <div />
        </div>
        <span class="at-ig-bead" aria-hidden="true" />
        <section class="at-lapse" data-lapse hidden aria-label={t('tool.notifications')}>
          {lapses.map(([state, k, href]) => {
            const [before, after] = dated(`pro.lapse.${k}.body`);
            return (
              <div class="at-lapse-card" role="status" data-lapse-for={state}>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ICON[state]} />
                </svg>
                <div class="at-lapse-text">
                  <h2>{t(`pro.lapse.${k}.title`)}</h2>
                  <p>
                    {before}
                    <time data-lapse-date />
                    {after}
                  </p>
                  {state === 'lapsed' && (
                    <ul>
                      {lapseFalls.map((f) => (
                        <li>
                          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d={ICON.arrow} />
                          </svg>
                          {t(`pro.lapse.ended.${f}`)}
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="at-lapse-keep">{t(`pro.lapse.${k}.keep`)}</p>
                </div>
                <div class="at-lapse-acts">
                  <a class="at-button at-button-sm" href={href}>
                    {t(`pro.lapse.${k}.action`)}
                  </a>
                  <button class="at-button at-button-sm at-button-quiet" type="button" data-lapse-dismiss>
                    {t('pro.lapse.later')}
                  </button>
                  <button class="at-icon-button" type="button" data-lapse-dismiss aria-label={t('pro.lapse.dismiss')}>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </button>
                </div>
              </div>
            );
          })}
        </section>
        <SiteHeader locale={locale} tool>
          <p class="at-dateline at-dateline-hdr" aria-hidden="true">
            <time class="at-date" data-t="date" />
            <time class="at-now" data-t="now" />
          </p>
          <span class="at-tag at-pro-badge" data-pro-badge hidden>
            {t('pro.badge')}
          </span>
          <span class="at-install-slot">
          <button
            class="at-icon-button at-phone-only"
            type="button"
            data-install
            hidden
            aria-label={t('tool.header.install')}
            title={t('tool.header.install')}
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={ICON.install} />
            </svg>
          </button>
          <button
            class="at-install-btn at-phone-hide"
            type="button"
            data-install
            hidden
            aria-label={t('tool.header.install')}
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={ICON.install} />
            </svg>
            {t('pwa.install.short')}
          </button>
          </span>
          <button
            class="at-icon-button at-phone-hide"
            type="button"
            data-open-share
            aria-label={t('tool.header.share')}
            title={t('tool.header.share')}
            aria-haspopup="dialog"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={ICON.share} />
            </svg>
          </button>
          <button
            class="at-icon-button at-phone-hide"
            type="button"
            data-open-shortcuts
            aria-label={t('tool.header.shortcuts')}
            title={t('tool.header.shortcuts')}
            aria-haspopup="dialog"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <>
                <rect x="2.5" y="6" width="19" height="12" rx="2.5" />
                <path d="M6.5 10h1M10.5 10h1M14.5 10h1M17.5 10h.5M7.5 14h9" />
              </>
            </svg>
          </button>
          <button
            class="at-icon-button at-phone-hide"
            type="button"
            data-open-pip
            aria-label={t('tool.header.pip')}
            title={t('tool.header.pip')}
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <>
                <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                <rect x="12" y="11" width="6.5" height="5" rx="1.5" />
              </>
            </svg>
          </button>
          <button
            class="at-icon-button at-phone-hide"
            type="button"
            data-open-stats
            aria-label={t('stats.title')}
            aria-haspopup="dialog"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d={ICON.stats} />
            </svg>
          </button>
          <button
            class="at-icon-button"
            type="button"
            data-open-settings
            aria-label={t('tool.header.settings')}
            aria-haspopup="dialog"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <>
                <path d={ICON.settings} />
                <circle cx="16" cy="7" r="2" />
                <circle cx="10" cy="17" r="2" />
              </>
            </svg>
          </button>
        </SiteHeader>
        <main class="at-main">
          <slot name="top" />
          <div class="at-first">
            <p class="at-dateline">
              <time class="at-date" data-t="date" />
              <time class="at-now" data-t="now" />
            </p>
            <ToolPanel locale={locale} until={until} />
          </div>
          <div class="at-below">
            <div class="at-below-head">
              {kicker && <span class="at-kicker">{kicker}</span>}
              <h1 class="at-below-h1">{heading}</h1>
            </div>
            <slot />
          </div>
        </main>
      </>
    )
  }
</div>
<script src="../tool/main.ts"></script>
