---
// /learn/how-we-tested research table (E12-T06), generated from docs/metrics/device-matrix.json. Until the owner
// records the manual run, the matrix is `pending`: the page says "Results pending" and claims nothing.
// Build-time markup only (docs/03 ADR-013). Clear Night (redesign B5): the board's matrix card (r16, kicker header,
// tone tags for verdicts, never colour alone: the verdict word is the tag text) and the honest-limit note shape.
import '../styles/device-matrix.css';
import raw from '../../../../docs/metrics/device-matrix.json';
import { parseDeviceMatrix, type TDeviceVerdict } from '../lib/device-matrix';
import support from '../data/support-matrix.json';
import { t } from '../i18n/load';

const matrix = parseDeviceMatrix(raw);
const names = new Map([...support.browsers, ...support.contexts].map((row) => [row.id, row.name]));
const verdictTone: Record<TDeviceVerdict, string | null> = {
  pending: null,
  pass: 'var(--at-accent)',
  partial: 'var(--at-warn)',
  fail: 'var(--at-bad)',
};
const updated = matrix.updatedAt
  ? new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${matrix.updatedAt}T00:00:00Z`))
  : null;
---

<section class="at-dm" data-device-matrix data-status={matrix.status}>
  <h2 id="device-matrix">{t('research.title')}</h2>
  {
    matrix.status === 'pending' ? (
      <div role="note" class="at-note" data-results-pending>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.01" /></svg>
        <div>
          <p class="at-kicker">{t('research.pending')}</p>
          <p>{t('research.pending.body')}</p>
        </div>
      </div>
    ) : (
      updated && <p class="at-dm-verified">{t('content.verified', { date: updated })}</p>
    )
  }
  <ol>
    {matrix.method.map((step) => <li>{step}</li>)}
  </ol>
  <div class="at-dm-scroll" tabindex="0" role="region" aria-labelledby="device-matrix">
    <table>
      <thead>
        <tr>
          <th scope="col">{t('research.col.device')}</th>
          <th scope="col">{t('research.col.browser')}</th>
          <th scope="col">{t('research.col.case')}</th>
          <th scope="col">{t('research.col.expected')}</th>
          <th scope="col">{t('research.col.observed')}</th>
          <th scope="col">{t('research.col.date')}</th>
        </tr>
      </thead>
      <tbody>
        {
          matrix.rows.map((row) => (
            <tr data-row={row.id}>
              <td>
                {row.device}
                <br />
                <span class="at-muted">{row.os}</span>
              </td>
              <td>
                {names.get(row.browser) ?? row.browser}
                {row.version && <span class="at-muted"> {row.version}</span>}
              </td>
              <td>{row.case}</td>
              <td>{row.expected}</td>
              <td>
                <span
                  class:list={['at-tag', verdictTone[row.verdict] && 'at-tag-tone']}
                  style={verdictTone[row.verdict] ? `--at-tone: ${verdictTone[row.verdict]}` : undefined}
                >
                  {t(`research.verdict.${row.verdict}`)}
                </span>
                {row.observed && <p>{row.observed}</p>}
                {row.evidence && <p class="at-muted">{row.evidence}</p>}
              </td>
              <td>{row.date ?? '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
