---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/content.css';
import '../styles/hub.css';
import '../styles/pick-gallery.css';
import '../styles/tilt.css';
import Button from './shell/Button.astro';
import StatusPill from './shell/StatusPill.astro';
import Icon from './icons/Icon.astro';
import Brand from './icons/Brand.astro';
import { t } from '../i18n/load';
import { articleSchema, itemListSchema, type TSchemaNode } from '../lib/seo';
import { HUBS, type IHubItem } from '../lib/hubs';
import { brandsIn } from '../lib/brands';

interface Props {
  kind: 'vs' | 'guides';
}

const { kind } = Astro.props;
const hub = HUBS[kind];
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = `/og/${kind}-en.png`;
const canonical = `${site}/${kind}`;
const title = t(`page.hub.${kind}.title`);
const description = t(`page.hub.${kind}.description`);
const h1 = t(`page.hub.${kind}.h1`);

type TEntry = Awaited<ReturnType<typeof getCollection<'vs' | 'guides'>>>[number];
const entries = new Map<string, TEntry>();
for (const entry of await getCollection(kind)) {
  if (entry.data.locale === 'en') entries.set(entry.id.replace(/^en\//u, ''), entry);
}

// What kind of tool or fix a card is; a tag that names a browser or system shows that brand's logo instead.
const ICON_OF: Record<string, string> = {
  'nosleep-page': 'browser',
  'nosleep-js': 'code',
  amphetamine: 'laptop',
  caffeine: 'laptop',
  'caffeinate-command': 'terminal-window',
  'powertoys-awake': 'monitor',
  'mouse-jigglers': 'mouse',
  'iphone-auto-lock-never-greyed-out': 'device-mobile',
  'android-screen-timeout-one-app': 'device-mobile',
  'windows-11-screen-turns-off-after-1-minute': 'monitor',
  'lock-screen-vs-sleep': 'monitor',
  'mac-prevent-sleep-lid-closed': 'laptop',
  'chrome-energy-saver': 'browser',
  'second-monitor-turns-off': 'monitor',
};

interface ICard {
  href: string;
  name: string;
  title: string;
  icon: string;
  tags: readonly string[];
  fix: string;
  pick: string | undefined;
  instead: { who: string; when: string } | undefined;
  k: number;
}

let k = 0;
const toCard = (item: IHubItem): ICard | null => {
  const entry = entries.get(item.slug);
  if (!entry) return null;
  const d = entry.data;
  const us = d.compare?.cols.find((col) => col.us)?.name ?? 'AwakeTab';
  const pick = d.picks?.them?.[0]?.title;
  const insteadWhen = d.picks?.us?.[0]?.title;
  k += 1;
  return {
    href: `/${kind}/${item.slug}`,
    name: d.crumb ?? d.h1,
    title: d.h1,
    icon: ICON_OF[item.slug] ?? (kind === 'vs' ? 'browser' : 'monitor'),
    tags: (item.meta ?? []).filter(Boolean),
    fix: d.description,
    pick: pick ?? item.line,
    instead: insteadWhen ? { who: us, when: insteadWhen } : undefined,
    k: Math.min(k - 1, 7),
  };
};

const listed = new Set(hub.groups.flatMap((g) => g.items.map((i) => i.slug)));
const unlisted = [...entries.keys()].filter((slug) => !listed.has(slug)).sort();
const groups = hub.groups
  .map((group, gi) => {
    const items: IHubItem[] = [
      ...group.items,
      ...(gi === hub.groups.length - 1 ? unlisted.map((slug) => ({ slug })) : []),
    ];
    return { ...group, cards: items.map(toCard).filter((card): card is ICard => card !== null) };
  })
  .filter((group) => group.cards.length > 0);

const base = articleSchema({
  canonical,
  title: h1,
  description,
  locale: 'en',
  image: `${site}${ogImage}`,
  published: '2026-09-09',
  breadcrumbs: [
    { name: 'AwakeTab', url: site },
    { name: hub.crumb, url: canonical },
  ],
});
const schema = {
  ...base,
  '@graph': [
    ...(base['@graph'] as TSchemaNode[]),
    itemListSchema(
      h1,
      groups.flatMap((group) => group.cards.map((card) => ({ name: card.title, url: `${site}${card.href}` }))),
    ),
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema}>
  <main class="at-cp at-hub" data-gallery={kind}>
    <div class="at-hub-intro">
      <nav class="at-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">{t('app.name')}</a></li>
          <li aria-current="page">
            <span class="at-crumb-sep" data-slot="breadcrumb-separator" aria-hidden="true">
              <Icon name="caret-right" size={16} tone="ink" />
            </span>
            <span>{hub.crumb}</span>
          </li>
        </ol>
      </nav>
      <h1 class="at-h1-page">{h1}</h1>
      <div class="at-pick-intro">
        <p class="at-lead">{hub.lead}</p>
        {hub.note && <p class="at-hub-note">{hub.note}</p>}
        <slot />
      </div>

      <section class="at-try" aria-label="Try it now">
        <div class="at-try-top">
          <StatusPill as="span" state="idle" label={t('tool.pill.idle')} />
          <span class="at-try-digits" aria-hidden="true">00<span>:00</span></span>
        </div>
        <Button variant="primary" href="/?preset=pinf&autostart=1" class="at-try-cta" aria-label="Keep awake until I stop">
          Keep awake · ∞
        </Button>
        <p class="at-try-note">
          Opens the tool and keeps the screen awake until you stop. Keep that tab visible and watch its pill: a hidden tab
          releases the wake lock, and Safari needs a tap before it grants one.
        </p>
        <a class="at-try-link" href="/">Open the full tool <Icon name="arrow-right" size={16} /></a>
      </section>

      <nav class="at-jump" aria-label={hub.jumpAria} data-spy style={`--at-n: ${String(groups.length)}; --at-i: 0`}>
        <span class="at-jump-ind" aria-hidden="true"></span>
        {
          groups.map((group, i) => (
            <a href={`#${group.id}`} aria-current={i === 0 ? 'location' : undefined}>
              {group.short}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="at-hub-groups">
      {
        groups.map((group) => (
          <section id={group.id} class="at-hub-group" aria-labelledby={`${group.id}-h`}>
            <div class="at-hub-group-head">
              <div>
                <h2 id={`${group.id}-h`}>{group.title}</h2>
                <span class="at-hub-count">
                  {group.cards.length} {hub.unit[group.cards.length === 1 ? 0 : 1]}
                </span>
              </div>
              <p>{group.line}</p>
            </div>
            <ul class="at-pick" role="list">
              {group.cards.map((card) => (
                <li class="at-pick-card" style={`--at-k: ${String(card.k)}`} data-tilt>
                  <h3 class="at-pick-title">
                    {kind === 'vs' ? (
                      <a href={card.href} aria-label={card.title}>
                        {card.name}
                      </a>
                    ) : (
                      <a href={card.href}>{card.title}</a>
                    )}
                  </h3>
                  {card.tags.length > 0 && (
                    <ul class="at-pick-tags" role="list">
                      {card.tags.map((tag, i) => {
                        const logos = brandsIn(tag);
                        return (
                          <li class="at-tag">
                            {logos.length > 0
                              ? logos.map((logo) => <Brand logo={logo} />)
                              : i === 0 && <Icon name={card.icon} size={16} />}
                            {tag}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                  {kind === 'vs' ? (
                    <dl class="at-pick-picks">
                      {card.pick && (
                        <div>
                          <dt>{t('page.hub.vs.pick')}</dt>
                          <dd>{card.pick}</dd>
                        </div>
                      )}
                      {card.instead && (
                        <div class="at-pick-us">
                          <dt>{t('page.hub.vs.instead', { name: card.instead.who })}</dt>
                          <dd>{card.instead.when}</dd>
                        </div>
                      )}
                    </dl>
                  ) : (
                    <p class="at-pick-fix">{card.fix}</p>
                  )}
                  <span class="at-pick-more" aria-hidden="true">
                    {t(`page.hub.${kind}.more`)}
                    <Icon name="arrow-right" size={20} class="at-go" />
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
  <script>
    import { initContentNav } from '../lib/content-nav';
    import { initTilt } from '../lib/tilt';

    initContentNav();
    initTilt();
  </script>
</BaseLayout>
