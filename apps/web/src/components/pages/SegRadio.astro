---
interface IOption {
  value: string;
  label: string;
  aria?: string | undefined;
  count?: number | undefined;
}
interface Props {
  name: string;
  options: readonly IOption[];
  checked: string;
  label?: string | undefined;
  labelledby?: string | undefined;
  small?: boolean;
  compactPhone?: boolean;
  class?: string | undefined;
  hook?: string | undefined;
}
const { name, options, checked, label, labelledby, small = false, compactPhone = false, class: className, hook } = Astro.props;
---

<div
  class:list={['at-seg', 'at-pg-seg', small && 'at-pg-seg-sm', compactPhone && 'at-pg-seg-xs', className]}
  role="radiogroup"
  aria-label={labelledby ? undefined : label}
  aria-labelledby={labelledby}
  style={`--at-seg-n: ${String(options.length)}`}
  data-seg={hook}
>
  <span class="at-seg-ind" aria-hidden="true"></span>
  {
    options.map((o) => (
      <label class="at-seg-item">
        <input class="sr-only" type="radio" name={name} value={o.value} checked={o.value === checked} aria-label={o.aria} />
        <span class="at-pg-seg-label">{o.label}</span>
        {o.count !== undefined && (
          <span class="at-pg-seg-count" aria-hidden="true">
            {o.count}
          </span>
        )}
      </label>
    ))
  }
</div>
