---
interface Props {
  figures: Array<{
    frame: 'phone' | 'desktop';
    label: string;
    alt: string;
    caption: string;
    src?: string | undefined;
    width?: number | undefined;
    height?: number | undefined;
  }>;
  t?: (key: string, vars?: Record<string, string | number>) => string;
}
const { figures } = Astro.props;
// Only real screenshots render; a figure without an image is left out rather than shown as an empty frame.
const shown = figures.filter((fig) => fig.src);
---

{
  shown.length > 0 && (
    <div class="at-figs">
      {shown.map((fig) => (
        <figure>
          <img
            class={`at-fig at-fig-${fig.frame}`}
            src={fig.src}
            width={fig.width}
            height={fig.height}
            alt={fig.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{fig.caption}</figcaption>
        </figure>
      ))}
    </div>
  )
}
