---
import Brand from '../icons/Brand.astro';
import { inline } from '../../lib/article';
import { rowBrands } from '../../lib/brands';

interface Props {
  rows: Array<{
    title: string;
    text?: string | undefined;
    value?: string | undefined;
    link?: { label: string; href: string } | undefined;
  }>;
}
const { rows } = Astro.props;
---

<ul class="at-rl">
  {
    rows.map((row) =>
      row.value !== undefined ? (
        <li class="at-kv">
          <span set:html={inline(row.title)} />
          <span>{row.value}</span>
        </li>
      ) : (
        <li>
          <strong>
            {rowBrands(row.title).map((logo) => (
              <Brand logo={logo} class="at-logo-in" />
            ))}
            <Fragment set:html={inline(row.title)} />
          </strong>
          {row.text && <span set:html={inline(row.text)} />}
          {row.link && <a href={row.link.href}>{row.link.label}</a>}
        </li>
      ),
    )
  }
</ul>
