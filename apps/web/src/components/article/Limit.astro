---
interface Props {
  text: string;
  label: string;
  inline?: boolean;
}
const { text, label, inline = false } = Astro.props;
---

<aside
  id={inline ? undefined : 's-limit'}
  class="at-limit-note"
  aria-labelledby={inline ? 'h-limit-in' : 'h-limit'}
>
  <div role="note" class="at-note">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"
      ><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.01"
      ></path></svg
    >
    <div>
      <h2 id={inline ? 'h-limit-in' : 'h-limit'} class="at-kicker">{label}</h2>
      <p>{text}</p>
    </div>
  </div>
</aside>
