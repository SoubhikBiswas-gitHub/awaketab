---
import Icon from '../icons/Icon.astro';
import { inline } from '../../lib/article';

interface Props {
  kicker: string;
  text: string;
}
const { kicker, text } = Astro.props;
---

<div role="note" class="at-note at-note-tip">
  <Icon name="lightbulb" size={20} />
  <div>
    <span class="at-kicker">{kicker}</span>
    <p set:html={inline(text)} />
  </div>
</div>
