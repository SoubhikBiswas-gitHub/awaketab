---
import Icon from '../icons/Icon.astro';
import { inline } from '../../lib/article';

interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="at-check" data-check>
  {
    items.map((item) => (
      <li>
        <label>
          <input type="checkbox" />
          <span class="at-box" aria-hidden="true">
            <Icon name="check" size={16} tone="ink" />
          </span>
          <span set:html={inline(item)} />
        </label>
      </li>
    ))
  }
</ul>
