---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/content.css';
import '../styles/hub.css';
import Button from './shell/Button.astro';
import StatusPill from './shell/StatusPill.astro';
import DeviceGallery from './hub/DeviceGallery.astro';
import UseCaseGallery from './hub/UseCaseGallery.astro';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import { EXTRA, HUBS, MODE_LABEL, PRESET_LABEL, type IHubItem } from '../lib/hubs';
import { CONTENT_KINDS, type TContentKind } from '../lib/content-i18n';

interface Props {
  kind: TContentKind;
}

const { kind } = Astro.props;
const hub = HUBS[kind];
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = `/og/${kind}-en.png`;
const canonical = `${site}/${kind}`;
const title = t(`page.hub.${kind}.title`);
const description = t(`page.hub.${kind}.description`);
const h1 = t(`page.hub.${kind}.h1`);

type TEntry = Awaited<ReturnType<typeof getCollection<TContentKind>>>[number];
const all = new Map<string, TEntry>();
for (const k of CONTENT_KINDS) {
  for (const entry of await getCollection(k)) {
    if (entry.data.locale === 'en') all.set(`/${k}/${entry.id.replace(/^en\//u, '')}`, entry);
  }
}

interface IRow {
  slug: string;
  href: string;
  title: string;
  name: string;
  line: string;
  meta: readonly string[];
  preset: string;
  mode: string;
  browsers: readonly string[];
  os: readonly string[];
}
const toRow = (item: IHubItem): IRow | null => {
  const href = item.slug.startsWith('/') ? item.slug : `/${kind}/${item.slug}`;
  const entry = all.get(href);
  if (!entry) return null;
  const meta =
    item.meta ?? (kind === 'for' ? [PRESET_LABEL[entry.data.preset] ?? '', MODE_LABEL[entry.data.mode] ?? ''] : []);
  const { data } = entry;
  return {
    slug: href.slice(href.lastIndexOf('/') + 1),
    href,
    title: data.h1,
    name: data.crumb ?? data.h1,
    line: item.line ?? data.honestLimit,
    meta: meta.filter(Boolean),
    preset: data.preset,
    mode: data.mode,
    browsers: data.browsers,
    os: data.os,
  };
};
const listed = new Set(hub.groups.flatMap((g) => g.items.map((i) => (i.slug.startsWith('/') ? i.slug : `/${kind}/${i.slug}`))));
const unlisted = [...all.keys()].filter((href) => href.startsWith(`/${kind}/`) && !listed.has(href));
const groups = hub.groups
  .map((group, gi) => {
    const extra = unlisted.filter((href) => {
      const slug = href.slice(kind.length + 2);
      const home = EXTRA[kind]?.[slug];
      return home ? home === group.id : gi === hub.groups.length - 1;
    });
    const rows = [...group.items.map(toRow), ...extra.map((href) => toRow({ slug: href.slice(kind.length + 2) }))].filter(
      (row): row is IRow => row !== null,
    );
    return { ...group, rows };
  })
  .filter((group) => group.rows.length > 0);
const ICON_ARROW = 'M5 12h13M13 6l6 6-6 6';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={articleSchema({
    canonical,
    title: h1,
    description,
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: hub.crumb, url: canonical },
    ],
  })}
>
  <main class="at-cp at-hub">
    <div class="at-hub-intro">
      <nav class="at-crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">{t('app.name')}</a></li>
          <li aria-current="page">
            <span class="at-crumb-sep" data-slot="breadcrumb-separator" aria-hidden="true">
              <svg viewBox="0 0 16 16" focusable="false"><path d="M6.5 4.5L10 8l-3.5 3.5" /></svg>
            </span>
            <span>{hub.crumb}</span>
          </li>
        </ol>
      </nav>
      <h1 class="at-h1-page">{h1}</h1>
      <p class="at-lead">{hub.lead}</p>
      {hub.note && <p class="at-hub-note">{hub.note}</p>}

      <section class="at-try" aria-label="Try it now">
        <div class="at-try-top">
          <StatusPill as="span" state="idle" label={t('tool.pill.idle')} />
          <span class="at-try-digits" aria-hidden="true">00<span>:00</span></span>
        </div>
        <Button variant="primary" href="/?preset=pinf&autostart=1" class="at-try-cta" aria-label="Keep awake until I stop">
          Keep awake · ∞
        </Button>
        <p class="at-try-note">
          Opens the tool and keeps the screen awake until you stop. Keep that tab visible and watch its pill: a hidden tab
          releases the wake lock, and Safari needs a tap before it grants one.
        </p>
        <a class="at-try-link" href="/">Open the full tool <span aria-hidden="true">→</span></a>
      </section>

      <nav class="at-jump" aria-label={hub.jumpAria} data-spy style={`--at-n: ${String(groups.length)}; --at-i: 0`}>
        <span class="at-jump-ind" aria-hidden="true"></span>
        {
          groups.map((group, i) => (
            <a href={`#${group.id}`} aria-current={i === 0 ? 'location' : undefined}>
              {group.short}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="at-hub-groups">
      {
        groups.map((group) => (
          <section id={group.id} class="at-hub-group" aria-labelledby={`${group.id}-h`}>
            <div class="at-hub-group-head">
              <div>
                <h2 id={`${group.id}-h`}>{group.title}</h2>
                <span class="at-hub-count">
                  {group.rows.length} {hub.unit[group.rows.length === 1 ? 0 : 1]}
                </span>
              </div>
              <p>{group.line}</p>
            </div>
            {kind === 'for' ? (
              <UseCaseGallery cards={group.rows} />
            ) : kind === 'on' ? (
              <DeviceGallery cards={group.rows} />
            ) : (
              <ul class="at-hub-list">
                {group.rows.map((row) => (
                  <li>
                    <a href={row.href}>
                      <span class="at-hub-item">
                        <span class="at-hub-title">{row.title}</span>
                        <span class="at-hub-line">{row.line}</span>
                        {row.meta.length > 0 && (
                          <span class="at-hub-meta">
                            {row.meta.map((m, i) => (
                              <>
                                {i > 0 && <span aria-hidden="true">·</span>}
                                <span>{m}</span>
                              </>
                            ))}
                          </span>
                        )}
                      </span>
                      <svg class="at-go" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICON_ARROW} /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </main>
  <script>
    import { initContentNav } from '../lib/content-nav';

    initContentNav();
  </script>
</BaseLayout>
