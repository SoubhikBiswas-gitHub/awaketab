---
import { t } from '../../i18n/load';

/* The refund line (O-06, docs/09 §2.8) with its lamp icon: /pro plans, /pro/manage. `card` wraps it as a note card. */
interface Props {
  card?: boolean;
}
const { card = false } = Astro.props;
---

<p class:list={['at-pro-refund', card && 'at-card']} role={card ? 'note' : undefined}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"></path><path d="M4 4v4h4"></path></svg>
  <span><strong>{t('page.pro.refund.lead')}</strong> {t('page.pro.refund.rest')}</span>
</p>
