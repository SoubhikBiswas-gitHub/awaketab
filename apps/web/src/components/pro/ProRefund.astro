---
import { t } from '../../i18n/load';
import Icon from '../icons/Icon.astro';

interface Props {
  card?: boolean;
}
const { card = false } = Astro.props;
---

<p class:list={['at-pro-refund', card && 'at-card']} role={card ? 'note' : undefined}>
  <Icon name="arrow-counter-clockwise" size={20} />
  <span><strong>{t('page.pro.refund.lead')}</strong> {t('page.pro.refund.rest')}</span>
</p>
