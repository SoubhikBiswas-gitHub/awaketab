---
const C = 2 * Math.PI * 146;
const dash = `${(C * 0.72).toFixed(1)} ${C.toFixed(1)}`;
---

<div class="at-pro-ring">
  <div class="at-pro-ring-art" aria-hidden="true">
    <div class="at-pro-ring-ticks"></div>
    <div class="at-pro-ring-sweep"></div>
    <svg viewBox="0 0 320 320" width="320" height="320">
      <defs><filter id="pro-ring-glow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter></defs>
      <circle class="at-pro-ring-track" cx="160" cy="160" r="146"></circle>
      <g transform="rotate(-90 160 160)">
        <circle class="at-pro-ring-glow" cx="160" cy="160" r="146" stroke-dasharray={dash} filter="url(#pro-ring-glow)"></circle>
        <circle class="at-pro-ring-arc" cx="160" cy="160" r="146" stroke-dasharray={dash}></circle>
      </g>
      <g transform="rotate(259.2 160 160)">
        <circle class="at-pro-ring-halo" cx="160" cy="14" r="7"></circle>
        <circle class="at-pro-ring-bead" cx="160" cy="14" r="5.5"></circle>
      </g>
    </svg>
  </div>
  <div class="at-pro-ring-label"><slot /></div>
</div>
