---
import { buttonVariants } from '@/components/ui/button';
import { cn } from 'cn';
import { LOCALE_META, localePath, type TLocale } from '../i18n/locales';
import { createT } from '../i18n/load';

interface Props {
  locale: TLocale;
  /** The page's translations by locale; a locale without one links to its home (docs/07 §8). */
  links?: Partial<Record<TLocale, string>> | undefined;
}

const { locale, links = {} } = Astro.props;
const t = createT(locale);
// 44 px targets; the current locale is marked in bold and underlined, not by colour alone.
const link = cn(
  buttonVariants({ variant: 'ghost', size: 'sm' }),
  'min-h-11 aria-[current=page]:font-bold aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-4',
);
---

<nav class="flex flex-wrap gap-1" aria-label={t('settings.locale')}>
  {
    (Object.keys(LOCALE_META) as TLocale[]).map((code) => (
      <a
        class={link}
        href={links[code] ?? localePath(code, '/')}
        hreflang={LOCALE_META[code].hreflang}
        lang={LOCALE_META[code].htmlLang}
        aria-current={code === locale ? 'page' : undefined}
      >
        {LOCALE_META[code].label}
      </a>
    ))
  }
</nav>
