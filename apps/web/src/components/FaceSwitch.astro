---
import { createT } from '../i18n/load';
import type { TLocale } from '../i18n/locales';
import Icon from './icons/Icon.astro';

interface Props {
  locale: TLocale;
}

const t = createT(Astro.props.locale);
---

<div class="at-fc" role="group" aria-label={t('tool.face.label')}>
  <button class="at-fc-step" type="button" data-act="facePrev" aria-label={t('tool.face.prev')} aria-keyshortcuts="Shift+C" title={t('tool.face.prev')}>
    <Icon name="caret-circle-left" />
  </button>
  <button class="at-fc-open" type="button" data-act="customize" data-tab="face" aria-haspopup="dialog" title={t('tool.face.choose')}>
    <span class="sr-only">{t('tool.face.label')}</span>
    <span data-t="fn" aria-live="polite">{t('tool.face.ring')}</span>
  </button>
  <button class="at-fc-step" type="button" data-act="faceNext" aria-label={t('tool.face.next')} aria-keyshortcuts="C" title={t('tool.face.next')}>
    <Icon name="caret-circle-right" />
  </button>
</div>
<button class="at-fc-lamp" type="button" data-act="customize" data-tab="look" aria-haspopup="dialog" aria-label={t('tool.face.look')} title={t('tool.face.look')}>
  <span class="at-fc-dot" aria-hidden="true"></span>
</button>
