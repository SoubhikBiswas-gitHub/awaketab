---
// /embed (B6, canvas board EmbedShowcase): AwakeTab Embed landing and install page (docs/11 §10, docs/09 §7.3,
// E12-T02). No ads (docs/00 §8.3): BaseLayout, never ContentLayout. Zero hydration (docs/03 ADR-013). The widget on
// the placeholder recipe page is the real loader tag, exactly as a site pastes it; the snippet builder rewrites the
// tag and remounts it (lib/embed-page.ts). Embed licences are not on sale yet (decision O-29: "Licences open soon").
// `#allow` stays: the widget's "How to fix" link points at it (docs/11 §4).
import BaseLayout from '../layouts/BaseLayout.astro';
import SegRadio from '../components/pages/SegRadio.astro';
import '../styles/pages.css';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import { DEFAULT_SNIPPET, iframeSnippet, loaderSnippet } from '../tool/embed/snippet';
import { EMBED_LOCALES } from '../tool/embed/protocol';
import { snippetParts } from '../lib/embed-page';

const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = '/og/embed-en.png';
const canonical = `${site}/embed`;
const title = t('page.embed.title');
const description = t('page.embed.description');
const snippet = loaderSnippet(DEFAULT_SNIPPET);
const frame = iframeSnippet(DEFAULT_SNIPPET, t('embed.frame.title'));
const apiSample = `<button id="cook">Keep my screen on</button>
<script>
  document.getElementById('cook').addEventListener('click', () => {
    AwakeTabEmbed.start({ preset: 'p60' }); // from a click: the video fallback needs a gesture
  });
  AwakeTabEmbed.on('state', ({ lock, status }) => console.log(lock, status));
</script>`;
const langNames: Record<string, string> = {
  en: 'English',
  es: 'Español',
  'pt-br': 'Português (Brasil)',
  de: 'Deutsch',
  fr: 'Français',
  ja: '日本語',
  zh: '简体中文',
  hi: 'हिन्दी',
};
const presets = ['pinf', 'p15', 'p30', 'p45', 'p60', 'p120', 'p240'] as const;
const modes = [
  { value: 'cook', label: 'Cook' },
  { value: 'standard', label: 'Standard' },
  { value: 'clock', label: 'Clock' },
  { value: 'minimal', label: 'Minimal' },
];
const themes = [
  { value: 'auto', label: 'Auto' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'oled', label: 'OLED' },
];
const sizes = [
  { value: 'compact', label: 'Compact', aria: 'Compact, 320 by 104' },
  { value: 'full', label: 'Full width', aria: 'Full width, 240 pixels tall' },
];
const NOTES = {
  cook: 'Cook: a big elapsed timer readers can tap to pause. Full width adds up to three kitchen timers.',
  standard: 'Standard: Start, the honest status and the time kept awake.',
  clock: 'Clock: the current time, large, while the screen stays on.',
  minimal: 'Minimal: just the status and one button.',
} as const;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={articleSchema({
    canonical,
    title: t('page.embed.h1'),
    description,
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-26',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('page.embed.h1'), url: canonical },
    ],
  })}
>
  <main class="at-page at-embed" data-embed-root>
    <div class="at-pg-aura at-embed-aura" aria-hidden="true"></div>
    <div class="at-pg-intro at-embed-intro">
      <p class="at-embed-kicker">AwakeTab Embed</p>
      <h1 class="at-pg-h1">{t('page.embed.h1')}</h1>
      <p class="at-pg-lead">
        Recipe blogs, dashboards and documentation sites: give readers a button that keeps their screen from dimming while they
        follow along. One script tag, the same honest status as AwakeTab itself, in eight languages.
      </p>
    </div>

    <div class="at-embed-grid">
      <div class="at-embed-col">
        <figure class="at-host" aria-label="The widget on a placeholder recipe page" data-placeholder="host page">
          <div class="at-host-bar">
            <div class="at-host-url"><span>yourrecipesite.example/lemon-lentil-soup</span></div>
            <span class="at-host-tag">Placeholder site</span>
          </div>
          <div class="at-host-top">
            <span class="at-host-brand">[Your recipe site]</span>
            <span class="at-host-nav" aria-hidden="true"><span></span><span></span><span></span></span>
          </div>
          <div class="at-host-body">
            <div class="at-host-title">
              <span class="at-host-kicker">Soups</span>
              <h2>Lemon and red lentil soup</h2>
              <span class="at-host-meta">Serves 4 · 40 minutes · Sample recipe text</span>
            </div>
            <div class="at-host-photo" aria-hidden="true">Recipe photo</div>
            <div class="at-host-slot">
              <div class="at-host-label">
                <span>Pasted snippet renders here</span>
                <span aria-hidden="true"></span>
                <span class="at-pg-digits" data-embed-box>320 × 104</span>
              </div>
              <div class="at-host-widget" data-embed-demo data-size="compact">
                <script is:inline async src="/embed.js" data-mode="cook" data-theme="auto" data-size="compact" data-lang="en"></script>
              </div>
            </div>
            <div class="at-host-recipe">
              <div>
                <h3>Ingredients</h3>
                <ul>
                  <li>200 g red lentils</li>
                  <li>1 onion, diced</li>
                  <li>1 litre stock</li>
                  <li>1 lemon</li>
                </ul>
              </div>
              <div>
                <h3>Method</h3>
                <ol>
                  <li>Soften the onion in a little oil for 8 minutes.</li>
                  <li>Add the lentils and stock. Simmer for 25 minutes.</li>
                  <li>Blend, then finish with lemon juice and salt.</li>
                </ol>
              </div>
            </div>
          </div>
        </figure>

        <section class="at-pg-stack-12 at-embed-free" aria-labelledby="licence">
          <h2 id="licence" class="at-pg-h3">Free, or licensed for your brand</h2>
          <p class="at-pg-body at-pg-measure">
            The free widget is ready now and carries a small "Keep awake by AwakeTab" credit. An Embed licence ($29 / year per site)
            will remove the credit and apply your brand colour. The wake lock and every mode are identical either way.
          </p>
          <div class="at-embed-soon">
            <span class="at-tag at-tag-tone at-pg-tag">Licences open soon</span>
            <span class="at-pg-small">No payment is taken until a purchase can set up your domain.</span>
          </div>
        </section>
      </div>

      <div class="at-embed-col at-embed-col-r">
        <section class="at-pg-stack-16 at-embed-install" aria-labelledby="install">
          <h2 id="install" class="at-pg-h2">Install: one line</h2>
          <p class="at-pg-ui">Paste this where the button should appear, for example inside your recipe card, above the method or in a sidebar.</p>
          <div class="at-embed-snippet">
            <code tabindex="0" aria-label="Your snippet" data-snippet>{snippetParts(snippet).map((p) => (p.name ? <span class="at-snip-attr">{p.text}<span data-tok="k">{p.name}</span>=<span data-tok="s">{p.value}</span></span> : p.text))}</code>
            <div class="at-embed-snippet-foot">
              <span class="at-pg-caption">The loader adds the visible credit link below the widget.</span>
              <span class="sr-only" role="status" aria-live="polite" data-snippet-status data-copied={t('builder.copied')}></span>
              <button class="at-button at-button-sm at-pg-copy at-embed-copy" type="button" data-snippet-copy>
                <svg class="at-pg-copy-idle" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v11H9zM5 15V4h10"></path></svg>
                <svg class="at-pg-copy-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                <span class="at-pg-copy-idle">{t('tool.share.copy')}</span><span class="at-pg-copy-done">{t('builder.copied')}</span>
              </button>
            </div>
          </div>
          <p class="at-pg-small">
            The script replaces itself with a lazy-loaded iframe and reserves its box before it loads (no layout shift). It talks
            only to awaketab.com, and it sends anonymous start and end counts, including your site's domain. The credit sits in your
            page's own HTML as a plain nofollow link.
          </p>
        </section>

        <form class="at-card at-pg-stack-20 at-embed-builder" aria-labelledby="generator" data-snippet-form>
          <h2 id="generator" class="at-pg-h3">{t('builder.snippet')}</h2>
          <div class="at-pg-stack-8">
            <span id="g-mode" class="at-pg-label at-embed-glabel">{t('builder.mode')}</span>
            <SegRadio name="mode" labelledby="g-mode" options={modes} checked="cook" small />
          </div>
          <div class="at-pg-stack-8">
            <span id="g-theme" class="at-pg-label at-embed-glabel">Theme</span>
            <SegRadio name="theme" labelledby="g-theme" options={themes} checked="auto" small />
          </div>
          <div class="at-pg-stack-8">
            <span id="g-size" class="at-pg-label at-embed-glabel">{t('builder.size')}</span>
            <SegRadio name="size" labelledby="g-size" options={sizes} checked="compact" small />
          </div>
          <div class="at-embed-selects">
            <div class="at-pg-field">
              <label for="g-lang" class="at-pg-label at-embed-glabel">{t('builder.lang')}</label>
              <div class="at-pg-select">
                <select id="g-lang" class="at-input" name="lang">
                  <option value="" selected>{t('builder.lang.page')}</option>
                  {EMBED_LOCALES.map((l) => <option value={l}>{langNames[l]}</option>)}
                </select>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
              </div>
            </div>
            <div class="at-pg-field">
              <label for="g-preset" class="at-pg-label at-embed-glabel">Start length</label>
              <div class="at-pg-select">
                <select id="g-preset" class="at-input" name="preset">
                  {presets.map((p) => <option value={p} selected={p === DEFAULT_SNIPPET.preset}>{p === 'pinf' ? t('tool.preset.pinf.sr') : t(`tool.preset.${p}`)}</option>)}
                </select>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
              </div>
            </div>
          </div>
          <p class="at-pg-small">
            {Object.entries(NOTES).map(([mode, note]) => <span data-mode-note={mode} hidden={mode !== 'cook'}>{note}</span>)}
          </p>
        </form>
      </div>
    </div>

    <div class="at-embed-more">
      <section class="at-pg-stack-16" aria-labelledby="allow-heading" id="allow">
        <h2 id="allow-heading" class="at-pg-h3">Why the <code class="at-pg-code">allow</code> attribute matters</h2>
        <p class="at-pg-body at-pg-measure">
          Browsers only let an iframe from another site keep the screen awake when the page delegates the permission:
          <code class="at-pg-code">allow="screen-wake-lock"</code>. The loader always sets it. If your platform strips script tags and you
          paste the iframe yourself, keep that attribute: without it the widget cannot hold the screen on and shows "Ask the site
          owner" instead of pretending. The page also needs HTTPS, because a wake lock is only available in a secure context.
        </p>
        <pre class="at-embed-pre" tabindex="0"><code>{frame}</code></pre>
      </section>
      <section class="at-pg-stack-16" aria-labelledby="api">
        <h2 id="api" class="at-pg-h3">JavaScript API</h2>
        <p class="at-pg-body at-pg-measure">
          The loader exposes <code class="at-pg-code">window.AwakeTabEmbed</code>: <code class="at-pg-code">.start(opts)</code>,
          <code class="at-pg-code">.stop()</code>, <code class="at-pg-code">.setTheme(theme)</code> and <code class="at-pg-code">.on('state', callback)</code>.
          Messages are checked by origin in both directions: the widget only listens to the page that embeds it, and the page only
          to awaketab.com.
        </p>
        <pre class="at-embed-pre" tabindex="0"><code>{apiSample}</code></pre>
      </section>
      <nav class="at-pg-related" aria-label="Related">
        <a class="at-pg-chiplink" href="/">Open AwakeTab<svg class="at-pg-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        <a class="at-pg-chiplink" href="/kiosk">Kiosk licence<svg class="at-pg-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        <a class="at-pg-chiplink" href="/library">The wake lock library<svg class="at-pg-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        <a class="at-pg-chiplink" href="/terms">Licence terms<svg class="at-pg-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      </nav>
    </div>
  </main>
  <script>
    import { bindEmbedPage } from '../lib/embed-page';

    const root = document.querySelector<HTMLElement>('[data-embed-root]');
    if (root) bindEmbedPage(root);
  </script>
</BaseLayout>
