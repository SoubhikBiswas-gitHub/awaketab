---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import { CHECKOUT_LINKS } from '../lib/checkout';
import { PLAN_PRICES, lifetimePrice } from '../lib/license';
// shadcn/ui renders at build time only (docs/03-architecture.md ADR-013): no client:* directives here.
import { cn } from 'cn';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardAction, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';

const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const canonical = `${site}/pro`;
const title = t('page.pro.title');
const description = t('page.pro.description');
const life = lifetimePrice();
const yearlyPrice = t('pro.price.yearly', { price: `$${PLAN_PRICES.pro_yearly}` });
const lifetimePriceLabel = t('pro.price.lifetime', { price: `$${life.current}` });

// 44 px targets (docs/05 §7): shadcn's default h-9/h-10 is lifted with min-h-11 on real controls.
const ctaClass = cn(buttonVariants({ size: 'lg' }), 'min-h-11 w-full text-base');
const secondaryClass = cn(buttonVariants({ variant: 'outline' }), 'min-h-11');
const navClass = cn(buttonVariants({ variant: 'ghost' }), 'min-h-11');
const headingClass = 'text-3xl font-bold leading-tight tracking-tight text-balance';
const subheadingClass = 'mt-8 mb-3 text-xl font-semibold leading-tight';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/og/pro-en.png"
  schema={articleSchema({
    canonical,
    title: t('page.pro.h1'),
    description,
    locale: 'en',
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('page.pro.h1'), url: canonical },
    ],
  })}
>
  <header class="at-page-header"><a class="at-wordmark" href="/">AwakeTab</a></header>
  <main class="mx-auto mt-8 max-w-[45rem] leading-normal">
    <h1 class={headingClass}>{t('page.pro.h1')}</h1>
    <p class="mt-3 text-lg">{t('page.pro.lead')}</p>
    <p class="mt-2 text-sm text-muted-foreground">{t('page.pro.tax')}</p>

    <section aria-labelledby="pro-plans">
      <h2 id="pro-plans" class={subheadingClass}>{t('pro.title')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <Card>
          <CardHeader>
            <CardTitle id="plan-yearly" className="text-2xl">{yearlyPrice}</CardTitle>
            <CardAction>
              <Badge variant="secondary">{t('page.pro.devices')}</Badge>
            </CardAction>
          </CardHeader>
          <CardFooter>
            <a class={ctaClass} href={CHECKOUT_LINKS.pro_yearly} rel="noopener" data-plan="pro_yearly" aria-describedby="plan-yearly">
              {t('pro.cta')}
            </a>
          </CardFooter>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle id="plan-lifetime" className="text-2xl">
              {lifetimePriceLabel}
              {life.strike ? <s class="ms-2 text-base font-normal text-muted-foreground">${life.strike}</s> : null}
            </CardTitle>
            <CardAction>
              <Badge variant="secondary">{t('page.pro.devices')}</Badge>
            </CardAction>
          </CardHeader>
          <CardFooter>
            <a class={ctaClass} href={CHECKOUT_LINKS.pro_lifetime} rel="noopener" data-plan="pro_lifetime" aria-describedby="plan-lifetime">
              {t('pro.cta')}
            </a>
          </CardFooter>
        </Card>
      </div>
      <p class="mt-6"><a class={secondaryClass} href="/pro/activate">{t('pro.activate')}</a></p>
    </section>

    <Alert role="note" className="mt-8">
      <AlertDescription>{t('page.pro.refund')}</AlertDescription>
    </Alert>

    <nav aria-label="Related" class="mt-6 flex flex-wrap gap-2">
      <a class={navClass} href="/">Open AwakeTab</a>
      <a class={navClass} href="/about">{t('page.about.h1')}</a>
    </nav>
  </main>
  <script>
    import { track } from '../lib/analytics';
    track('pro_view', {}, { telemetry: true, source: 'web', locale: 'en', path: '/pro' });
    document.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach((link) => {
      link.addEventListener('click', () => {
        track('pro_checkout_click', { plan: link.dataset.plan ?? '' }, { telemetry: true, source: 'web', locale: 'en', path: '/pro' });
      });
    });
  </script>
</BaseLayout>
