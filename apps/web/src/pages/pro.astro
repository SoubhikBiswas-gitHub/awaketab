---
// Zero hydration: CSS reads the lamp radios; lib/pro-page.ts runs the launch-price switch and analytics.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/shell/Button.astro';
import ProRefund from '../components/pro/ProRefund.astro';
import ProLampRing from '../components/pro/ProLampRing.astro';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import { CHECKOUT_LINKS } from '../lib/checkout';
import { PLAN_PRICES, PRO_LAUNCH_END } from '../lib/license';
import { LAMPS, usd } from '../lib/pro-common';
import '../styles/pro.css';

const p = (key: string, vars?: Record<string, string | number>) => t(`page.pro.${key}`, vars);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = '/og/pro-en.png';
const canonical = `${site}/pro`;
const title = t('page.pro.title');
const description = t('page.pro.description');

// The launch price is a runtime switch, never a strike-through: pro-page.ts flips `data-launch` after the end.
const launch = Date.now() < PRO_LAUNCH_END;
const yearly = usd(PLAN_PRICES.pro_yearly);
const lifeLaunch = usd(PLAN_PRICES.pro_lifetime_launch);
const lifeFull = usd(PLAN_PRICES.pro_lifetime);
// PRO_LAUNCH_END is midnight UTC, so the last launch-price day is the one before it.
const lastDay = new Date(PRO_LAUNCH_END - 1);
const launchDate = `${lastDay.toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' })}, ${lastDay.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}`;

type TCell = boolean | string;
type TRow = { label: string; free: TCell; pro: TCell };
const groups: Array<{ id: string; title: string; rows: TRow[] }> = [
  {
    id: 'web',
    title: p('cmp.g.web'),
    rows: [
      { label: p('cmp.r.awake'), free: true, pro: true },
      { label: p('cmp.r.lengths'), free: true, pro: true },
      { label: p('cmp.r.faces'), free: true, pro: true },
      { label: p('cmp.r.offline'), free: true, pro: true },
      { label: p('cmp.r.lamps'), free: p('cmp.v.lamps.free'), pro: p('cmp.v.lamps.pro') },
      { label: p('cmp.r.msg'), free: p('cmp.v.msg.free'), pro: true },
      { label: p('cmp.r.stats'), free: p('cmp.v.stats.free'), pro: p('cmp.v.stats.pro') },
      { label: p('cmp.r.pip'), free: true, pro: p('cmp.v.pip.pro') },
    ],
  },
  {
    id: 'ext',
    title: p('cmp.g.ext'),
    rows: [
      { label: p('cmp.r.ext'), free: true, pro: true },
      { label: p('cmp.r.sched'), free: false, pro: true },
      { label: p('cmp.r.auto'), free: false, pro: true },
    ],
  },
  {
    id: 'ads',
    title: p('cmp.g.ads'),
    rows: [
      { label: p('cmp.r.adsawake'), free: p('cmp.v.never'), pro: p('cmp.v.never') },
      { label: p('cmp.r.adsguides'), free: p('cmp.v.ads.free'), pro: p('cmp.v.ads.pro') },
    ],
  },
];

const gets = [
  { id: 'lamps', d: 'M12 3.5c3.3 3.7 5.5 6.6 5.5 9.5a5.5 5.5 0 0 1-11 0c0-2.9 2.2-5.8 5.5-9.5z' },
  { id: 'msg', d: 'M4 5h16v11h-9l-4.5 3.5V16H4zM8 9h8M8 12h5' },
  { id: 'stats', d: 'M4 20h16M6.5 16.5V12M11 16.5V7M15.5 16.5V10M20 16.5V5' },
  { id: 'pip', d: 'M3.5 5h17v14h-17zM12.5 11.5h5.5v5h-5.5z' },
  { id: 'sched', d: 'M4 6h16v14H4zM4 10.5h16M8.5 3.5v4M15.5 3.5v4M8.5 15l2 2 4-4' },
  { id: 'ads', d: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zM6 6l12 12' },
].map((g) => ({ ...g, h: p(`get.${g.id}.h`), text: p(`get.${g.id}.p`) }));

const steps = [1, 2, 3, 4].map((n) => ({ n, h: p(`how.s${n}.h`), text: p(`how.s${n}.p`) }));

const trust = [
  { id: 'polar', d: 'M3.5 6h17v12h-17zM3.5 10h17M7 14.5h4' },
  { id: 'cancel', d: 'M4 6h16v14H4zM4 10.5h16M8.5 3.5v4M15.5 3.5v4M10 13.5l4 4M14 13.5l-4 4' },
  { id: 'privacy', d: 'M12 3.5l7 3v5c0 4.3-3 7.8-7 9-4-1.2-7-4.7-7-9v-5zM9 12l2 2 4-4' },
].map((x) => ({ ...x, h: p(`trust.${x.id}.h`), text: p(`trust.${x.id}.p`) }));

const faq = [1, 5, 2, 3, 6, 7].map((n, i) => ({ i, q: p(`faq.q${n}`), a: p(`faq.a${n}`, { yearly }) }));

const CHECK = 'M5 12.5l4.5 4.5L19 7.5';
const DASH = 'M7 12h10';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={articleSchema({
    canonical,
    title: t('page.pro.h1'),
    description,
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('page.pro.h1'), url: canonical },
    ],
  })}
>
  <div class="at-pro at-pro-page" data-pro-root data-launch={launch ? 'on' : 'off'} data-launch-end={String(PRO_LAUNCH_END)}>
    <div class="at-pro-aura" aria-hidden="true"></div>
    <main id="top" class="at-pro-main">
      <section class="at-pro-hero" aria-labelledby="pro-h1">
        <div class="at-pro-hero-text">
          <p class="at-pro-kicker">{p('kicker')}</p>
          <h1 id="pro-h1" class="at-pro-h1">{p('hero.title')}</h1>
          <p class="at-pro-lead at-pro-hero-lead">{p('hero.value')}</p>
          <p class="at-pro-hero-price at-pro-num">
            <span data-launch-only>{p('hero.price.launch', { yearly, once: lifeLaunch })}</span>
            <span data-after-only>{p('hero.price', { yearly, once: lifeFull })}</span>
          </p>
          <div class="at-pro-hero-actions">
            <Button variant="primary" href="#plans">{t('pro.cta')}</Button>
            <a class="at-pro-link" href="#compare">{p('hero.compare')}</a>
          </div>
          <ul class="at-pro-glance" aria-label={p('hero.glance')}>
            <li>{p('hero.devices')}</li>
            <li>{p('hero.account')}</li>
            <li>{p('hero.refund')}</li>
          </ul>
        </div>

        <figure class="at-pro-lamp" aria-labelledby="lamp-cap">
          <ProLampRing>
            <p class="at-pro-kicker">{p('lamp.kicker')}</p>
            <p class="at-pro-lamp-name">
              {LAMPS.map((l) => <span data-for-lamp={l.id}>{p(`lamp.${l.id}`)}</span>)}
            </p>
            <span class="at-tag at-pro-tag-lamp" data-for-lamp="pro">{p('lamp.pro')}</span>
            <span class="at-tag at-pro-tag-plain" data-for-lamp="free">{p('lamp.free')}</span>
          </ProLampRing>
          <div class="at-pro-swatches" role="radiogroup" aria-label={p('lamp.group')}>
            {
              LAMPS.map((l) => (
                <label class="at-pro-swatch" data-lamp-id={l.id}>
                  <input
                    class="sr-only"
                    type="radio"
                    name="pro-lamp"
                    id={`pro-lamp-${l.id}`}
                    value={l.id}
                    checked={l.id === 'mint'}
                    aria-label={p(l.pro ? 'lamp.aria.pro' : 'lamp.aria.free', { name: p(`lamp.${l.id}`) })}
                  />
                  <span class="at-pro-swatch-dot" aria-hidden="true" />
                  <span aria-hidden="true">{p(`lamp.${l.id}`)}</span>
                </label>
              ))
            }
          </div>
          <figcaption id="lamp-cap" class="at-pro-lamp-cap">{p('lamp.caption')}</figcaption>
        </figure>
      </section>

      <section id="compare" class="at-pro-cmp" aria-labelledby="cmp-h">
        <div class="at-pro-head at-pro-head-narrow">
          <h2 id="cmp-h" class="at-pro-h2">{p('cmp.h2')}</h2>
          <p class="at-pro-body">{p('cmp.lead')}</p>
        </div>
        <div class="at-pro-cmp-wrap" role="region" aria-label={p('cmp.caption')} tabindex="0">
          <div class="at-pro-cmp-cols" aria-hidden="true">
            <span></span>
            <span>
              <span class="at-pro-cmp-plan">{p('cmp.col.free')}</span>
              <span class="at-pro-cmp-sub">{p('cmp.col.free.sub')}</span>
            </span>
            <span class="at-pro-cmp-pro">
              <span class="at-pro-cmp-plan">{p('cmp.col.pro')}</span>
              <span class="at-pro-cmp-sub at-pro-num">{p('cmp.col.pro.sub', { price: yearly })}</span>
            </span>
          </div>
          {
            groups.map((g) => (
              <table class="at-pro-cmp-table">
                <caption>{g.title}</caption>
                <colgroup>
                  <col class="at-pro-cmp-col-feature" />
                  <col />
                  <col />
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col">
                      <span class="sr-only">{p('cmp.col.feature')}</span>
                    </th>
                    <th scope="col">
                      <span class="sr-only">{p('cmp.col.free')}</span>
                    </th>
                    <th scope="col" class="at-pro-cmp-pro">
                      <span class="sr-only">{p('cmp.col.pro')}</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {g.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      {[r.free, r.pro].map((v, i) => (
                        <td class:list={[i === 1 && 'at-pro-cmp-pro', v === false && 'at-pro-cmp-no', v === true && 'at-pro-cmp-yes']}>
                          {typeof v === 'string' ? (
                            v
                          ) : (
                            <>
                              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                                <path d={v ? CHECK : DASH} />
                              </svg>
                              <span class="sr-only">{p(v ? 'cmp.yes' : 'cmp.no')}</span>
                            </>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            ))
          }
        </div>
      </section>

      <section class="at-pro-get" aria-labelledby="get-h">
        <div class="at-pro-head at-pro-head-narrow">
          <h2 id="get-h" class="at-pro-h2">{p('get.h2')}</h2>
          <p class="at-pro-body">{p('get.lead')}</p>
        </div>
        <ul class="at-pro-get-grid">
          {
            gets.map((g) => (
              <li class="at-pro-get-item">
                <span class="at-pro-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d={g.d} />
                  </svg>
                </span>
                <h3 class="at-pro-h3">{g.h}</h3>
                <p class="at-pro-small at-pro-ink2">{g.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="plans" class="at-pro-plans" aria-labelledby="plans-h">
        <div class="at-pro-head at-pro-head-narrow">
          <h2 id="plans-h" class="at-pro-h2">{p('plans.h2')}</h2>
          <p class="at-pro-body">{p('plans.lead.all')}</p>
        </div>
        <div class="at-pro-plan-grid">
          <article class="at-card at-pro-plan" aria-labelledby="plan-yearly">
            <div class="at-pro-plan-top">
              <p class="at-pro-kicker">{p('plans.yearly')}</p>
              <span class="at-tag">{t('page.pro.devices')}</span>
            </div>
            <h3 id="plan-yearly" class="at-pro-price at-pro-num">
              <span>{yearly}</span><span class="at-pro-per">{p('plans.per.year')}</span>
            </h3>
            <ul class="at-pro-plan-list at-pro-grow">
              <li>{p('plans.all')}</li>
              <li>{p('plans.renew')}</li>
              <li>{p('plans.cancel')}</li>
            </ul>
            <Button variant="secondary" href={CHECKOUT_LINKS.pro_yearly} data-plan="pro_yearly" aria-describedby="plan-yearly" class="at-pro-wide">
              {p('plans.cta.yearly')}
            </Button>
          </article>
          <article class="at-card at-pro-plan at-pro-plan-lamp" aria-labelledby="plan-lifetime">
            <div class="at-pro-plan-top">
              <span class="at-pro-plan-name">
                <span class="at-pro-kicker">{p('plans.lifetime')}</span>
                <span class="at-tag at-pro-tag-lamp">{p('plans.once')}</span>
              </span>
              <span class="at-tag">{t('page.pro.devices')}</span>
            </div>
            <h3 id="plan-lifetime" class="at-pro-price at-pro-num">
              <span data-launch-only>{lifeLaunch}</span><span data-after-only>{lifeFull}</span><span class="at-pro-per">{p('plans.per.once')}</span>
            </h3>
            <ul class="at-pro-plan-list at-pro-grow">
              <li>{p('plans.all')}</li>
              <li>{p('plans.norenewal')}</li>
              <li data-launch-only>{p('plans.launch.date', { date: launchDate, price: lifeFull })}</li>
              <li data-launch-only>{p('plans.launch.value')}</li>
              <li data-after-only>{p('plans.after.value')}</li>
            </ul>
            <Button variant="primary" href={CHECKOUT_LINKS.pro_lifetime} data-plan="pro_lifetime" aria-describedby="plan-lifetime" class="at-pro-wide">
              {p('plans.cta.lifetime')}
            </Button>
          </article>
        </div>
        <div class="at-pro-plan-notes">
          <p class="at-pro-caption">{p('plans.tax')}</p>
          <p class="at-pro-caption">{p('plans.shutdown')}</p>
        </div>
      </section>

      <section class="at-pro-how" aria-labelledby="how-h">
        <div class="at-pro-head at-pro-head-narrow">
          <h2 id="how-h" class="at-pro-h2">{p('how.h2')}</h2>
          <p class="at-pro-body">{p('how.lead')}</p>
        </div>
        <ol class="at-pro-steps">
          {
            steps.map((s) => (
              <li class="at-pro-step">
                <span class="at-pro-step-n at-pro-num" aria-hidden="true">
                  {s.n}
                </span>
                <h3 class="at-pro-h3">{s.h}</h3>
                <p class="at-pro-small at-pro-ink2">{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="at-pro-how-links">
          <a class="at-pro-link" href="/pro/activate">{t('pro.activate')}</a>
          <a class="at-pro-link" href="/pro/manage">{t('page.pro.activate.manage')}</a>
        </div>
      </section>

      <section class="at-pro-trust" aria-labelledby="trust-h">
        <h2 id="trust-h" class="at-pro-h2">{p('trust.h2')}</h2>
        <ul class="at-pro-trust-list">
          <li class="at-pro-trust-item">
            <ProRefund />
          </li>
          {
            trust.map((x) => (
              <li class="at-pro-trust-item">
                <p class="at-pro-refund">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d={x.d} />
                  </svg>
                  <span>
                    <strong>{x.h}</strong> {x.text}
                  </span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="at-pro-faq" aria-labelledby="faq-h">
        <h2 id="faq-h" class="at-pro-h2">{p('faq.h2')}</h2>
        <div class="at-pro-faq-list">
          {
            faq.map((q) => (
              <details name="pro-faq" open={q.i === 0}>
                <summary>
                  <h3>{q.q}</h3>
                  <span class="at-pro-faq-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                </summary>
                <p>{q.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="at-pro-biz" aria-labelledby="biz-h">
        <h2 id="biz-h" class="at-pro-kicker">{p('biz.h2')}</h2>
        <div class="at-pro-biz-grid">
          <a href="/embed">
            <span class="at-pro-biz-top"><span>{p('biz.embed')}</span><span class="at-pro-num">{p('biz.embed.price', { price: usd(PLAN_PRICES.biz_embed_site_yearly) })}</span></span>
            <span>{p('biz.embed.text')}</span>
          </a>
          <a href="/kiosk">
            <span class="at-pro-biz-top"><span>{p('biz.kiosk')}</span><span class="at-pro-num">{p('biz.kiosk.price', { one: usd(PLAN_PRICES.biz_kiosk_site), five: usd(PLAN_PRICES.biz_kiosk_5) })}</span></span>
            <span>{p('biz.kiosk.text')}</span>
          </a>
        </div>
      </section>

      <section class="at-card at-pro-end" aria-labelledby="end-h">
        <div class="at-pro-head">
          <h2 id="end-h" class="at-pro-h2">{p('end.h2')}</h2>
          <p class="at-pro-body">
            <span data-launch-only>{p('end.lead', { yearly, once: lifeLaunch })}</span>
            <span data-after-only>{p('end.lead', { yearly, once: lifeFull })}</span>
          </p>
        </div>
        <div class="at-pro-end-actions">
          <Button variant="primary" href={CHECKOUT_LINKS.pro_lifetime} data-plan="pro_lifetime">{p('plans.cta.lifetime')}</Button>
          <Button variant="secondary" href={CHECKOUT_LINKS.pro_yearly} data-plan="pro_yearly">{p('plans.cta.yearly')}</Button>
        </div>
        <p class="at-pro-caption">{p('end.note')} <a class="at-pro-inline-link" href="/pro/activate">{t('pro.activate')}</a></p>
      </section>
    </main>
  </div>
  <script>
    import { bootProPage } from '../lib/pro-page';
    const root = document.querySelector<HTMLElement>('[data-pro-root]');
    if (root) bootProPage(root);
  </script>
</BaseLayout>
