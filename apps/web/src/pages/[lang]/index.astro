---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIsland from '../../components/ToolIsland.astro';
import '../../styles/tool-full.css';
import { createT } from '../../i18n/load';
import { LOCALE_META, isLocale, type TLocale } from '../../i18n/locales';
import { homeSchema } from '../../lib/seo';
import ratings from '../../../../../data/ratings.json';
import type { ILocaleHomeCopy } from '../../content/locale-home/types';
import { es } from '../../content/locale-home/es';
import { ptBr } from '../../content/locale-home/pt-br';
import { de } from '../../content/locale-home/de';
import { fr } from '../../content/locale-home/fr';
import { ja } from '../../content/locale-home/ja';
import { zh } from '../../content/locale-home/zh';
import { hi } from '../../content/locale-home/hi';

export function getStaticPaths() {
  return ['es', 'pt-br', 'de', 'fr', 'ja', 'zh', 'hi'].map((lang) => ({ params: { lang } }));
}

const rawLocale = Astro.params.lang ?? '';
if (!isLocale(rawLocale) || rawLocale === 'en') {
  throw new Error(`Unsupported locale route: ${rawLocale}`);
}
const locale: TLocale = rawLocale;
const t = createT(locale);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
// `/es/`, with its slash: the build writes es/index.html, which Cloudflare Pages serves only at /es/ (docs/14 §2.1).
const canonical = `${site}/${locale}/`;
const meta = LOCALE_META[locale];

// Draft, unreviewed machine-assisted translations (docs/BUILD-STATE.md "Known gaps" E6-T04).
// meta.reviewed stays false until a native speaker signs off, so `noindex` below is unaffected
// by how much prose exists on the page.
const COPY: Record<Exclude<TLocale, 'en'>, ILocaleHomeCopy> = {
  es,
  'pt-br': ptBr,
  de,
  fr,
  ja,
  zh,
  hi,
};
const copy = COPY[locale];

const pillKeys = [
  'tool.pill.idle',
  'tool.pill.requesting',
  'tool.pill.held',
  'tool.pill.lost',
  'tool.pill.denied',
  'tool.pill.unsupported',
  'tool.pill.fallback',
] as const;

const card = 'rounded-xl border bg-card text-card-foreground shadow-sm';
---

<BaseLayout
  title={t('page.home.title')}
  description={t('page.home.description')}
  canonical={canonical}
  locale={locale}
  noindex={!meta.reviewed}
  ogImage={`/og/home-${locale}.png`}
  schema={homeSchema(locale, ratings)}
  header={false}
>
  <ToolIsland heading={t('page.home.h1')} locale={locale}>
    <div class="at-prose">
      <section class="at-section" aria-labelledby="answer-title">
        <h2 id="answer-title">{t('page.home.what.title')}</h2>
        <p>{copy.whatItDoes[0]}</p>
        <p>{copy.whatItDoes[1]}</p>
      </section>

      <section class="at-section" aria-labelledby="how-title">
        <h2 id="how-title">{t('page.home.how.title')}</h2>
        <ol>
          {copy.howItWorks.map((step) => <li>{step}</li>)}
        </ol>
        <ul class:list={['m-0 grid list-none gap-2 p-0 sm:grid-cols-2', 'mt-4']}>
          {
            pillKeys.map((key) => (
              <li class:list={['px-3 py-2 text-sm font-medium', card]}>{t(key)}</li>
            ))
          }
        </ul>
      </section>

      <section class="at-section" aria-labelledby="limits-title">
        <h2 id="limits-title">{t('page.home.limits.title')}</h2>
        <aside class="at-limit">
          <ul>
            {copy.honestLimits.map((point) => <li>{point}</li>)}
          </ul>
        </aside>
      </section>
    </div>
  </ToolIsland>
</BaseLayout>
