---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIsland from '../../components/ToolIsland.astro';
import { createT } from '../../i18n/load';
import { LOCALE_META, isLocale, type TLocale } from '../../i18n/locales';
import { homeSchema } from '../../lib/seo';
import ratings from '../../../../../data/ratings.json';

export function getStaticPaths() {
  return ['es', 'pt-br', 'de', 'fr', 'ja', 'zh', 'hi'].map((lang) => ({ params: { lang } }));
}

const rawLocale = Astro.params.lang ?? '';
if (!isLocale(rawLocale) || rawLocale === 'en') {
  throw new Error(`Unsupported locale route: ${rawLocale}`);
}
const locale: TLocale = rawLocale;
const t = createT(locale);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const canonical = `${site}/${locale}`;
const meta = LOCALE_META[locale];
---

<BaseLayout
  title={t('page.home.title')}
  description={t('page.home.description')}
  canonical={canonical}
  locale={locale}
  noindex={!meta.reviewed}
  ogImage={`/og/home-${locale}.png`}
  schema={homeSchema(locale, ratings)}
  footer={{
    privacy: t('footer.privacy'),
    terms: t('footer.terms'),
    changelog: t('footer.changelog'),
    donate: t('footer.donate'),
  }}
>
  <ToolIsland heading={t('page.home.h1')} locale={locale}>
    <section class="at-prose">
      <p>{t('page.home.intro')}</p>
      <aside class="at-limit">{t('tool.advice.hidden_document')}</aside>
    </section>
  </ToolIsland>
</BaseLayout>
