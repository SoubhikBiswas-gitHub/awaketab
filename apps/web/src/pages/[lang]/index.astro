---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIsland from '../../components/ToolIsland.astro';
import HomeBelow from '../../components/HomeBelow.astro';
import '../../styles/tool-full.css';
import { createT } from '../../i18n/load';
import { LOCALE_META, isLocale, type TLocale } from '../../i18n/locales';
import { homeSchema } from '../../lib/seo';
import ratings from '../../../../../data/ratings.json';

export function getStaticPaths() {
  return ['es', 'pt-br', 'de', 'fr', 'ja', 'zh', 'hi'].map((lang) => ({ params: { lang } }));
}

const rawLocale = Astro.params.lang ?? '';
if (!isLocale(rawLocale) || rawLocale === 'en') {
  throw new Error(`Unsupported locale route: ${rawLocale}`);
}
const locale: TLocale = rawLocale;
const t = createT(locale);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
// `/es/`, with its slash: the build writes es/index.html, which Cloudflare Pages serves only at /es/ (docs/14 §2.1).
const canonical = `${site}/${locale}/`;
const meta = LOCALE_META[locale];

const ICON_TRANSLATE = 'M4 5h8M8 3v2M5.5 5c.8 3 3 5.5 6 7M10.5 5c-.6 3.4-2.8 6.2-6.5 8M12.5 20l4-9 4 9M13.8 17h5.4';
---

<BaseLayout
  title={t('page.home.title')}
  description={t('page.home.description')}
  canonical={canonical}
  locale={locale}
  noindex={!meta.reviewed}
  ogImage={`/og/home-${locale}.png`}
  schema={homeSchema(locale, ratings)}
  header={false}
>
  <ToolIsland heading={t('page.home.h1')} locale={locale}>
    {
      !meta.reviewed && (
        <p class="at-hb-note" role="note" data-translation-pending slot="top">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICON_TRANSLATE} /></svg>
          <span>
            {t('content.translation.pending')} <a href="/" hreflang="en">{t('content.translation.original')}</a>
          </span>
        </p>
      )
    }
    <HomeBelow locale={locale} />
  </ToolIsland>
</BaseLayout>

<style>
  .at-hb-note {
    display: flex;
    align-items: flex-start;
    gap: var(--at-s-2);
    margin: 0;
    padding-block: var(--at-s-2);
    padding-inline: var(--at-s-3);
    border: var(--at-border) solid var(--at-line-strong);
    border-radius: var(--at-r-lg);
    color: var(--at-ink-2);
    font: var(--at-type-small);
  }

  .at-hb-note svg {
    flex-shrink: 0;
    inline-size: var(--at-icon-sm);
    block-size: var(--at-icon-sm);
    margin-block-start: calc(var(--at-s-1) / 2);
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .at-hb-note a {
    padding-block: var(--at-s-3);
    color: var(--at-accent-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
