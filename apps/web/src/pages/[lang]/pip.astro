---
import PipPage from '../../components/PipPage.astro';
import { isLocale, type TLocale } from '../../i18n/locales';

// /{lang}/pip: the popup fallback in the opener's language (docs/05 §9). noindex, no ads, not in the sitemap.
export function getStaticPaths() {
  return ['es', 'pt-br', 'de', 'fr', 'ja', 'zh', 'hi'].map((lang) => ({ params: { lang } }));
}

const rawLocale = Astro.params.lang ?? '';
if (!isLocale(rawLocale) || rawLocale === 'en') {
  throw new Error(`Unsupported locale route: ${rawLocale}`);
}
const locale: TLocale = rawLocale;
---

<PipPage locale={locale} />
