---
// /library — @awaketab/wake landing and live demo (docs/12 §6, E12-T04). The demo runs the package's built IIFE
// (dist/awaketab-wake.iife.js, the file npm publishes and CDNs serve), copied to /library/ by
// scripts/library.mjs — not the app's bundled copy. No ads (docs/00 §8.3); zero hydration (docs/03 ADR-013).
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import wakePkg from '../../../../packages/wake/package.json';
import { cn } from 'cn';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { buttonVariants } from '@/components/ui/button';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';

const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const canonical = `${site}/library`;
const title = t('page.library.title');
const description = t('page.library.description');
const version = wakePkg.version;
const major = version.split('.')[0] ?? '1';
const STATES = ['idle', 'requesting', 'held', 'lost', 'denied', 'unsupported', 'fallback'] as const;

const esm = `import { createWakeLock } from '@awaketab/wake';

const lock = createWakeLock();
lock.on('change', ({ from, to, reason, advice }) => {
  pill.textContent = to;            // idle · requesting · held · lost · denied · unsupported · fallback
  hint.textContent = advice ?? '';  // e.g. 'battery_saver', 'iframe_no_allow'
});
start.addEventListener('click', () => lock.request()); // a gesture keeps the video fallback available
stop.addEventListener('click', () => lock.release());`;
const cdn = `<script src="https://cdn.jsdelivr.net/npm/@awaketab/wake@${major}/dist/awaketab-wake.iife.js"></script>
<script>
  const lock = AwakeTabWake.createWakeLock();
  document.querySelector('#start').addEventListener('click', () => lock.request());
</script>`;
const react = `import { useWakeLock } from '@awaketab/wake/react';

export function KeepAwake() {
  const { state, request, release } = useWakeLock();
  return state === 'held' || state === 'fallback'
    ? <button onClick={release}>Screen awake — stop</button>
    : <button onClick={request}>Keep screen on</button>;
}`;

const btn = cn(buttonVariants(), 'min-h-11 cursor-pointer');
const outline = cn(buttonVariants({ variant: 'outline' }), 'min-h-11 cursor-pointer');
const navClass = cn(buttonVariants({ variant: 'ghost' }), 'min-h-11');
const h2 = 'mt-10 mb-3 text-xl font-semibold leading-tight';
const code = 'block overflow-x-auto rounded-lg border bg-card p-4 text-sm leading-relaxed whitespace-pre';
const control =
  'min-h-11 rounded-md border border-input bg-background px-3 text-base text-foreground focus-visible:outline-2 focus-visible:outline-ring';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="/og/library-en.png"
  schema={articleSchema({
    canonical,
    title: t('page.library.h1'),
    description,
    locale: 'en',
    published: '2026-09-26',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('page.library.h1'), url: canonical },
    ],
  })}
>
  <main class="mx-auto mt-8 max-w-[45rem] leading-normal">
    <h1 class="text-3xl font-bold leading-tight tracking-tight text-balance">{t('page.library.h1')}</h1>
    <p class="mt-3 text-lg">
      <code>@awaketab/wake</code> keeps a web page's screen from dimming and tells you the truth about it: seven
      states, a reason and an advice code on every change, and <code>held</code> only while the browser really holds
      the lock. Zero dependencies, ≤ 3.4 KB gzipped with the fallback videos inlined, MIT. The maintained replacement
      for NoSleep.js.
    </p>
    <pre class="mt-4"><code tabindex="0" class={code}>npm install @awaketab/wake</code></pre>

    <section aria-labelledby="demo" class="mt-10 rounded-lg border p-4" data-wake-demo>
      <h2 id="demo" class="text-xl font-semibold leading-tight">{t('library.demo.title')}</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Running <code>awaketab-wake.iife.js</code> v{version} — the exact file on npm.
        <span data-demo-loading>…</span>
      </p>
      <label class="mt-4 grid max-w-sm gap-1 text-sm font-medium">
        {t('library.demo.scenario')}
        <select class={control} data-demo-scenario>
          <option value="real" selected>{t('library.demo.scenario.real')}</option>
          <option value="simulated">{t('library.demo.hide')} / {t('library.demo.show')}</option>
          <option value="denied">{t('library.demo.scenario.denied')}</option>
          <option value="unsupported">{t('library.demo.scenario.unsupported')}</option>
        </select>
      </label>
      <ol class="mt-4 grid gap-2 sm:grid-cols-2" data-demo-states>
        {
          STATES.map((s) => (
            <li class="at-demo-state flex min-h-11 items-center justify-between gap-2 rounded-md border px-3" data-state={s}>
              <code>{s}</code>
              <span class="text-sm text-muted-foreground">{t(`tool.pill.${s}`)}</span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm">
        <output class="font-semibold" aria-live="polite" data-demo-current>idle</output>
        <span class="ms-2 text-muted-foreground" data-demo-advice data-label={t('library.demo.advice', { code: '{code}' })}></span>
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button class={btn} type="button" data-demo-request disabled>{t('library.demo.request')}</button>
        <button class={outline} type="button" data-demo-release disabled>{t('library.demo.release')}</button>
        <button class={outline} type="button" data-demo-hide disabled>{t('library.demo.hide')}</button>
        <button class={outline} type="button" data-demo-show disabled>{t('library.demo.show')}</button>
      </div>
      <h3 class="mt-6 text-sm font-semibold">{t('library.demo.log')}</h3>
      <ol class="mt-2 grid gap-1 font-mono text-xs" data-demo-log></ol>
    </section>

    <section aria-labelledby="usage">
      <h2 id="usage" class={h2}>Use it</h2>
      <h3 class="mb-2 font-semibold">ESM (bundlers)</h3>
      <pre><code tabindex="0" class={code}>{esm}</code></pre>
      <h3 class="mt-6 mb-2 font-semibold">CDN (no build step)</h3>
      <pre><code tabindex="0" class={code}>{cdn}</code></pre>
      <h3 class="mt-6 mb-2 font-semibold">React, Preact and Vue</h3>
      <pre><code tabindex="0" class={code}>{react}</code></pre>
    </section>

    <section aria-labelledby="compare">
      <h2 id="compare" class={h2}>Compared with NoSleep.js</h2>
      <div class="overflow-x-auto">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead><span class="sr-only">Feature</span></TableHead>
              <TableHead><code>@awaketab/wake</code></TableHead>
              <TableHead>NoSleep.js 0.12.0</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            <TableRow><TableCell>Last release</TableCell><TableCell>maintained; semver</TableCell><TableCell>16 Dec 2020</TableCell></TableRow>
            <TableRow><TableCell>Native Wake Lock</TableCell><TableCell>yes, first</TableCell><TableCell>yes (when present)</TableCell></TableRow>
            <TableRow><TableCell>Honest state</TableCell><TableCell>seven states + change events with reason and advice</TableCell><TableCell><code>isEnabled</code> boolean</TableCell></TableRow>
            <TableRow><TableCell>Denial diagnosis</TableCell><TableCell><code>classifyDenial()</code> advice codes</TableCell><TableCell>none</TableCell></TableRow>
            <TableRow><TableCell>Fallback</TableCell><TableCell>inlined 1-frame video, gesture-aware, pauses when hidden</TableCell><TableCell>looping video, always on</TableCell></TableRow>
            <TableRow><TableCell>Size (gzip)</TableCell><TableCell>≤ 3.4 KB, fallback included</TableCell><TableCell>≈ 3.2 KB</TableCell></TableRow>
            <TableRow><TableCell>TypeScript · SSR</TableCell><TableCell>native · inert on the server</TableCell><TableCell>community typings · no</TableCell></TableRow>
            <TableRow><TableCell>Adapters</TableCell><TableCell>React, Preact, Vue (&lt; 400 B each)</TableCell><TableCell>no</TableCell></TableRow>
          </TableBody>
        </Table>
      </div>
    </section>

    <Alert role="note" className="mt-8 border-s-4 border-s-warning">
      <AlertDescription>
        A wake lock keeps the display on while the page is visible — nothing more. It does not keep a hidden tab
        awake, does not stop a laptop sleeping when the lid closes, and does not keep Teams or Slack "Available"
        (presence follows input, and this library never fakes input).
      </AlertDescription>
    </Alert>

    <nav aria-label="Related" class="mt-8 flex flex-wrap gap-2">
      <a class={navClass} href="https://www.npmjs.com/package/@awaketab/wake" rel="noopener">npm</a>
      <a class={navClass} href="https://github.com/awaketab/awaketab/tree/main/packages/wake" rel="noopener">GitHub</a>
      <a class={navClass} href="/learn/how-we-tested">How we tested</a>
      <a class={navClass} href="/learn/screen-wake-lock-api-guide">Screen Wake Lock API guide</a>
      <a class={navClass} href="/vs/nosleep-js">NoSleep.js vs Wake Lock</a>
    </nav>
  </main>
  <script is:inline defer src="/library/awaketab-wake.iife.js" data-wake-iife></script>
  <script>
    import { bindDemo } from '../lib/library-demo';

    const root = document.querySelector<HTMLElement>('[data-wake-demo]');
    if (root) bindDemo(root, window);
  </script>
</BaseLayout>
