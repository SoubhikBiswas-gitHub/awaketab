---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { Card, CardContent, CardDescription, CardHeader } from '@/components/ui/card';
import { t } from '../i18n/load';
import { changelogDate, sortChangelog } from '../lib/changelog';
import { articleSchema } from '../lib/seo';

// Fragments are the `changelog` content collection (repo-root `changelog/*.md`), rendered at build time by
// Astro's Markdown pipeline like the content pages: no client JS (F-07, docs/14 §7).
const entries = await Promise.all(
  sortChangelog(await getCollection('changelog')).map(async (entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: changelogDate(entry.data.date),
    Content: (await render(entry)).Content,
  })),
);
const latest = entries[0]?.date;
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const canonical = `${site}/changelog`;
const crumbLink = 'inline-flex min-h-11 items-center';
// The rendered Markdown carries no classes. `.at-article` (tool.css, already in the stylesheet every page inlines)
// styles its paragraphs, lists, links and inline code, so no page-specific utilities are added to the CSS the tool
// pages carry. `mt-0` cancels its top margin inside the card.
const body = 'at-article mt-0 px-5 break-words';
---

<BaseLayout
  title={t('page.changelog.title')}
  description={t('page.changelog.description')}
  canonical={canonical}
  ogImage="/og/changelog-en.png"
  schema={articleSchema({
    canonical,
    title: t('page.changelog.h1'),
    description: t('page.changelog.description'),
    locale: 'en',
    published: '2026-09-09',
    ...(latest ? { updated: latest } : {}),
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('page.changelog.h1'), url: canonical },
    ],
  })}
>
  <header class="at-page-header"><a class="at-wordmark" href="/">AwakeTab</a></header>
  <main class="mx-auto mt-6 w-full max-w-[45rem] leading-relaxed">
    <Breadcrumb aria-label="Breadcrumb">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink className={crumbLink} href="/">{t('app.name')}</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{t('page.changelog.h1')}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>
    <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight">{t('page.changelog.h1')}</h1>
    <ol class="mt-8 grid list-none gap-4 p-0">
      {
        entries.map((entry) => (
          <li data-changelog-entry={entry.id}>
            <Card className="gap-4 py-5">
              <CardHeader className="px-5">
                <h2 class="text-lg leading-snug font-semibold">{entry.title}</h2>
                <CardDescription>
                  <time datetime={entry.date}>{entry.date}</time>
                </CardDescription>
              </CardHeader>
              <CardContent className={body}>
                <entry.Content />
              </CardContent>
            </Card>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
