---
import '../styles/tool-page.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIsland from '../components/ToolIsland.astro';
import '../styles/tool-full.css';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';

export function getStaticPaths() {
  return ['15m', '30m', '45m', '1h', '2h', '4h', '8h'].map((preset) => ({ params: { preset } }));
}

// The PresetPage board (design/canvas/project/PresetPage.dc.html): the tool fills the first viewport set to this
// length, then "About this page", the honest limit, the other lengths and the guides for a job of this length.
const routes = {
  '15m': {
    label: t('tool.preset.p15'),
    cta: '15 min',
    words: '15 minutes',
    job: '15-minute',
    preset: 'p15',
  },
  '30m': {
    label: t('tool.preset.p30'),
    cta: '30 min',
    words: '30 minutes',
    job: '30-minute',
    preset: 'p30',
  },
  '45m': {
    label: t('tool.preset.p45'),
    cta: '45 min',
    words: '45 minutes',
    job: '45-minute',
    preset: 'p45',
  },
  '1h': {
    label: t('tool.preset.p60'),
    cta: '1 hour',
    words: '1 hour',
    job: 'one-hour',
    preset: 'p60',
  },
  '2h': {
    label: t('tool.preset.p120'),
    cta: '2 hours',
    words: '2 hours',
    job: 'two-hour',
    preset: 'p120',
  },
  '4h': {
    label: t('tool.preset.p240'),
    cta: '4 hours',
    words: '4 hours',
    job: 'four-hour',
    preset: 'p240',
  },
  '8h': {
    label: t('tool.preset.eightHour'),
    cta: '8 hours',
    words: '8 hours',
    job: 'eight-hour',
    preset: 'custom',
  },
} as const;
const LENGTHS = [
  ['15m', '15 min'],
  ['30m', '30 min'],
  ['45m', '45 min'],
  ['1h', '1 h'],
  ['2h', '2 h'],
  ['4h', '4 h'],
  ['8h', '8 h'],
] as const;
// Minutes per route, for the in-place switch below the tool (tool/extras.ts reads data-len).
const MINUTES = { '15m': 15, '30m': 30, '45m': 45, '1h': 60, '2h': 120, '4h': 240, '8h': 480 } as const;
const GUIDES = [
  ['Keep the screen on during a video call', '/for/video-calls'],
  ['Keep the screen on while downloading', '/for/downloads'],
  ['Keep a work laptop display on', '/for/work-laptop'],
  ['Keep the screen on while you present', '/for/presentations'],
] as const;

const slug = Astro.params.preset as keyof typeof routes;
const route = routes[slug];
const label = route.label;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://awaketab.com';
const ogImage = `/og/${slug}-en.png`;
const title = t('page.preset.title', { label });
const description = t('page.preset.description', { label });
const canonical = `${site}/${slug}`;
const h1 = `Keep your screen awake for ${route.words}`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={articleSchema({
    canonical,
    title: title.replace(' — AwakeTab', ''),
    description,
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: label, url: canonical },
    ],
  })}
  header={false}
>
  <ToolIsland heading={h1} kicker="About this page" preset={route.preset}>
    <section class="at-page-copy" aria-label="About this page">
      <p class="at-lead">
        This page keeps the screen on for {route.words} from the moment it
        opens, as long as this tab stays visible. If your browser wants a tap
        first, tap “Keep awake · {route.cta}” above. The tool shows the time it
        will stop, so you know when the screen may dim again.
      </p>
      <p>
        When {
          route.words === '1 hour' ? 'the hour is' : `the ${route.words} are`
        } up, AwakeTab asks “Time's up. Keep going?” with +15 min, +30 min, +1 h and
        Stop. If you do nothing, it stops on its own and your usual screen timeout
        takes over. To change the length, pick another preset in the tool or one of
        the lengths below; a change during a session applies straight away.
      </p>
      <p>
        Trust the pill, not the button. It reads “{t('tool.pill.held')}” only
        after the browser confirms the wake lock, and it changes to “{
          t('tool.pill.lost')
        }” the moment you switch away.
      </p>
      <div class="at-honest" role="note">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.01"
          ></path></svg
        >
        <div>
          <span class="at-kicker">Honest limit</span>
          <p>
            Keep this tab visible and the device open. A hidden tab, a closed
            laptop lid or a work sign-in policy can still let the display sleep
            or lock. AwakeTab never simulates input, so it will not keep Teams
            or Slack showing you as active.
          </p>
        </div>
      </div>
      <nav class="at-lengths" aria-labelledby="h-lengths">
        <h2 class="at-kicker" id="h-lengths">Other lengths</h2>
        <ul>
          {
            LENGTHS.map(([s, l]) => (
              <li>
                {s === slug ? (
                  <span class="at-chip at-length-here" aria-current="page"><span class="at-dot" aria-hidden="true" /><span>{l}<span class="sr-only">, this page</span></span></span>
                ) : (
                  <a
                    class="at-chip"
                    href={`/${s}`}
                    aria-label={`Keep awake for ${l}`}
                    data-len={`${routes[s].preset}:${String(MINUTES[s])}`}
                  >
                    {l}
                  </a>
                )}
              </li>
            ))
          }
          <li>
            <a
              class="at-chip at-chip-choose"
              href="/"
              data-len="until"
              aria-label="Pick an end time in the tool">Until a time…</a>
          </li>
        </ul>
      </nav>
    </section>
    <nav class="at-guides" aria-labelledby="h-guides">
      <h2 id="h-guides">Guides for a {route.job} job</h2>
      <ul>
        {
          GUIDES.map(([l, href]) => (
            <li>
              <a class="at-guide-row" href={href}>
                <span>
                  <span class="at-guide-title">{l}</span>
                  <span class="at-guide-path">{href}</span>
                </span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h13M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </ToolIsland>
</BaseLayout>
