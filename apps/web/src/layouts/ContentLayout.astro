---
import BaseLayout from './BaseLayout.astro';
// After BaseLayout on purpose: tokens.css (Tailwind + layer order), tool.css and shell.css must precede this sheet.
import '../styles/content.css';
import AdSlot from '../components/AdSlot.astro';
import type { TLocale } from '../i18n/locales';
import type { TSchemaNode } from '../lib/seo';
import { shouldRenderAdSlots } from '../lib/ads';
import { minifyCss } from '../lib/article-css';
import adSheet from '../styles/article/ads.css?raw';

interface Props {
  title: string;
  description: string;
  canonical: string;
  locale?: TLocale;
  noindex?: boolean;
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  schema: TSchemaNode;
  alternates?: Array<{ locale: TLocale; href: string }> | undefined;
  localeLinks?: Partial<Record<TLocale, string>> | undefined;
  family: string;
  toolFirst?: boolean;
}

const {
  title,
  description,
  canonical,
  locale = 'en',
  noindex = false,
  ogImage,
  ogImageAlt,
  schema,
  alternates,
  localeLinks,
  family,
  toolFirst = false,
} = Astro.props;
// Ads render only here, gated by PUBLIC_ADS_ENABLED (docs/00 §8.3, docs/09 §3.1).
const showAds = shouldRenderAdSlots();
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  noindex={noindex}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  schema={schema}
  alternates={alternates}
  localeLinks={localeLinks}
  contentPage
>
  <slot name="styles" slot="head" />
  {showAds && <style is:inline slot="head" set:html={minifyCss(adSheet)} />}
  <main class="at-cp">
    <article class="at-art" data-family={family} data-tool={toolFirst ? 'first' : 'after'}>
      <div class="at-head"><slot name="head" /></div>
      <slot name="toc" />
      {toolFirst && <slot name="tool" />}
      <slot name="contents" />
      <div class="at-body">
        <div class="at-prose">
          <slot name="intro" />
          {showAds && <AdSlot kind="inline" />}
          <slot />
        </div>
        <slot name="after" />
        <div class="at-prose"><slot name="limit" /></div>
      </div>
      {!toolFirst && <slot name="tool" />}
      <div class="at-prose at-tail"><slot name="tail" /></div>
      {showAds && <AdSlot kind="rail" />}
    </article>
  </main>
  <script>
    import { initContentNav } from '../lib/content-nav';
    import { bootAds } from '../lib/ads';

    initContentNav();
    void bootAds({
      onSlot: (page) => {
        void import('../lib/analytics.js').then((mod) => {
          mod.track('ad_slot_loaded', { page }, { telemetry: true, source: 'web', locale: document.documentElement.lang || 'en' });
        });
      },
    });
  </script>
</BaseLayout>
