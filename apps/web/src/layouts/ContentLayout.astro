---
import BaseLayout from './BaseLayout.astro';
// After BaseLayout on purpose: tokens.css (Tailwind + layer order), tool.css and shell.css must precede this sheet.
import '../styles/content.css';
import AdSlot from '../components/AdSlot.astro';
import type { TLocale } from '../i18n/locales';
import type { TSchemaNode } from '../lib/seo';
import { shouldRenderAdSlots } from '../lib/ads';

interface Props {
  title: string;
  description: string;
  canonical: string;
  locale?: TLocale;
  noindex?: boolean;
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  schema: TSchemaNode;
  alternates?: Array<{ locale: TLocale; href: string }> | undefined;
  localeLinks?: Partial<Record<TLocale, string>> | undefined;
  toolAt?: 'top' | 'after';
  variant?: 'article' | 'guide';
}

const {
  title,
  description,
  canonical,
  locale = 'en',
  noindex = false,
  ogImage,
  ogImageAlt,
  schema,
  alternates,
  localeLinks,
  toolAt = 'top',
  variant = 'article',
} = Astro.props;
// Ads render only here, gated by PUBLIC_ADS_ENABLED (docs/00 §8.3, docs/09 §3.1).
const showAds = shouldRenderAdSlots();
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  noindex={noindex}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  schema={schema}
  alternates={alternates}
  localeLinks={localeLinks}
  contentPage
>
  <main class="at-cp">
    <article class="at-art" data-tool-at={toolAt} data-variant={variant}>
      <slot name="toc" />
      <div class="at-head"><slot name="head" /></div>
      {toolAt === 'top' && <slot name="tool" />}
      <div class="at-body">
        <div class="at-prose">
          <div class="at-md"><slot /></div>
          {showAds && <AdSlot kind="inline" />}
          <slot name="notes" />
          {toolAt === 'top' && <slot name="tail" />}
        </div>
        <slot name="after" />
      </div>
      {toolAt === 'after' && <slot name="tool" />}
      {toolAt === 'after' && <div class="at-tail"><slot name="tail" /></div>}
      {showAds && <AdSlot kind="rail" />}
    </article>
  </main>
  <script>
    import { initContentNav } from '../lib/content-nav';
    import { bootAds } from '../lib/ads';

    initContentNav();
    void bootAds({
      onSlot: (page) => {
        void import('../lib/analytics.js').then((mod) => {
          mod.track('ad_slot_loaded', { page }, { telemetry: true, source: 'web', locale: document.documentElement.lang || 'en' });
        });
      },
    });
  </script>
</BaseLayout>
