---
import '../styles/tokens.css';
import '../styles/tool.css';
import '../styles/shell.css';
import bootJs from '../boot/boot.js?raw';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import { createT } from '../i18n/load';
import { localeFromPath, localePath, LOCALE_META, textDirection, type TLocale } from '../i18n/locales';
import type { TSchemaNode } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  contentPage?: boolean;
  locale?: TLocale;
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  schema?: TSchemaNode | undefined;
  alternates?: Array<{ locale: TLocale; href: string }> | undefined;
  localeLinks?: Partial<Record<TLocale, string>> | undefined;
  header?: boolean;
  bare?: boolean;
}

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://awaketab.com';
const {
  title,
  description,
  canonical = `${site}${Astro.url.pathname === '/' ? '' : Astro.url.pathname.replace(/\/$/u, '')}`,
  noindex = false,
  contentPage = false,
  locale = localeFromPath(Astro.url.pathname),
  ogImage,
  ogImageAlt,
  schema,
  alternates,
  localeLinks,
  header = true,
  bare = false,
} = Astro.props;
const localeMeta = LOCALE_META[locale];
const t = createT(locale);
---

<!doctype html>
<html lang={localeMeta.htmlLang} dir={textDirection(localeMeta.htmlLang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F2F6FA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0E16" />
    <meta name="theme-color" content="#F2F6FA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href={localePath(locale, '/manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-title" content="AwakeTab" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      contentPage={contentPage}
      locale={locale}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      schema={schema}
      alternates={alternates}
    />
    <script is:inline set:html={bootJs} />
    <slot name="head" />
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          {header && <a class="at-skip" href="#content">{t('tool.skip')}</a>}
          {header && <SiteHeader locale={locale} />}
          {
            header ? (
              <div class="at-shell" id="content" tabindex="-1">
                <slot />
              </div>
            ) : (
              <slot />
            )
          }
          <SiteFooter locale={locale} links={localeLinks} />
        </>
      )
    }
  </body>
</html>
