{
  "name": "@awaketab/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "devDependencies": {
    "tsup": "latest",
    "typescript": "^5.9"
  },
  "size-limit": [
    {
      "name": "@awaketab/core",
      "path": "dist/index.js",
      "limit": "7 KB"
    }
  ]
}
