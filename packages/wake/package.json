{
  "name": "@awaketab/wake",
  "version": "1.0.0",
  "description": "Screen Wake Lock with an honest state machine and a tiny video fallback. Maintained replacement for NoSleep.js.",
  "license": "MIT",
  "author": "Soubhik Biswas (https://awaketab.com/about)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/awaketab-wake.iife.js",
  "jsdelivr": "./dist/awaketab-wake.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/adapters/react.d.ts",
        "default": "./dist/adapters/react.js"
      },
      "require": {
        "types": "./dist/adapters/react.d.cts",
        "default": "./dist/adapters/react.cjs"
      }
    },
    "./preact": {
      "import": {
        "types": "./dist/adapters/preact.d.ts",
        "default": "./dist/adapters/preact.js"
      },
      "require": {
        "types": "./dist/adapters/preact.d.cts",
        "default": "./dist/adapters/preact.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/adapters/vue.d.ts",
        "default": "./dist/adapters/vue.js"
      },
      "require": {
        "types": "./dist/adapters/vue.d.cts",
        "default": "./dist/adapters/vue.cjs"
      }
    },
    "./iife": "./dist/awaketab-wake.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "wake lock",
    "screen wake lock",
    "nosleep",
    "keep awake",
    "prevent sleep",
    "wakelock"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SoubhikBiswas-gitHub/awaketab",
    "directory": "packages/wake"
  },
  "homepage": "https://awaketab.com/library",
  "bugs": {
    "url": "https://github.com/SoubhikBiswas-gitHub/awaketab/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/awaketab"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "preact": ">=10",
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "pack:check": "npm pack --dry-run --json",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "devDependencies": {
    "react": "19.2.8",
    "preact": "10.29.8",
    "vue": "3.5.42",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "size-limit": [
    {
      "name": "@awaketab/wake core",
      "path": "dist/index.js",
      "limit": "3.4 kB",
      "gzip": true
    },
    {
      "name": "@awaketab/wake IIFE (CDN)",
      "path": "dist/awaketab-wake.iife.js",
      "limit": "3.6 kB",
      "gzip": true
    },
    {
      "name": "@awaketab/wake/react",
      "path": "dist/adapters/react.js",
      "limit": "400 B",
      "gzip": true
    },
    {
      "name": "@awaketab/wake/preact",
      "path": "dist/adapters/preact.js",
      "limit": "400 B",
      "gzip": true
    },
    {
      "name": "@awaketab/wake/vue",
      "path": "dist/adapters/vue.js",
      "limit": "400 B",
      "gzip": true
    }
  ]
}
