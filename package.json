{
  "name": "awaketab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm test:unit && pnpm test:functions",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:functions": "vitest run --config vitest.functions.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ext": "playwright test -c apps/extension/playwright.config.ts",
    "test:seo": "vitest run --config vitest.seo.config.ts",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.css\"",
    "typecheck": "pnpm -r typecheck",
    "size": "pnpm -r --if-present size",
    "keys:dev": "node apps/web/scripts/keys-dev.mjs",
    "keys:prod": "tsx apps/web/scripts/keys-prod.mts",
    "keys:check": "tsx apps/web/scripts/check-keys.mts",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "astro-eslint-parser": "3.1.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "size-limit": "13.0.3",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-use-logical-spec": "5.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
